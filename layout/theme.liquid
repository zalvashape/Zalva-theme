<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% comment %}
      Font preloading:
      1. Preconnect to font CDN for faster connection
      2. Preload only the critical font variant (base weight)
      3. Additional variants load on-demand via @font-face
    {% endcomment %}
    {% unless settings.type_primary_font.system? %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>

      {% comment %} Preload the base font variant for initial page render {% endcomment %}
      {{ settings.type_primary_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}

    {% comment %} Zalva Shape brand fonts (Cormorant Garamond + Jost) {% endcomment %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,200;0,300;1,300&family=Jost:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    >

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}

  </head>

  <body class="template-{{ request.page_type }}{% if template.suffix != blank %} template-{{ request.page_type }}-{{ template.suffix }}{% endif %}{% if request.page_type == 'index' %} zalva-home{% endif %}">
    {% comment %} Premium header: announcement bar + main bar + side panel live in sections/header.liquid (header-group). {% endcomment %}
    {% sections 'header-group' %}

    {% section 'cart-drawer' %}

    {{ content_for_layout }}

    {% section 'footer' %}

    {% render 'zs-email-copy-toast' %}

    {% if request.page_type contains 'customers' %}
      {{ 'zs-account.css' | asset_url | stylesheet_tag }}
      <script src="{{ 'zs-account.js' | asset_url }}" defer></script>
    {% endif %}

    {{ 'zs-email-copy.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'zs-email-copy.js' | asset_url }}" defer></script>
    <script src="{{ 'zs-cart-drawer.js' | asset_url }}" defer></script>
    <script src="{{ 'zs-search-clear.js' | asset_url }}" defer></script>

    <script>
      (() => {
        const headerRoot = document.querySelector('[data-zs-header]');
        if (!headerRoot) return;

        const bar = headerRoot.querySelector('[data-zs-header-bar]');
        const announce = headerRoot.querySelector('.zs-header__announce');
        if (!bar || !announce) return;

        headerRoot.classList.remove('header-theme-light', 'header-theme-dark');

        const isHome = headerRoot.dataset.isHome === 'true';
        const DEFAULT_BAR_BG = '#F0E8DF';
        const DEFAULT_BAR_TEXT = '#1A1A1A';
        const HERO_FALLBACK_BAR_BG = '#F0E8DF';
        const HERO_FALLBACK_BAR_TEXT = '#1A1A1A';
        const ANNOUNCE_ON_LIGHT_BG = '#1A1A1A';
        const ANNOUNCE_ON_LIGHT_TEXT = '#C8A96E';
        const ANNOUNCE_ON_DARK_BG = '#FAF8F5';
        const ANNOUNCE_ON_DARK_TEXT = '#1A1A1A';

        let sectionColorCache = new WeakMap();
        let bgSections = [];
        let rafId = 0;
        let observer = null;
        let lastStyleKey = '';
        let headerIoUpdatesEnabled = false;

        const normalizeHex = (value) => (value || '').trim().toLowerCase();

        const shouldInverseAnnounce = (barText) => normalizeHex(barText) === '#faf8f5';

        const getCachedSectionColors = (el) => {
          let cached = sectionColorCache.get(el);
          if (!cached) {
            cached = {
              bg: el.getAttribute('data-header-bg') || DEFAULT_BAR_BG,
              text: el.getAttribute('data-header-text') || DEFAULT_BAR_TEXT,
            };
            sectionColorCache.set(el, cached);
          }
          return cached;
        };

        const getHeaderStackHeight = () => {
          const ann = headerRoot.querySelector('.zs-header__announce');
          const b = headerRoot.querySelector('[data-zs-header-bar]');
          return (ann?.offsetHeight ?? 0) + (b?.offsetHeight ?? 0);
        };

        const getProbeY = () => {
          const h = getHeaderStackHeight();
          return Math.max(0, Math.min(h * 0.5, window.innerHeight - 1));
        };

        const findSectionBehindHeader = () => {
          const probeY = getProbeY();
          for (let i = 0; i < bgSections.length; i++) {
            const el = bgSections[i];
            const r = el.getBoundingClientRect();
            if (r.top <= probeY && r.bottom > probeY) return el;
          }
          return null;
        };

        const resolveBarColors = () => {
          if (isHome && window.scrollY < 0.5) {
            const heroEl = document.querySelector('[data-main-hero-section]');
            if (heroEl) {
              const { bg, text } = getCachedSectionColors(heroEl);
              return { barBg: bg, barText: text };
            }
            return { barBg: HERO_FALLBACK_BAR_BG, barText: HERO_FALLBACK_BAR_TEXT };
          }
          const el = findSectionBehindHeader();
          if (!el) {
            return { barBg: DEFAULT_BAR_BG, barText: DEFAULT_BAR_TEXT };
          }
          const { bg, text } = getCachedSectionColors(el);
          return { barBg: bg, barText: text };
        };

        const applyHeaderStyles = () => {
          const { barBg, barText } = resolveBarColors();
          const announceInverse = shouldInverseAnnounce(barText);
          const announceBg = announceInverse ? ANNOUNCE_ON_DARK_BG : ANNOUNCE_ON_LIGHT_BG;
          const announceText = announceInverse ? ANNOUNCE_ON_DARK_TEXT : ANNOUNCE_ON_LIGHT_TEXT;

          const key = `${barBg}|${barText}|${announceBg}|${announceText}`;
          if (key === lastStyleKey) return;
          lastStyleKey = key;

          bar.style.backgroundColor = barBg;
          bar.style.color = barText;
          bar.style.borderBottomColor = barBg;
          bar.style.webkitBackdropFilter = 'none';
          bar.style.backdropFilter = 'none';

          announce.style.backgroundColor = announceBg;
          announce.style.color = announceText;
        };

        const runDetection = () => {
          applyHeaderStyles();
        };

        const scheduleUpdate = () => {
          if (rafId) return;
          rafId = window.requestAnimationFrame(() => {
            rafId = 0;
            runDetection();
          });
        };

        const connectObserver = () => {
          observer?.disconnect();
          const topInset = Math.max(1, Math.ceil(getHeaderStackHeight()));
          observer = new IntersectionObserver(
            () => {
              if (!headerIoUpdatesEnabled) return;
              scheduleUpdate();
            },
            {
              root: null,
              rootMargin: `-${topInset}px 0px 0px 0px`,
              threshold: [0, 0.05, 0.1, 0.2, 0.35, 0.5, 0.65, 0.8, 0.95, 1],
            }
          );
          bgSections.forEach((section) => observer.observe(section));
        };

        const revealHeaderUi = () => {
          window.requestAnimationFrame(() => {
            window.requestAnimationFrame(() => {
              document.documentElement.classList.add('zs-header-ui-revealed');
            });
          });
        };

        const init = () => {
          document.documentElement.classList.add('zs-header-js');
          sectionColorCache = new WeakMap();
          bgSections = Array.from(document.querySelectorAll('[data-header-bg]'));
          lastStyleKey = '';
          if (window.scrollY > 0.5) headerIoUpdatesEnabled = true;
          applyHeaderStyles();
          window.setTimeout(() => {
            connectObserver();
          }, 50);
          revealHeaderUi();
        };

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', init, { once: true });
        } else {
          init();
        }

        window.addEventListener(
          'scroll',
          () => {
            headerIoUpdatesEnabled = true;
            scheduleUpdate();
          },
          { passive: true }
        );
        window.addEventListener('resize', () => {
          headerIoUpdatesEnabled = true;
          connectObserver();
          lastStyleKey = '';
          scheduleUpdate();
        });
      })();
    </script>
  </body>
</html>
