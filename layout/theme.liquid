<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% comment %}
      Font preloading:
      1. Preconnect to font CDN for faster connection
      2. Preload only the critical font variant (base weight)
      3. Additional variants load on-demand via @font-face
    {% endcomment %}
    {% unless settings.type_primary_font.system? %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>

      {% comment %} Preload the base font variant for initial page render {% endcomment %}
      {{ settings.type_primary_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}

    {% comment %} Zalva Shape brand fonts (Cormorant Garamond + Jost) {% endcomment %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;1,300&family=Jost:wght@400;500;600&display=swap"
      rel="stylesheet"
    >

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}

    <style>
      :root {
        --zalva-ivory: #faf8f5;
        --zalva-noir: #1a1a1a;
        --zalva-champagne: #c8a96e;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        animation: zalva-page-fade-in 0.5s ease both;
      }

      @keyframes zalva-page-fade-in {
        from {
          opacity: 0;
        }

        to {
          opacity: 1;
        }
      }

      header {
        position: sticky;
        top: 0;
        z-index: 60;
        background-color: var(--zalva-ivory);
        color: var(--zalva-noir);
        transform: translate3d(0, 0, 0);
        transition: transform 0.3s ease, background-color 0.3s ease, color 0.3s ease;
        will-change: transform;
      }

      header a {
        transition: color 0.3s ease;
      }

      .zalva-home header.zalva-nav--transparent {
        background-color: transparent;
        color: #ffffff;
      }

      .zalva-home header.zalva-nav--transparent a {
        color: #ffffff;
      }

      .zalva-home header.zalva-nav--transparent svg,
      .zalva-home header.zalva-nav--transparent svg * {
        fill: currentColor !important;
        stroke: currentColor !important;
      }

      header.zalva-nav--hidden {
        transform: translate3d(0, -100%, 0);
      }

      .animate-on-scroll {
        opacity: 0;
        transform: translate3d(0, 30px, 0);
        transition: opacity 0.7s ease, transform 0.7s ease;
        will-change: opacity, transform;
      }

      .animate-on-scroll.is-visible {
        opacity: 1;
        transform: translate3d(0, 0, 0);
      }

      #zalva-cursor {
        position: fixed;
        top: 0;
        left: 0;
        width: 20px;
        height: 20px;
        border-radius: 999px;
        border: 2px solid var(--zalva-champagne);
        background: transparent;
        box-shadow: 0 0 6px rgba(200, 169, 110, 0.5);
        pointer-events: none;
        transform: translate3d(-999px, -999px, 0) scale(1);
        transform-origin: center center;
        opacity: 0;
        z-index: 2147483646;
        transition: opacity 0.15s ease;
      }

      #zalva-cursor::before {
        content: '';
        position: absolute;
        top: 50%;
        left: 50%;
        width: 4px;
        height: 4px;
        margin: -2px 0 0 -2px;
        border-radius: 50%;
        background-color: var(--zalva-champagne);
      }

      #zalva-cursor.is-visible {
        opacity: 1;
      }

      @media (hover: hover) and (pointer: fine) {
        body {
          cursor: none;
        }

        a,
        button,
        input,
        select,
        textarea,
        [role='button'] {
          cursor: none;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }

        body {
          animation: none !important;
        }

        header {
          transition: none !important;
        }

        .animate-on-scroll {
          transition: none !important;
          opacity: 1 !important;
          transform: none !important;
        }

        #zalva-cursor {
          display: none !important;
        }
      }
    </style>
  </head>

  <body class="template-{{ request.page_type }}{% if request.page_type == 'index' %} zalva-home{% endif %}">
    {% section 'announcement-bar' %}

    {% sections 'header-group' %}

    {{ content_for_layout }}

    {% section 'footer' %}

    <script>
      (() => {
        const header = document.querySelector('header');
        if (!header) return;

        const prefersReducedMotion =
          window.matchMedia &&
          window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        const isHome = document.body.classList.contains('zalva-home');
        const hero = isHome ? document.querySelector('[data-main-hero]') : null;

        let lastY = window.scrollY || 0;
        let lastToggleY = lastY;
        let rafId = 0;

        const setTransparentState = (scrollY) => {
          if (!isHome || !hero) return;
          const rect = hero.getBoundingClientRect();
          const heroTop = scrollY + rect.top;
          const heroBottom = heroTop + rect.height;
          const headerHeight = header.offsetHeight || 0;
          const pastHero = scrollY >= Math.max(0, heroBottom - headerHeight);
          header.classList.toggle('zalva-nav--transparent', !pastHero);
        };

        const update = () => {
          rafId = 0;

          const y = window.scrollY || 0;
          const delta = y - lastY;

          if (!prefersReducedMotion) {
            if (Math.abs(y - lastToggleY) >= 50) {
              if (delta > 0) {
                header.classList.add('zalva-nav--hidden');
                lastToggleY = y;
              } else if (delta < 0) {
                header.classList.remove('zalva-nav--hidden');
                lastToggleY = y;
              }
            }
          }

          setTransparentState(y);
          lastY = y;
        };

        const onScroll = () => {
          if (rafId) return;
          rafId = window.requestAnimationFrame(update);
        };

        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll, { passive: true });

        setTransparentState(lastY);
      })();
    </script>

    <script>
      (() => {
        const prefersReducedMotion =
          window.matchMedia &&
          window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // Scroll fade-in for sections
        if (!prefersReducedMotion && 'IntersectionObserver' in window) {
          const sectionCandidates = Array.from(
            document.querySelectorAll(
              'main > section, main > .shopify-section, [id^=\"shopify-section-\"]'
            )
          );

          sectionCandidates.forEach((el) => el.classList.add('animate-on-scroll'));

          const io = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');
                  io.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.15 }
          );

          sectionCandidates.forEach((el) => io.observe(el));
        } else {
          document
            .querySelectorAll('.animate-on-scroll')
            .forEach((el) => el.classList.add('is-visible'));
        }

        // Custom cursor (desktop only)
        const finePointer =
          window.matchMedia &&
          window.matchMedia('(hover: hover) and (pointer: fine)').matches;

        if (!prefersReducedMotion && finePointer) {
          const cursor = document.createElement('div');
          cursor.id = 'zalva-cursor';
          document.body.appendChild(cursor);

          const half = 10;
          let clientX = 0;
          let clientY = 0;
          let isHover = false;

          const paint = () => {
            const scale = isHover ? 2.5 : 1;
            cursor.style.transform = `translate3d(${clientX - half}px, ${clientY - half}px, 0) scale(${scale})`;
          };

          const onMove = (e) => {
            clientX = e.clientX;
            clientY = e.clientY;
            paint();
            cursor.classList.add('is-visible');
          };

          const interactiveSelector =
            'a, button, input[type=\"submit\"], input[type=\"button\"], [role=\"button\"], .zalva-pcard__quick-add';

          const setHover = (next) => {
            if (isHover === next) return;
            isHover = next;
            cursor.classList.toggle('is-hover', next);
            paint();
          };

          document.addEventListener('mousemove', onMove, { passive: true });
          document.addEventListener(
            'pointerover',
            (e) => setHover(Boolean(e.target && e.target.closest(interactiveSelector))),
            true
          );
          document.addEventListener(
            'pointerout',
            (e) => {
              const toEl = e.relatedTarget;
              if (toEl && toEl.closest && toEl.closest(interactiveSelector)) return;
              setHover(false);
            },
            true
          );
          window.addEventListener('blur', () => cursor.classList.remove('is-visible'));
          document.addEventListener('mouseleave', () => cursor.classList.remove('is-visible'));
        }
      })();
    </script>
  </body>
</html>
