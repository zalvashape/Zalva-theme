<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% comment %}
      Font preloading:
      1. Preconnect to font CDN for faster connection
      2. Preload only the critical font variant (base weight)
      3. Additional variants load on-demand via @font-face
    {% endcomment %}
    {% unless settings.type_primary_font.system? %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>

      {% comment %} Preload the base font variant for initial page render {% endcomment %}
      {{ settings.type_primary_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}

    {% comment %} Zalva Shape brand fonts (Cormorant Garamond + Jost) {% endcomment %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;1,300&family=Jost:wght@400;500;600&display=swap"
      rel="stylesheet"
    >

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}

    <style>
      :root {
        --zalva-ivory: #faf8f5;
        --zalva-noir: #1a1a1a;
      }

      header {
        position: sticky;
        top: 0;
        z-index: 60;
        background-color: var(--zalva-ivory);
        color: var(--zalva-noir);
        transform: translate3d(0, 0, 0);
        transition: transform 0.3s ease, background-color 0.3s ease, color 0.3s ease;
        will-change: transform;
      }

      header a {
        transition: color 0.3s ease;
      }

      .zalva-home header.zalva-nav--transparent {
        background-color: transparent;
        color: #ffffff;
      }

      .zalva-home header.zalva-nav--transparent a {
        color: #ffffff;
      }

      .zalva-home header.zalva-nav--transparent svg,
      .zalva-home header.zalva-nav--transparent svg * {
        fill: currentColor !important;
        stroke: currentColor !important;
      }

      header.zalva-nav--hidden {
        transform: translate3d(0, -100%, 0);
      }

      @media (prefers-reduced-motion: reduce) {
        header {
          transition: none !important;
        }
      }
    </style>
  </head>

  <body class="template-{{ request.page_type }}{% if request.page_type == 'index' %} zalva-home{% endif %}">
    {% section 'announcement-bar' %}

    {% sections 'header-group' %}

    {{ content_for_layout }}

    {% section 'footer' %}

    <script>
      (() => {
        const header = document.querySelector('header');
        if (!header) return;

        const prefersReducedMotion =
          window.matchMedia &&
          window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        const isHome = document.body.classList.contains('zalva-home');
        const hero = isHome ? document.querySelector('[data-main-hero]') : null;

        let lastY = window.scrollY || 0;
        let lastToggleY = lastY;
        let rafId = 0;

        const setTransparentState = (scrollY) => {
          if (!isHome || !hero) return;
          const rect = hero.getBoundingClientRect();
          const heroTop = scrollY + rect.top;
          const heroBottom = heroTop + rect.height;
          const headerHeight = header.offsetHeight || 0;
          const pastHero = scrollY >= Math.max(0, heroBottom - headerHeight);
          header.classList.toggle('zalva-nav--transparent', !pastHero);
        };

        const update = () => {
          rafId = 0;

          const y = window.scrollY || 0;
          const delta = y - lastY;

          if (!prefersReducedMotion) {
            if (Math.abs(y - lastToggleY) >= 50) {
              if (delta > 0) {
                header.classList.add('zalva-nav--hidden');
                lastToggleY = y;
              } else if (delta < 0) {
                header.classList.remove('zalva-nav--hidden');
                lastToggleY = y;
              }
            }
          }

          setTransparentState(y);
          lastY = y;
        };

        const onScroll = () => {
          if (rafId) return;
          rafId = window.requestAnimationFrame(update);
        };

        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll, { passive: true });

        setTransparentState(lastY);
      })();
    </script>
  </body>
</html>
