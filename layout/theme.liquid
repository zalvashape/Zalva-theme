<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% comment %}
      Font preloading:
      1. Preconnect to font CDN for faster connection
      2. Preload only the critical font variant (base weight)
      3. Additional variants load on-demand via @font-face
    {% endcomment %}
    {% unless settings.type_primary_font.system? %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>

      {% comment %} Preload the base font variant for initial page render {% endcomment %}
      {{ settings.type_primary_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}

    {% comment %} Zalva Shape brand fonts (Cormorant Garamond + Jost) {% endcomment %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,200;0,300;1,300&family=Jost:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    >

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}

    <style>
      header {
        position: sticky;
        top: 0;
        z-index: 100;
        width: 100%;
        background-color: #faf8f5;
        color: #1a1a1a;
        box-sizing: border-box;
      }

      header a {
        color: #1a1a1a;
      }

      header svg,
      header svg * {
        fill: currentColor;
        stroke: currentColor;
      }
    </style>
  </head>

  <body class="template-{{ request.page_type }}{% if request.page_type == 'index' %} zalva-home{% endif %}">
    {% section 'announcement-bar' %}

    {% sections 'header-group' %}

    {{ content_for_layout }}

    {% section 'footer' %}
  </body>
</html>
