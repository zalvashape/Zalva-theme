{% liquid
  assign eyebrow_text = section.settings.eyebrow_text | default: 'THE MATERIAL STORY'
  assign main_title = section.settings.main_title | default: 'Crafted to disappear.'
  assign subtitle = section.settings.subtitle | default: 'Every seam, every stitch, every fabric — chosen with intention.'
  assign closing_statement = section.settings.closing_statement | default: 'Nothing about this is mass-produced.'

  assign url_1 = 'https://images.unsplash.com/photo-1582719188393-bb71ca45dbb9?w=800&q=85'
  assign url_2 = 'https://images.unsplash.com/photo-1588117305388-c2631a279f82?w=800&q=85'
  assign url_3 = 'https://images.unsplash.com/photo-1556905055-8f358a7a47b2?w=800&q=85'
  assign url_4 = 'https://images.unsplash.com/photo-1611042553365-9b101441c135?w=800&q=85'

  if section.settings.texture_image_1 != blank
    assign src_1 = section.settings.texture_image_1 | image_url: width: 1200
  else
    assign src_1 = url_1
  endif
  if section.settings.texture_image_2 != blank
    assign src_2 = section.settings.texture_image_2 | image_url: width: 1200
  else
    assign src_2 = url_2
  endif
  if section.settings.texture_image_3 != blank
    assign src_3 = section.settings.texture_image_3 | image_url: width: 1200
  else
    assign src_3 = url_3
  endif
  if section.settings.texture_image_4 != blank
    assign src_4 = section.settings.texture_image_4 | image_url: width: 1200
  else
    assign src_4 = url_4
  endif

  assign cap_1 = section.settings.texture_caption_1 | default: 'Sourced in Italy'
  assign cap_2 = section.settings.texture_caption_2 | default: 'Double seams'
  assign cap_3 = section.settings.texture_caption_3 | default: 'Hand-finished'
  assign cap_4 = section.settings.texture_caption_4 | default: 'Tested on real bodies'
%}

<div class="texture-detail full-width" data-texture-detail data-header-theme="light">
  <header class="texture-detail__header texture-detail__prose">
    <p class="texture-detail__eyebrow" data-texture-header-el>{{ eyebrow_text }}</p>
    <h2 class="texture-detail__title" data-texture-header-el>{{ main_title }}</h2>
    <p class="texture-detail__subtitle" data-texture-header-el>{{ subtitle }}</p>
  </header>

  <div class="texture-detail__grid-bleed">
    <div class="texture-detail__grid">
      <div class="texture-detail__cell" data-texture-cell>
        <div class="texture-detail__media">
          <img
            class="texture-detail__img"
            src="{{ src_1 }}"
            alt="{{ cap_1 | escape }}"
            width="800"
            height="800"
            loading="lazy"
            decoding="async"
          >
          <div class="texture-detail__caption-wrap">
            <span class="texture-detail__caption">{{ cap_1 }}</span>
          </div>
        </div>
      </div>
      <div class="texture-detail__cell" data-texture-cell>
        <div class="texture-detail__media">
          <img
            class="texture-detail__img"
            src="{{ src_2 }}"
            alt="{{ cap_2 | escape }}"
            width="800"
            height="800"
            loading="lazy"
            decoding="async"
          >
          <div class="texture-detail__caption-wrap">
            <span class="texture-detail__caption">{{ cap_2 }}</span>
          </div>
        </div>
      </div>
      <div class="texture-detail__cell" data-texture-cell>
        <div class="texture-detail__media">
          <img
            class="texture-detail__img"
            src="{{ src_3 }}"
            alt="{{ cap_3 | escape }}"
            width="800"
            height="800"
            loading="lazy"
            decoding="async"
          >
          <div class="texture-detail__caption-wrap">
            <span class="texture-detail__caption">{{ cap_3 }}</span>
          </div>
        </div>
      </div>
      <div class="texture-detail__cell" data-texture-cell>
        <div class="texture-detail__media">
          <img
            class="texture-detail__img"
            src="{{ src_4 }}"
            alt="{{ cap_4 | escape }}"
            width="800"
            height="800"
            loading="lazy"
            decoding="async"
          >
          <div class="texture-detail__caption-wrap">
            <span class="texture-detail__caption">{{ cap_4 }}</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <footer class="texture-detail__footer texture-detail__prose">
    <div class="texture-detail__rule" aria-hidden="true" data-texture-footer-el></div>
    <p class="texture-detail__closing" data-texture-footer-el>{{ closing_statement }}</p>
  </footer>
</div>

{% stylesheet %}
  .texture-detail {
    --td-ivory: #faf8f5;
    --td-champagne: #c8a96e;
    --td-noir: #1a1a1a;
    --td-warm-taupe: #a07060;
    --td-deep-brown: #3d2b24;

    width: 100%;
    margin: 0;
    background-color: var(--td-ivory);
    padding-block: 0;
    box-sizing: border-box;
    display: flow-root;
  }

  .texture-detail__prose {
    width: 100%;
    max-width: 880px;
    margin-inline: auto;
    box-sizing: border-box;
    padding-inline: 20px;
  }

  @media (min-width: 640px) {
    .texture-detail__prose {
      padding-inline: 40px;
    }
  }

  .texture-detail__header {
    text-align: center;
    margin-top: 50px;
    margin-bottom: 50px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  @media (min-width: 990px) {
    .texture-detail__header {
      margin-top: 80px;
      margin-bottom: 80px;
    }
  }

  .texture-detail__eyebrow {
    margin: 0;
    font-family: Jost, var(--font-primary--family), system-ui, sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--td-champagne);
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  .texture-detail__title {
    margin: 16px 0 0;
    font-family: 'Cormorant Garamond', 'Times New Roman', Times, serif;
    font-weight: 300;
    font-style: italic;
    font-size: clamp(32px, 4vw, 52px);
    line-height: 1.2;
    color: var(--td-noir);
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  .texture-detail__subtitle {
    margin: 18px 0 0;
    max-width: 480px;
    font-family: Jost, var(--font-primary--family), system-ui, sans-serif;
    font-size: 14px;
    font-weight: 300;
    line-height: 1.7;
    color: var(--td-warm-taupe);
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  .texture-detail__grid-bleed {
    width: 100%;
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  .texture-detail__grid {
    display: grid;
    gap: 2px;
    width: 100%;
    grid-template-columns: 1fr;
    box-sizing: border-box;
  }

  @media (min-width: 640px) {
    .texture-detail__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 990px) {
    .texture-detail__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .texture-detail__cell {
    min-width: 0;
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  .texture-detail__media {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 0;
    background-color: #ebe4dc;
  }

  .texture-detail__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transform: scale(1);
    transition: transform 0.8s ease;
  }

  .texture-detail__media:hover .texture-detail__img,
  .texture-detail__media:focus-within .texture-detail__img {
    transform: scale(1.03);
  }

  .texture-detail__caption-wrap {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: stretch;
    padding: 12px 14px;
    background: linear-gradient(to top, rgba(26, 26, 26, 0.7), transparent 55%);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  .texture-detail__media:hover .texture-detail__caption-wrap,
  .texture-detail__media:focus-within .texture-detail__caption-wrap {
    opacity: 1;
  }

  @media (hover: none) {
    .texture-detail__caption-wrap {
      opacity: 1;
    }
  }

  .texture-detail__caption {
    font-family: Jost, var(--font-primary--family), system-ui, sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--td-ivory);
    display: block;
    width: 100%;
  }

  .texture-detail__footer {
    margin-top: 40px;
    margin-bottom: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  @media (min-width: 990px) {
    .texture-detail__footer {
      margin-top: 60px;
    }
  }

  .texture-detail__rule {
    width: 60px;
    height: 1px;
    margin: 0 0 32px;
    background-color: var(--td-champagne);
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  .texture-detail__closing {
    margin: 0;
    max-width: 36rem;
    font-family: 'Cormorant Garamond', 'Times New Roman', Times, serif;
    font-weight: 300;
    font-style: italic;
    font-size: 22px;
    line-height: 1.35;
    letter-spacing: 0.02em;
    color: var(--td-deep-brown);
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  /* Header stagger: 0, 0.15s, 0.3s — duration 0.8s */
  .texture-detail.is-visible .texture-detail__header [data-texture-header-el]:nth-child(1) {
    animation: texture-detail-fade-up 0.8s ease forwards;
    animation-delay: 0s;
  }

  .texture-detail.is-visible .texture-detail__header [data-texture-header-el]:nth-child(2) {
    animation: texture-detail-fade-up 0.8s ease forwards;
    animation-delay: 0.15s;
  }

  .texture-detail.is-visible .texture-detail__header [data-texture-header-el]:nth-child(3) {
    animation: texture-detail-fade-up 0.8s ease forwards;
    animation-delay: 0.3s;
  }

  /* Cells after header: header ends ~1.1s; cells at 1.1 + n×0.1s */
  .texture-detail.is-visible .texture-detail__grid .texture-detail__cell:nth-child(1) {
    animation: texture-detail-fade-up-cell 0.8s ease forwards;
    animation-delay: 1.1s;
  }

  .texture-detail.is-visible .texture-detail__grid .texture-detail__cell:nth-child(2) {
    animation: texture-detail-fade-up-cell 0.8s ease forwards;
    animation-delay: 1.2s;
  }

  .texture-detail.is-visible .texture-detail__grid .texture-detail__cell:nth-child(3) {
    animation: texture-detail-fade-up-cell 0.8s ease forwards;
    animation-delay: 1.3s;
  }

  .texture-detail.is-visible .texture-detail__grid .texture-detail__cell:nth-child(4) {
    animation: texture-detail-fade-up-cell 0.8s ease forwards;
    animation-delay: 1.4s;
  }

  /* Footer: after last cell animation completes (1.4 + 0.8 = 2.2s) + 0.5s gap */
  .texture-detail.is-visible .texture-detail__footer [data-texture-footer-el]:nth-child(1) {
    animation: texture-detail-fade-up 0.8s ease forwards;
    animation-delay: 2.7s;
  }

  .texture-detail.is-visible .texture-detail__footer [data-texture-footer-el]:nth-child(2) {
    animation: texture-detail-fade-up 0.8s ease forwards;
    animation-delay: 3.2s;
  }

  .texture-detail.reveal-settled .texture-detail__header [data-texture-header-el],
  .texture-detail.reveal-settled .texture-detail__grid .texture-detail__cell,
  .texture-detail.reveal-settled .texture-detail__footer [data-texture-footer-el] {
    animation: none !important;
    opacity: 1 !important;
    transform: none !important;
  }

  @keyframes texture-detail-fade-up {
    from {
      opacity: 0;
      transform: translate3d(0, 24px, 0);
    }

    to {
      opacity: 1;
      transform: translate3d(0, 0, 0);
    }
  }

  @keyframes texture-detail-fade-up-cell {
    from {
      opacity: 0;
      transform: translate3d(0, 30px, 0);
    }

    to {
      opacity: 1;
      transform: translate3d(0, 0, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .texture-detail__header [data-texture-header-el],
    .texture-detail__grid .texture-detail__cell,
    .texture-detail__footer [data-texture-footer-el] {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }

    .texture-detail.reveal-settled .texture-detail__header [data-texture-header-el],
    .texture-detail.reveal-settled .texture-detail__grid .texture-detail__cell,
    .texture-detail.reveal-settled .texture-detail__footer [data-texture-footer-el] {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }

    .texture-detail__img {
      transition: none !important;
    }
  }
{% endstylesheet %}

<script>
  (() => {
    const root = document.querySelector('[data-texture-detail]');
    if (!root) return;

    const REVEAL_IO_DELAY_MS = 100;
    const REVEAL_FALLBACK_MS = 1000;
    let revealDone = false;
    let fallbackTimer = 0;
    let io = null;
    let removeScrollListener = null;

    const clearRevealFallback = () => {
      if (fallbackTimer) window.clearTimeout(fallbackTimer);
      fallbackTimer = 0;
    };

    const disconnectIo = () => {
      if (io) {
        io.disconnect();
        io = null;
      }
    };

    const markSettled = () => {
      if (revealDone) return;
      revealDone = true;
      clearRevealFallback();
      disconnectIo();
      if (typeof removeScrollListener === 'function') {
        removeScrollListener();
        removeScrollListener = null;
      }
      root.classList.remove('is-visible');
      root.classList.add('reveal-settled');
    };

    const markAnimated = () => {
      if (revealDone) return;
      revealDone = true;
      clearRevealFallback();
      disconnectIo();
      if (typeof removeScrollListener === 'function') {
        removeScrollListener();
        removeScrollListener = null;
      }
      root.classList.remove('reveal-settled');
      root.classList.add('is-visible');
    };

    const scheduleFallback = () => {
      clearRevealFallback();
      fallbackTimer = window.setTimeout(() => {
        if (revealDone) return;
        markSettled();
      }, REVEAL_FALLBACK_MS);
    };

    const isInViewport = (el) => {
      const r = el.getBoundingClientRect();
      const vh = window.innerHeight || document.documentElement.clientHeight;
      return r.bottom > 0 && r.top < vh;
    };

    const prefersReducedMotion =
      window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const startReveal = () => {
      if (prefersReducedMotion) {
        markSettled();
        return;
      }

      if (!('IntersectionObserver' in window)) {
        markSettled();
        return;
      }

      if (isInViewport(root)) {
        markSettled();
        return;
      }

      scheduleFallback();

      let lastScrollY = window.scrollY || window.pageYOffset || 0;
      const onScroll = () => {
        lastScrollY = window.scrollY || window.pageYOffset || 0;
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      removeScrollListener = () => window.removeEventListener('scroll', onScroll);

      io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            if (entry.intersectionRatio < 0.15) return;
            const y = window.scrollY || window.pageYOffset || 0;
            const scrollingDown = y >= lastScrollY - 2;
            if (scrollingDown) markAnimated();
            else markSettled();
          });
        },
        { threshold: [0, 0.08, 0.15, 0.25, 0.4, 0.55, 0.7, 0.85, 1] }
      );

      io.observe(root);
    };

    window.setTimeout(startReveal, REVEAL_IO_DELAY_MS);
  })();
</script>

