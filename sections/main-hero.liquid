{% liquid
  assign headline = section.settings.headline | default: 'Sculpted for you.'
  assign subtitle = section.settings.subtitle | default: 'Premium shapewear for every body.'
  assign button_label = section.settings.button_label | default: 'SHOP NOW'
  assign button_link = section.settings.button_link | default: routes.all_products_collection_url
  assign hero_image_alt = section.settings.hero_image_alt | default: 'Zalva Shape campaign'
  assign hero_image_url = 'https://images.unsplash.com/photo-1583846783214-7229a91b20ed?w=1200&q=80'
  assign featured_collection = section.settings.featured_collection
  assign featured_limit = section.settings.featured_products_limit | default: 4
%}

<div class="main-hero full-width" data-main-hero>
  <div class="main-hero__grid">
    <div class="main-hero__copy">
      <h1 class="main-hero__headline" data-hero-headline>{{ headline }}</h1>
      <p class="main-hero__subtitle" data-hero-subtitle>{{ subtitle }}</p>
      <a class="main-hero__cta" data-hero-cta href="{{ button_link }}"><span class="main-hero__cta-label">{{ button_label }}</span></a>
    </div>
    <div class="main-hero__visual">
      <img
        class="main-hero__image"
        data-hero-parallax
        src="{{ hero_image_url }}"
        alt="{{ hero_image_alt | escape }}"
        width="1200"
        height="1500"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      >
    </div>
  </div>
</div>

{% if featured_collection != blank %}
  <div class="main-hero__featured full-width">
    <div class="main-hero__featured-inner">
      {% if section.settings.featured_heading != blank %}
        <h2 class="main-hero__featured-heading">{{ section.settings.featured_heading }}</h2>
      {% endif %}
      <ul class="main-hero__featured-grid" role="list">
        {% for product in featured_collection.products limit: featured_limit %}
          <li class="main-hero__featured-item">
            {% render 'zalva-product-card', product: product %}
          </li>
        {% endfor %}
      </ul>
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .main-hero {
    --zalva-ivory: #faf8f5;
    --zalva-champagne: #c8a96e;
    --zalva-warm-taupe: #a07060;
    --zalva-deep-brown: #3d2b24;
    --zalva-noir: #1a1a1a;

    min-height: 100dvh;
    min-height: 100vh;
    background-color: var(--zalva-ivory);
    color: var(--zalva-noir);
    display: flex;
    align-items: stretch;
  }

  .main-hero__grid {
    display: grid;
    width: 100%;
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-margin);
    grid-template-columns: 1fr;
    min-height: inherit;
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
  }

  @media (min-width: 900px) {
    .main-hero__grid {
      grid-template-columns: 1fr 1fr;
      align-items: stretch;
      gap: clamp(2rem, 6vw, 5rem);
    }
  }

  .main-hero__copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    justify-content: center;
    padding-block: clamp(2.5rem, 8vh, 5rem);
  }

  @media (min-width: 900px) {
    .main-hero__copy {
      align-items: flex-start;
      text-align: left;
      padding-block: clamp(3rem, 12vh, 6rem);
    }
  }

  .main-hero__headline {
    font-family: 'Cormorant Garamond', 'Times New Roman', Times, serif;
    font-weight: 300;
    font-size: clamp(2.75rem, 6vw + 1rem, 4.5rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--zalva-deep-brown);
    max-width: 14ch;
  }

  .main-hero__headline .main-hero__word {
    display: inline-block;
    opacity: 0;
    transform: translate3d(0, 12px, 0);
    transition: opacity 0.6s ease, transform 0.6s ease;
    will-change: opacity, transform;
  }

  .main-hero__headline .main-hero__word.is-revealed {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  .main-hero__subtitle {
    font-family: Jost, var(--font-primary--family), system-ui, sans-serif;
    font-weight: 400;
    font-size: clamp(1rem, 1.2vw + 0.85rem, 1.25rem);
    line-height: 1.55;
    color: var(--zalva-warm-taupe);
    margin-top: 1.25rem;
    max-width: 32ch;
  }

  .main-hero__subtitle,
  .main-hero__cta {
    opacity: 0;
    transform: translate3d(0, 10px, 0);
    transition: opacity 0.6s ease, transform 0.6s ease;
    will-change: opacity, transform;
  }

  .main-hero__subtitle.is-revealed,
  .main-hero__cta.is-revealed {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  .main-hero__cta {
    font-family: Jost, var(--font-primary--family), system-ui, sans-serif;
    font-weight: 500;
    font-size: 0.8125rem;
    letter-spacing: 0.14em;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 2rem;
    padding: 1rem 2.25rem;
    min-height: 3rem;
    color: var(--zalva-noir);
    background-color: transparent;
    border: 1px solid var(--zalva-champagne);
    position: relative;
    overflow: hidden;
    transform: translate3d(0, 0, 0);
    transition: transform 0.25s ease;
  }

  .main-hero__cta::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--zalva-champagne);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s ease;
    z-index: 0;
  }

  .main-hero__cta > * {
    position: relative;
    z-index: 1;
  }

  .main-hero__cta:hover {
    transform: scale(1.02);
  }

  .main-hero__cta:hover::before {
    transform: scaleX(1);
  }

  .main-hero__cta:focus-visible {
    outline: 2px solid var(--zalva-deep-brown);
    outline-offset: 3px;
  }

  .main-hero__visual {
    position: relative;
    overflow: hidden;
    min-height: clamp(280px, 42vh, 560px);
    background-color: var(--zalva-ivory);
  }

  @media (min-width: 900px) {
    .main-hero__visual {
      min-height: 100%;
      align-self: stretch;
    }
  }

  .main-hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: translate3d(0, 0, 0);
    will-change: transform;
  }

  @media (prefers-reduced-motion: reduce) {
    .main-hero__headline .main-hero__word,
    .main-hero__subtitle,
    .main-hero__cta {
      transition: none !important;
      transform: none !important;
      opacity: 1 !important;
    }

    .main-hero__cta::before {
      transition: none !important;
    }
  }

  .main-hero__featured {
    background-color: var(--zalva-ivory);
    padding-block: clamp(2.5rem, 6vw, 4rem);
    border-top: 1px solid rgba(26, 26, 26, 0.08);
  }

  .main-hero__featured-inner {
    width: 100%;
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }

  .main-hero__featured-heading {
    font-family: 'Cormorant Garamond', 'Times New Roman', Times, serif;
    font-weight: 300;
    font-size: clamp(1.75rem, 4vw + 0.5rem, 2.25rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--zalva-deep-brown);
    margin: 0 0 clamp(1.5rem, 3vw, 2rem);
    text-align: center;
  }

  @media (min-width: 900px) {
    .main-hero__featured-heading {
      text-align: left;
    }
  }

  .main-hero__featured-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.25rem);
    grid-template-columns: 1fr;
  }

  @media (min-width: 600px) {
    .main-hero__featured-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 990px) {
    .main-hero__featured-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .main-hero__featured-item {
    margin: 0;
    padding: 0;
    min-width: 0;
  }
{% endstylesheet %}

<script>
  (() => {
    const hero = document.querySelector('[data-main-hero]');
    if (!hero) return;

    const prefersReducedMotion =
      window.matchMedia &&
      window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const headlineEl = hero.querySelector('[data-hero-headline]');
    const subtitleEl = hero.querySelector('[data-hero-subtitle]');
    const ctaEl = hero.querySelector('[data-hero-cta]');

    if (headlineEl) {
      const original = headlineEl.textContent || '';
      const words = original.trim().split(/\s+/).filter(Boolean);

      if (!prefersReducedMotion && words.length > 0) {
        headlineEl.setAttribute('aria-label', original.trim());
        headlineEl.textContent = '';

        const spans = words.map((word, idx) => {
          const span = document.createElement('span');
          span.className = 'main-hero__word';
          span.textContent = word;
          span.setAttribute('aria-hidden', 'true');
          headlineEl.appendChild(span);
          if (idx < words.length - 1) headlineEl.appendChild(document.createTextNode(' '));
          return span;
        });

        window.requestAnimationFrame(() => {
          spans.forEach((span, index) => {
            window.setTimeout(() => span.classList.add('is-revealed'), index * 300);
          });

          const headlineDurationMs = (spans.length - 1) * 300 + 600;
          window.setTimeout(() => subtitleEl && subtitleEl.classList.add('is-revealed'), headlineDurationMs);
          window.setTimeout(() => ctaEl && ctaEl.classList.add('is-revealed'), headlineDurationMs + 600);
        });
      } else {
        subtitleEl && subtitleEl.classList.add('is-revealed');
        ctaEl && ctaEl.classList.add('is-revealed');
      }
    } else {
      subtitleEl && subtitleEl.classList.add('is-revealed');
      ctaEl && ctaEl.classList.add('is-revealed');
    }

    if (prefersReducedMotion) return;

    const imageEl = hero.querySelector('[data-hero-parallax]');
    if (!imageEl) return;

    let rafId = 0;
    let latestScrollY = window.scrollY || 0;

    const update = () => {
      rafId = 0;

      const rect = hero.getBoundingClientRect();
      const heroTop = latestScrollY + rect.top;
      const heroHeight = rect.height || 1;
      const heroBottom = heroTop + heroHeight;
      const viewportTop = latestScrollY;
      const viewportBottom = viewportTop + window.innerHeight;

      if (viewportBottom < heroTop || viewportTop > heroBottom) return;

      const relativeScroll = latestScrollY - heroTop;
      const translateY = Math.round(relativeScroll * -0.5);
      imageEl.style.transform = `translate3d(0, ${translateY}px, 0)`;
    };

    const onScroll = () => {
      latestScrollY = window.scrollY || 0;
      if (rafId) return;
      rafId = window.requestAnimationFrame(update);
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    onScroll();
  })();
</script>

{% schema %}
{
  "name": "Zalva hero",
  "tag": "section",
  "class": "section-main-hero",
  "settings": [
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Sculpted for you."
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Premium shapewear for every body."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "hero_image_alt",
      "label": "Hero image alt text",
      "default": "Zalva Shape campaign"
    },
    {
      "type": "text",
      "id": "featured_heading",
      "label": "Featured products heading",
      "default": "Featured"
    },
    {
      "type": "collection",
      "id": "featured_collection",
      "label": "Featured collection"
    },
    {
      "type": "range",
      "id": "featured_products_limit",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4,
      "label": "Featured products to show"
    }
  ],
  "presets": [
    {
      "name": "Zalva hero"
    }
  ]
}
{% endschema %}
