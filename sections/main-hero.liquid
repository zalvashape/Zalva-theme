{% liquid
  assign default_image_url = 'https://cdn.shopify.com/s/files/1/0998/1086/9562/files/GENERA_1.png?v=1778497924'
  if section.settings.hero_image != blank
    assign hero_src = section.settings.hero_image | image_url: width: 3840
  else
    assign hero_src = default_image_url
  endif

  assign top_text = section.settings.top_text | default: 'MADE TO BE WORN. NOT JUST SEEN.'
  assign w1 = section.settings.headline_word_1 | default: 'She'
  assign w2 = section.settings.headline_word_2 | default: 'wears'
  assign w3 = section.settings.headline_word_3 | default: 'herself.'
  assign subtitle = section.settings.subtitle | default: 'Premium shapewear · Sculpted for every body.'
  assign hero_alt = section.settings.hero_image_alt | default: 'Zalva Shape'
  assign explore_href = section.settings.explore_link | default: routes.all_products_collection_url
%}

<div
  class="main-hero full-width"
  data-main-hero-section
  data-header-bg="rgba(26,26,26,0.3)"
  data-header-text="#FAF8F5"
>
  <img
    class="main-hero__bg"
    src="{{ hero_src }}"
    alt="{{ hero_alt | escape }}"
    width="2000"
    height="3000"
    loading="eager"
    fetchpriority="high"
    decoding="async"
  >
  <div class="main-hero__overlay" aria-hidden="true"></div>

  <div class="main-hero__content">
    <p class="main-hero__top">{{ top_text }}</p>

    <h1 class="main-hero__headline">
      <span class="main-hero__word main-hero__word--1">{{ w1 }}</span><span class="main-hero__space"> </span><span class="main-hero__word main-hero__word--2">{{ w2 }}</span><span class="main-hero__space"> </span><span class="main-hero__word main-hero__word--3">{{ w3 }}</span>
    </h1>

    <p class="main-hero__subtitle">{{ subtitle }}</p>

    <a
      class="main-hero__explore"
      href="{{ explore_href }}"
      data-main-hero-explore
      tabindex="-1"
      aria-hidden="true"
    >
      EXPLORE
    </a>
  </div>

  <div class="main-hero__scroll-indicator" aria-hidden="true">
    <span class="main-hero__scroll-line"></span>
  </div>
</div>

{% stylesheet %}
  .main-hero {
    --hero-champagne: #c8a96e;
    --hero-ivory: #faf8f5;
    --hero-blush: #d4b5a0;
    position: relative;
    isolation: isolate;
    width: 100%;
    margin: 0;
    padding-block: 0;
    min-height: 100vh;
    min-height: 100dvh;
    overflow: hidden;
    background-color: #1a1a1a;
    color: var(--hero-ivory);
  }

  .main-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 0;
  }

  .main-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(to top, rgba(26,26,26,0.75) 0%, rgba(26,26,26,0.4) 50%, rgba(26,26,26,0.15) 100%);
  }

  .main-hero__content {
    position: absolute;
    left: 50%;
    top: 60%;
    transform: translate(-50%, -50%);
    z-index: 2;
    width: min(92vw, 56rem);
    padding-inline: clamp(1rem, 4vw, 2rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .main-hero__top {
    margin: 0;
    font-family: Jost, var(--font-primary--family), system-ui, sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--hero-champagne);
    opacity: 0;
    animation: main-hero-fade-eyebrow 0.8s ease forwards;
    animation-delay: 0.3s;
  }

  .main-hero__headline {
    margin: clamp(0.85rem, 2.5vw, 1.25rem) 0 0;
    padding: 0;
    font-family: 'Cormorant Garamond', 'Times New Roman', Times, serif;
    font-weight: 200;
    font-size: clamp(48px, 12vw, 88px);
    line-height: 1.05;
    letter-spacing: 0.02em;
    color: var(--hero-ivory);
    text-align: center;
  }

  .main-hero__word {
    display: inline-block;
    opacity: 0;
    animation: main-hero-word-in 0.6s ease forwards;
  }

  .main-hero__word--1 {
    animation-delay: 1.1s;
  }

  .main-hero__word--2 {
    animation-delay: 1.3s;
  }

  .main-hero__word--3 {
    animation-delay: 1.5s;
  }

  .main-hero__subtitle {
    margin: 24px 0 0;
    padding: 0;
    font-family: Jost, var(--font-primary--family), system-ui, sans-serif;
    font-size: 13px;
    font-weight: 300;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--hero-blush);
    opacity: 0;
    max-width: 42ch;
    animation: main-hero-fade-subtitle 0.8s ease forwards;
    animation-delay: 1.6s;
  }

  .main-hero__explore {
    margin-top: clamp(1.75rem, 5vw, 2.5rem);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 36px;
    font-family: Jost, var(--font-primary--family), system-ui, sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--hero-ivory);
    background-color: transparent;
    border: 1px solid var(--hero-ivory);
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
    transition: opacity 0.45s ease, visibility 0.45s ease, background-color 0.25s ease, border-color 0.25s ease,
      color 0.25s ease;
  }

  .main-hero__explore.is-visible {
    opacity: 1;
    pointer-events: auto;
    visibility: visible;
  }

  .main-hero__explore:focus-visible {
    outline: 2px solid var(--hero-champagne);
    outline-offset: 4px;
  }

  .main-hero__explore:hover {
    background-color: var(--hero-champagne);
    border-color: var(--hero-champagne);
    color: var(--hero-ivory);
  }

  .main-hero__scroll-indicator {
    position: absolute;
    left: 50%;
    bottom: clamp(1.25rem, 4vh, 2rem);
    transform: translateX(-50%);
    z-index: 2;
    pointer-events: none;
  }

  .main-hero__scroll-line {
    display: block;
    width: 1px;
    height: 40px;
    background-color: var(--hero-blush);
    animation: main-hero-scroll-pulse 2s ease-in-out infinite alternate;
  }

  @keyframes main-hero-fade-eyebrow {
    from {
      opacity: 0;
    }

    to {
      opacity: 0.9;
    }
  }

  @keyframes main-hero-fade-subtitle {
    from {
      opacity: 0;
    }

    to {
      opacity: 1;
    }
  }

  @keyframes main-hero-word-in {
    from {
      opacity: 0;
      transform: translate3d(0, 20px, 0);
    }

    to {
      opacity: 1;
      transform: translate3d(0, 0, 0);
    }
  }

  @keyframes main-hero-scroll-pulse {
    from {
      opacity: 1;
    }

    to {
      opacity: 0.3;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .main-hero__top,
    .main-hero__subtitle {
      animation: none !important;
      opacity: 1 !important;
    }

    .main-hero__top {
      opacity: 0.9 !important;
    }

    .main-hero__word {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }

    .main-hero__scroll-line {
      animation: none !important;
      opacity: 0.65 !important;
    }

    .main-hero__explore {
      opacity: 1 !important;
      visibility: visible !important;
      pointer-events: auto !important;
    }
  }
{% endstylesheet %}

<script>
  (() => {
    const root = document.querySelector('[data-main-hero-section]');
    if (!root) return;

    const btn = root.querySelector('[data-main-hero-explore]');
    if (!btn) return;

    const prefersReducedMotion =
      window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (prefersReducedMotion) {
      btn.removeAttribute('tabindex');
      btn.removeAttribute('aria-hidden');
      return;
    }

    const toggle = () => {
      const visible = window.scrollY >= 100;
      btn.classList.toggle('is-visible', visible);
      if (visible) {
        btn.removeAttribute('tabindex');
        btn.removeAttribute('aria-hidden');
      } else {
        btn.setAttribute('tabindex', '-1');
        btn.setAttribute('aria-hidden', 'true');
      }
    };

    window.addEventListener('scroll', toggle, { passive: true });
    toggle();
  })();
</script>

{% schema %}
{
  "name": "Zalva hero",
  "tag": "section",
  "class": "section-main-hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image",
      "info": "Optional. Default hero image when empty: https://cdn.shopify.com/s/files/1/0998/1086/9562/files/GENERA_1.png?v=1778497924"
    },
    {
      "type": "text",
      "id": "hero_image_alt",
      "label": "Hero image alt text",
      "default": "Zalva Shape"
    },
    {
      "type": "text",
      "id": "top_text",
      "label": "Top line",
      "default": "MADE TO BE WORN. NOT JUST SEEN."
    },
    {
      "type": "text",
      "id": "headline_word_1",
      "label": "Headline word 1",
      "default": "She"
    },
    {
      "type": "text",
      "id": "headline_word_2",
      "label": "Headline word 2",
      "default": "wears"
    },
    {
      "type": "text",
      "id": "headline_word_3",
      "label": "Headline word 3",
      "default": "herself."
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Premium shapewear · Sculpted for every body."
    },
    {
      "type": "url",
      "id": "explore_link",
      "label": "Explore button link"
    }
  ],
  "presets": [
    {
      "name": "Zalva hero"
    }
  ]
}
{% endschema %}
