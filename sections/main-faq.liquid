<div class="zs-faq full-width" data-zs-faq {{ section.shopify_attributes }}>
  {% comment %} Zone 1 — Page header + search {% endcomment %}
  <section
    class="zs-faq__zone zs-faq__zone--header"
    data-zs-page-pull-up
    data-header-bg="#F0E8DF"
    data-header-text="#1A1A1A"
    data-zs-faq-reveal
    aria-labelledby="zs-faq-page-title"
  >
    <div class="zs-faq__header-inner">
      <span class="zs-faq__ornament zs-faq__reveal" data-faq-delay="0" aria-hidden="true"></span>
      <p class="zs-faq__eyebrow zs-faq__reveal" data-faq-delay="1">FAQ</p>
      <h1 id="zs-faq-page-title" class="zs-faq__page-title zs-faq__reveal" data-faq-delay="2">
        Everything you want to know.
      </h1>
      <p class="zs-faq__page-sub zs-faq__reveal" data-faq-delay="3">Real answers for real questions.</p>

      <div class="zs-faq__search-wrap zs-faq__reveal" data-faq-delay="4">
        <label class="zs-faq__visually-hidden" for="ZsFaqSearch-{{ section.id }}">Search questions</label>
        <span class="zs-faq__search-icon" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
            <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.5"/>
            <path d="M16 16l5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </span>
        <div class="search-input-wrapper">
          <input
            id="ZsFaqSearch-{{ section.id }}"
            class="zs-faq__search-input zs-faq-search"
            type="search"
            name="faq-search"
            placeholder="Search a question..."
            autocomplete="off"
            data-zs-faq-search
          >
          {% render 'search-clear-button' %}
        </div>
      </div>
    </div>
  </section>

  {% comment %} Zone 2 — Category filter (sticky) {% endcomment %}
  <section class="zs-faq__zone zs-faq__zone--filter" data-zs-faq-filter aria-label="Filter by category">
    <div class="zs-faq__filter-collapse">
      <div class="zs-faq__filter-panel">
        <div class="zs-faq__filter-inner">
          <div class="zs-faq__chips" role="tablist" data-zs-faq-chips>
            <button type="button" class="zs-faq__chip is-active" role="tab" aria-selected="true" data-zs-faq-category="all">All Questions</button>
            <button type="button" class="zs-faq__chip" role="tab" aria-selected="false" data-zs-faq-category="sizing-fit">Sizing &amp; Fit</button>
            <button type="button" class="zs-faq__chip" role="tab" aria-selected="false" data-zs-faq-category="compression">Compression</button>
            <button type="button" class="zs-faq__chip" role="tab" aria-selected="false" data-zs-faq-category="shipping-returns">Shipping &amp; Returns</button>
            <button type="button" class="zs-faq__chip" role="tab" aria-selected="false" data-zs-faq-category="care-materials">Care &amp; Materials</button>
            <button type="button" class="zs-faq__chip" role="tab" aria-selected="false" data-zs-faq-category="orders-payment">Orders &amp; Payment</button>
          </div>
        </div>
      </div>
    </div>
  </section>

  {% comment %} Zone 3 — FAQ accordion {% endcomment %}
  <section class="zs-faq__zone zs-faq__zone--list" data-zs-faq-list-zone aria-label="Questions and answers">
    <div class="zs-faq__threshold-sentinel" data-zs-faq-threshold-sentinel aria-hidden="true"></div>
    <div class="zs-faq__list-inner">
      <p class="zs-faq__search-meta" data-zs-faq-search-meta hidden role="status"></p>
      <div class="zs-faq__list" data-zs-faq-list>
        <div class="zs-faq__item zs-faq__item--reveal" data-faq-category="sizing-fit" data-zs-faq-item>
          <h2 class="zs-faq__item-heading">
            <button type="button" class="zs-faq__question" aria-expanded="false" data-zs-faq-trigger>
              <span class="zs-faq__question-text">How do I find my correct size?</span>
              <span class="zs-faq__toggle" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              </span>
            </button>
          </h2>
          <div class="zs-faq__answer-wrap" data-zs-faq-panel>
            <div class="zs-faq__answer-inner">
              <p>Our Size Guide provides detailed measurements for bust, waist, and hips. Compare your measurements with our chart to find your perfect match. If you're between sizes, we recommend sizing up for everyday comfort, or sizing down for stronger compression.</p>
            </div>
          </div>
        </div>

        <div class="zs-faq__item zs-faq__item--reveal" data-faq-category="sizing-fit" data-zs-faq-item>
          <h2 class="zs-faq__item-heading">
            <button type="button" class="zs-faq__question" aria-expanded="false" data-zs-faq-trigger>
              <span class="zs-faq__question-text">What if my measurements fall between two sizes?</span>
              <span class="zs-faq__toggle" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              </span>
            </button>
          </h2>
          <div class="zs-faq__answer-wrap" data-zs-faq-panel>
            <div class="zs-faq__answer-inner">
              <p>When in doubt, size up for a more breathable fit, or size down for more sculpting. If you're still unsure, our team is happy to help — just reach out via our <a href="{{ routes.root_url }}pages/contact">Contact page</a>.</p>
            </div>
          </div>
        </div>

        <div class="zs-faq__item zs-faq__item--reveal" data-faq-category="sizing-fit" data-zs-faq-item>
          <h2 class="zs-faq__item-heading">
            <button type="button" class="zs-faq__question" aria-expanded="false" data-zs-faq-trigger>
              <span class="zs-faq__question-text">Will the bodysuit lose its shape over time?</span>
              <span class="zs-faq__toggle" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              </span>
            </button>
          </h2>
          <div class="zs-faq__answer-wrap" data-zs-faq-panel>
            <div class="zs-faq__answer-inner">
              <p>Our pieces are designed with premium materials and double-stitched seams to maintain their shape and compression even after dozens of washes. Just follow our care instructions for best longevity.</p>
            </div>
          </div>
        </div>

        <div class="zs-faq__item zs-faq__item--reveal" data-faq-category="compression" data-zs-faq-item>
          <h2 class="zs-faq__item-heading">
            <button type="button" class="zs-faq__question" aria-expanded="false" data-zs-faq-trigger>
              <span class="zs-faq__question-text">What does compression actually feel like?</span>
              <span class="zs-faq__toggle" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              </span>
            </button>
          </h2>
          <div class="zs-faq__answer-wrap" data-zs-faq-panel>
            <div class="zs-faq__answer-inner">
              <p>Our shapewear is engineered to feel held, not squeezed. Light compression smooths and supports without restriction. Medium compression sculpts and defines your shape. Strong compression provides maximum shaping and structure. Each piece is clearly labeled with its compression level.</p>
            </div>
          </div>
        </div>

        <div class="zs-faq__item zs-faq__item--reveal" data-faq-category="compression" data-zs-faq-item>
          <h2 class="zs-faq__item-heading">
            <button type="button" class="zs-faq__question" aria-expanded="false" data-zs-faq-trigger>
              <span class="zs-faq__question-text">Will it cause discomfort or marks on my skin?</span>
              <span class="zs-faq__toggle" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              </span>
            </button>
          </h2>
          <div class="zs-faq__answer-wrap" data-zs-faq-panel>
            <div class="zs-faq__answer-inner">
              <p>Properly sized shapewear should feel snug but never painful. Our seamless construction and soft elastane fabric minimize marks. If you're experiencing discomfort, you may need a larger size — feel free to contact us for guidance.</p>
            </div>
          </div>
        </div>

        <div class="zs-faq__item zs-faq__item--reveal" data-faq-category="compression" data-zs-faq-item>
          <h2 class="zs-faq__item-heading">
            <button type="button" class="zs-faq__question" aria-expanded="false" data-zs-faq-trigger>
              <span class="zs-faq__question-text">Can I wear it all day?</span>
              <span class="zs-faq__toggle" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              </span>
            </button>
          </h2>
          <div class="zs-faq__answer-wrap" data-zs-faq-panel>
            <div class="zs-faq__answer-inner">
              <p>Yes — our pieces are designed for all-day wear. The fabric is breathable and the compression is intentional, not restrictive. Many of our customers tell us they forget they're wearing it.</p>
            </div>
          </div>
        </div>

        <div class="zs-faq__item zs-faq__item--reveal" data-faq-category="compression" data-zs-faq-item>
          <h2 class="zs-faq__item-heading">
            <button type="button" class="zs-faq__question" aria-expanded="false" data-zs-faq-trigger>
              <span class="zs-faq__question-text">How tight should it feel when I first put it on?</span>
              <span class="zs-faq__toggle" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              </span>
            </button>
          </h2>
          <div class="zs-faq__answer-wrap" data-zs-faq-panel>
            <div class="zs-faq__answer-inner">
              <p>It should feel firm but comfortable — like a supportive embrace. The compression will feel slightly less intense after a few minutes as the fabric adapts to your body.</p>
            </div>
          </div>
        </div>

        <div class="zs-faq__item zs-faq__item--reveal" data-faq-category="shipping-returns" data-zs-faq-item>
          <h2 class="zs-faq__item-heading">
            <button type="button" class="zs-faq__question" aria-expanded="false" data-zs-faq-trigger>
              <span class="zs-faq__question-text">How long does shipping take?</span>
              <span class="zs-faq__toggle" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              </span>
            </button>
          </h2>
          <div class="zs-faq__answer-wrap" data-zs-faq-panel>
            <div class="zs-faq__answer-inner">
              <p>Standard shipping arrives in 3-5 business days. Express shipping arrives in 1-2 business days. We offer complimentary shipping on all orders over $75.</p>
            </div>
          </div>
        </div>

        <div class="zs-faq__item zs-faq__item--reveal" data-faq-category="shipping-returns" data-zs-faq-item>
          <h2 class="zs-faq__item-heading">
            <button type="button" class="zs-faq__question" aria-expanded="false" data-zs-faq-trigger>
              <span class="zs-faq__question-text">Where do you ship?</span>
              <span class="zs-faq__toggle" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              </span>
            </button>
          </h2>
          <div class="zs-faq__answer-wrap" data-zs-faq-panel>
            <div class="zs-faq__answer-inner">
              <p>Currently we ship within the United States. International shipping is coming soon.</p>
            </div>
          </div>
        </div>

        <div class="zs-faq__item zs-faq__item--reveal" data-faq-category="shipping-returns" data-zs-faq-item>
          <h2 class="zs-faq__item-heading">
            <button type="button" class="zs-faq__question" aria-expanded="false" data-zs-faq-trigger>
              <span class="zs-faq__question-text">Can I return an item if it doesn't fit?</span>
              <span class="zs-faq__toggle" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              </span>
            </button>
          </h2>
          <div class="zs-faq__answer-wrap" data-zs-faq-panel>
            <div class="zs-faq__answer-inner">
              <p>Yes — we offer free 30-day returns on all unworn items with tags. Simply contact our team to start a return.</p>
            </div>
          </div>
        </div>

        <div class="zs-faq__item zs-faq__item--reveal" data-faq-category="shipping-returns" data-zs-faq-item>
          <h2 class="zs-faq__item-heading">
            <button type="button" class="zs-faq__question" aria-expanded="false" data-zs-faq-trigger>
              <span class="zs-faq__question-text">How do I exchange for a different size?</span>
              <span class="zs-faq__toggle" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              </span>
            </button>
          </h2>
          <div class="zs-faq__answer-wrap" data-zs-faq-panel>
            <div class="zs-faq__answer-inner">
              <p>Reach out to our team and we'll send you a prepaid return label. Once we receive your original item, we'll ship your new size at no additional cost.</p>
            </div>
          </div>
        </div>

        <div class="zs-faq__item zs-faq__item--reveal" data-faq-category="care-materials" data-zs-faq-item>
          <h2 class="zs-faq__item-heading">
            <button type="button" class="zs-faq__question" aria-expanded="false" data-zs-faq-trigger>
              <span class="zs-faq__question-text">How should I wash my bodysuit?</span>
              <span class="zs-faq__toggle" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              </span>
            </button>
          </h2>
          <div class="zs-faq__answer-wrap" data-zs-faq-panel>
            <div class="zs-faq__answer-inner">
              <p>Hand-wash in cold water with a mild detergent and lay flat to dry. Avoid bleach, fabric softener, and the dryer to preserve the elastane and seamless construction.</p>
            </div>
          </div>
        </div>

        <div class="zs-faq__item zs-faq__item--reveal" data-faq-category="care-materials" data-zs-faq-item>
          <h2 class="zs-faq__item-heading">
            <button type="button" class="zs-faq__question" aria-expanded="false" data-zs-faq-trigger>
              <span class="zs-faq__question-text">What is your shapewear made of?</span>
              <span class="zs-faq__toggle" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              </span>
            </button>
          </h2>
          <div class="zs-faq__answer-wrap" data-zs-faq-panel>
            <div class="zs-faq__answer-inner">
              <p>Our pieces are crafted from a premium blend of nylon and elastane — designed for compression, breathability, and durability. Every material is carefully selected for comfort against the skin.</p>
            </div>
          </div>
        </div>

        <div class="zs-faq__item zs-faq__item--reveal" data-faq-category="care-materials" data-zs-faq-item>
          <h2 class="zs-faq__item-heading">
            <button type="button" class="zs-faq__question" aria-expanded="false" data-zs-faq-trigger>
              <span class="zs-faq__question-text">Is it safe to wear in warm weather?</span>
              <span class="zs-faq__toggle" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              </span>
            </button>
          </h2>
          <div class="zs-faq__answer-wrap" data-zs-faq-panel>
            <div class="zs-faq__answer-inner">
              <p>Yes — our fabric is breathable and moisture-wicking, making it comfortable to wear year-round, even in warmer climates.</p>
            </div>
          </div>
        </div>

        <div class="zs-faq__item zs-faq__item--reveal" data-faq-category="orders-payment" data-zs-faq-item>
          <h2 class="zs-faq__item-heading">
            <button type="button" class="zs-faq__question" aria-expanded="false" data-zs-faq-trigger>
              <span class="zs-faq__question-text">What payment methods do you accept?</span>
              <span class="zs-faq__toggle" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              </span>
            </button>
          </h2>
          <div class="zs-faq__answer-wrap" data-zs-faq-panel>
            <div class="zs-faq__answer-inner">
              <p>We accept Visa, Mastercard, American Express, Discover, PayPal, and Shop Pay. All transactions are secure and encrypted.</p>
            </div>
          </div>
        </div>

        <div class="zs-faq__item zs-faq__item--reveal" data-faq-category="orders-payment" data-zs-faq-item>
          <h2 class="zs-faq__item-heading">
            <button type="button" class="zs-faq__question" aria-expanded="false" data-zs-faq-trigger>
              <span class="zs-faq__question-text">Can I modify or cancel my order?</span>
              <span class="zs-faq__toggle" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              </span>
            </button>
          </h2>
          <div class="zs-faq__answer-wrap" data-zs-faq-panel>
            <div class="zs-faq__answer-inner">
              <p>If your order hasn't shipped yet, please contact us as soon as possible and we'll do our best to accommodate changes.</p>
            </div>
          </div>
        </div>

        <div class="zs-faq__item zs-faq__item--reveal" data-faq-category="orders-payment" data-zs-faq-item>
          <h2 class="zs-faq__item-heading">
            <button type="button" class="zs-faq__question" aria-expanded="false" data-zs-faq-trigger>
              <span class="zs-faq__question-text">Do you offer discounts for first-time customers?</span>
              <span class="zs-faq__toggle" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              </span>
            </button>
          </h2>
          <div class="zs-faq__answer-wrap" data-zs-faq-panel>
            <div class="zs-faq__answer-inner">
              <p>Subscribe to our newsletter to receive exclusive offers and be the first to know about new arrivals.</p>
            </div>
          </div>
        </div>

        <div class="zs-faq__item zs-faq__item--reveal" data-faq-category="orders-payment" data-zs-faq-item>
          <h2 class="zs-faq__item-heading">
            <button type="button" class="zs-faq__question" aria-expanded="false" data-zs-faq-trigger>
              <span class="zs-faq__question-text">How can I track my order?</span>
              <span class="zs-faq__toggle" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              </span>
            </button>
          </h2>
          <div class="zs-faq__answer-wrap" data-zs-faq-panel>
            <div class="zs-faq__answer-inner">
              <p>Once your order ships, you'll receive a tracking link via email. You can also view tracking details in your account dashboard.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="zs-faq__search-empty" data-zs-faq-search-empty hidden>
        <p class="zs-faq__search-empty-lead">We couldn't find an answer matching this search.</p>
        <p class="zs-faq__search-empty-sub">Try one of these:</p>
        <ul class="zs-faq__search-empty-links" role="list">
          <li>
            <button type="button" class="zs-faq__search-empty-link" data-zs-faq-jump-category="sizing-fit">Sizing &amp; Fit</button>
          </li>
          <li>
            <button type="button" class="zs-faq__search-empty-link" data-zs-faq-jump-category="shipping-returns">Shipping &amp; Returns</button>
          </li>
          <li>
            <button type="button" class="zs-faq__search-empty-link" data-zs-faq-jump-category="compression">Compression</button>
          </li>
        </ul>
        <p class="zs-faq__search-empty-contact">
          Still can't find what you need? Reach out at
          <a href="mailto:hello@zalvashape.com">hello@zalvashape.com</a>
        </p>
      </div>
    </div>
  </section>

  {% comment %} Zone 4 — CTA {% endcomment %}
  <section
    class="zs-faq__zone zs-faq__zone--cta"
    data-header-bg="#1A1A1A"
    data-header-text="#FAF8F5"
    data-zs-faq-reveal
    aria-labelledby="zs-faq-cta-title"
  >
    <div class="zs-faq__cta-inner">
      <span class="zs-faq__ornament zs-faq__ornament--sm zs-faq__reveal" data-faq-delay="0" aria-hidden="true"></span>
      <p class="zs-faq__eyebrow zs-faq__eyebrow--light zs-faq__reveal" data-faq-delay="1">Still have questions?</p>
      <h2 id="zs-faq-cta-title" class="zs-faq__cta-title zs-faq__reveal" data-faq-delay="2">We're here for you.</h2>
      <p class="zs-faq__cta-body zs-faq__reveal" data-faq-delay="3">
        Reach out to our team — real humans, real answers. We respond within 24 hours.
      </p>
      <a class="zs-faq__cta-btn zs-faq__reveal" data-faq-delay="4" href="{{ routes.root_url }}pages/contact">Contact Us</a>
      <p class="zs-faq__cta-email zs-faq__reveal" data-faq-delay="5">
        Or write to us at <a href="mailto:hello@zalvashape.com">hello@zalvashape.com</a>
      </p>
    </div>
  </section>
</div>

<script>
  (() => {
    const root = document.querySelector('[data-zs-faq]');
    if (!root) return;

    const prefersReducedMotion =
      window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const searchInput = root.querySelector('[data-zs-faq-search]');
    const filterBar = root.querySelector('[data-zs-faq-filter]');
    const chipButtons = root.querySelector('[data-zs-faq-chips]');
    const faqList = root.querySelector('[data-zs-faq-list]');
    const searchMeta = root.querySelector('[data-zs-faq-search-meta]');
    const searchEmpty = root.querySelector('[data-zs-faq-search-empty]');
    const items = root.querySelectorAll('[data-zs-faq-item]');
    let activeCategory = 'all';
    let openItem = null;

    const setActiveChip = (category) => {
      if (!chipButtons) return;
      chipButtons.querySelectorAll('.zs-faq__chip').forEach((chip) => {
        const isActive = chip.getAttribute('data-zs-faq-category') === category;
        chip.classList.toggle('is-active', isActive);
        chip.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });
    };

    const getSearchQuery = () => (searchInput?.value || '').trim().toLowerCase();

    const itemMatchesSearch = (item, query) => {
      if (!query) return true;
      const text = item.textContent.replace(/\s+/g, ' ').trim().toLowerCase();
      return text.includes(query);
    };

    const itemMatchesCategory = (item, category) => {
      if (category === 'all') return true;
      return item.getAttribute('data-faq-category') === category;
    };

    const closeItem = (item) => {
      if (!item) return;
      const trigger = item.querySelector('[data-zs-faq-trigger]');
      item.classList.remove('is-open');
      trigger?.setAttribute('aria-expanded', 'false');
    };

    const openAccordionItem = (item) => {
      if (openItem && openItem !== item) closeItem(openItem);
      const trigger = item.querySelector('[data-zs-faq-trigger]');
      const isOpen = item.classList.contains('is-open');
      if (isOpen) {
        closeItem(item);
        openItem = null;
        return;
      }
      item.classList.add('is-open');
      trigger?.setAttribute('aria-expanded', 'true');
      openItem = item;
    };

    items.forEach((item) => {
      const trigger = item.querySelector('[data-zs-faq-trigger]');
      trigger?.addEventListener('click', () => {
        if (item.classList.contains('is-filtered-out')) return;
        openAccordionItem(item);
      });
    });

    const applyFilters = () => {
      const query = getSearchQuery();
      const useSearch = query.length > 0;
      const rawQuery = (searchInput?.value || '').trim();
      let visibleCount = 0;

      root.classList.toggle('is-searching', useSearch);


      items.forEach((item) => {
        const matchSearch = itemMatchesSearch(item, query);
        const matchCategory = useSearch ? true : itemMatchesCategory(item, activeCategory);
        const show = matchSearch && matchCategory;

        item.classList.toggle('is-filtered-out', !show);
        item.classList.toggle('is-filtered-in', show);
        if (!show && item.classList.contains('is-open')) {
          closeItem(item);
          if (openItem === item) openItem = null;
        }
        if (show) visibleCount += 1;
      });

      if (searchMeta) {
        if (useSearch) {
          if (visibleCount > 0) {
            const label = visibleCount === 1 ? 'result' : 'results';
            searchMeta.textContent = `Showing ${visibleCount} ${label} for \u2018${rawQuery}\u2019`;
          } else {
            searchMeta.textContent =
              'No matches found. Try a different keyword or browse our categories.';
          }
          searchMeta.hidden = false;
        } else {
          searchMeta.hidden = true;
        }
      }

      if (searchEmpty) searchEmpty.hidden = !(useSearch && visibleCount === 0);
      if (faqList) faqList.hidden = useSearch && visibleCount === 0;
    };

    const faqListZone = root.querySelector('[data-zs-faq-list-zone]');
    const thresholdSentinel = root.querySelector('[data-zs-faq-threshold-sentinel]');
    const THRESHOLD_RATIO = 0.6;
    const RESET_OFFSET = 100;
    let passedThreshold = false;
    let thresholdResetRaf = 0;

    const setPassedThreshold = (passed) => {
      passedThreshold = passed;
      filterBar?.classList.toggle('is-passed-threshold', passed);
    };

    const getListZoneMetrics = () => {
      if (!faqListZone) return { top: 0, height: 0, thresholdY: 0 };
      const scrollY = window.scrollY || window.pageYOffset || 0;
      const rect = faqListZone.getBoundingClientRect();
      const top = rect.top + scrollY;
      const height = rect.height;
      return {
        top,
        height,
        thresholdY: top + height * THRESHOLD_RATIO,
      };
    };

    const isPastScrollThreshold = () => {
      const scrollY = window.scrollY || window.pageYOffset || 0;
      const { thresholdY } = getListZoneMetrics();
      return scrollY > thresholdY;
    };

    const checkThresholdReset = () => {
      if (!filterBar || !faqListZone || prefersReducedMotion || !passedThreshold) return;

      const scrollY = window.scrollY || window.pageYOffset || 0;
      const { top } = getListZoneMetrics();

      if (scrollY < top - RESET_OFFSET) {
        setPassedThreshold(false);
      }
    };

    const scheduleThresholdResetCheck = () => {
      if (thresholdResetRaf) {
        window.cancelAnimationFrame(thresholdResetRaf);
      }
      thresholdResetRaf = window.requestAnimationFrame(() => {
        thresholdResetRaf = 0;
        checkThresholdReset();
      });
    };

    if (!prefersReducedMotion && filterBar && faqListZone && thresholdSentinel) {
      const thresholdIo = new IntersectionObserver(
        (entries) => {
          const entry = entries[0];
          if (!entry || passedThreshold) return;

          if (entry.isIntersecting && isPastScrollThreshold()) {
            setPassedThreshold(true);
            return;
          }

          if (!entry.isIntersecting && entry.boundingClientRect.top < 0) {
            setPassedThreshold(true);
          }
        },
        { root: null, threshold: 0 }
      );

      thresholdIo.observe(thresholdSentinel);
      window.addEventListener('scroll', scheduleThresholdResetCheck, { passive: true });
      window.addEventListener('resize', scheduleThresholdResetCheck, { passive: true });
    }

    const updateChipsScrollState = () => {
      if (!chipButtons) return;
      if (window.matchMedia('(min-width: 769px)').matches) {
        chipButtons.classList.remove('is-overflowing', 'is-scrolled-end');
        return;
      }
      const hasOverflow = chipButtons.scrollWidth > chipButtons.clientWidth + 1;
      chipButtons.classList.toggle('is-overflowing', hasOverflow);
      const atEnd =
        chipButtons.scrollLeft + chipButtons.clientWidth >= chipButtons.scrollWidth - 2;
      chipButtons.classList.toggle('is-scrolled-end', atEnd);
    };

    if (chipButtons) {
      chipButtons.addEventListener('scroll', updateChipsScrollState, { passive: true });
      window.addEventListener('resize', updateChipsScrollState, { passive: true });
      if (typeof ResizeObserver !== 'undefined') {
        new ResizeObserver(updateChipsScrollState).observe(chipButtons);
      }
      updateChipsScrollState();
    }

    chipButtons?.querySelectorAll('[data-zs-faq-category]').forEach((chip) => {
      chip.addEventListener('click', () => {
        if (getSearchQuery()) return;
        activeCategory = chip.getAttribute('data-zs-faq-category') || 'all';
        setActiveChip(activeCategory);
        applyFilters();
        filterBar?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      });
    });

    root.querySelectorAll('[data-zs-faq-jump-category]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const category = btn.getAttribute('data-zs-faq-jump-category');
        if (!category || !searchInput) return;
        searchInput.value = '';
        searchInput.dispatchEvent(new Event('input', { bubbles: true }));
        activeCategory = category;
        setActiveChip(category);
        applyFilters();
        root.querySelector('[data-zs-faq-filter]')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });

    searchInput?.addEventListener('input', applyFilters);

    applyFilters();

    const revealZones = root.querySelectorAll('[data-zs-faq-reveal]');
    const listZone = faqListZone;
    const REVEAL_IO_DELAY_MS = 100;
    const REVEAL_FALLBACK_MS = 1200;

    const isInViewport = (el) => {
      const r = el.getBoundingClientRect();
      const vh = window.innerHeight || document.documentElement.clientHeight;
      return r.bottom > 0 && r.top < vh;
    };

    const markZoneSettled = (zone) => {
      zone.classList.remove('is-visible');
      zone.classList.add('reveal-settled');
    };

    const markZoneAnimated = (zone) => {
      zone.classList.remove('reveal-settled');
      zone.classList.add('is-visible');
    };

    const setupZone = (zone) => {
      if (prefersReducedMotion) {
        markZoneSettled(zone);
        return;
      }
      if (!('IntersectionObserver' in window)) {
        markZoneSettled(zone);
        return;
      }
      if (isInViewport(zone)) {
        markZoneSettled(zone);
        return;
      }

      let done = false;
      let fallbackTimer = 0;
      let io = null;

      const finish = (animated) => {
        if (done) return;
        done = true;
        if (fallbackTimer) window.clearTimeout(fallbackTimer);
        if (io) io.disconnect();
        if (animated) markZoneAnimated(zone);
        else markZoneSettled(zone);
      };

      fallbackTimer = window.setTimeout(() => finish(false), REVEAL_FALLBACK_MS);

      let lastScrollY = window.scrollY || window.pageYOffset || 0;
      const onScroll = () => {
        lastScrollY = window.scrollY || window.pageYOffset || 0;
      };
      window.addEventListener('scroll', onScroll, { passive: true });

      io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting || entry.intersectionRatio < 0.15) return;
            const y = window.scrollY || window.pageYOffset || 0;
            const scrollingDown = y >= lastScrollY - 2;
            window.removeEventListener('scroll', onScroll);
            finish(scrollingDown);
          });
        },
        { threshold: [0, 0.15, 0.3, 0.45, 0.6] }
      );

      io.observe(zone);
    };

    window.setTimeout(() => {
      revealZones.forEach(setupZone);
      if (listZone) {
        listZone.classList.add('is-visible');
        root.querySelectorAll('.zs-faq__item--reveal').forEach((item, i) => {
          item.style.setProperty('--faq-item-delay', `${Math.min(i * 0.05, 0.7)}s`);
        });
      }
    }, REVEAL_IO_DELAY_MS);
  })();
</script>

