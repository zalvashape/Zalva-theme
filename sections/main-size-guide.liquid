<div
  class="zs-size-guide full-width"
  data-zs-size-guide
  data-header-bg="#F0E8DF"
  data-header-text="#1A1A1A"
  {{ section.shopify_attributes }}
>
  {% comment %} Zone 1 — Page header {% endcomment %}
  <section
    class="zs-size-guide__zone zs-size-guide__zone--header"
    data-zs-page-pull-up
    data-zs-sg-reveal
    aria-labelledby="zs-sg-page-title"
  >
    <div class="zs-size-guide__header-inner">
      <span class="zs-size-guide__ornament zs-size-guide__reveal" data-sg-delay="0" aria-hidden="true"></span>
      <p class="zs-size-guide__eyebrow zs-size-guide__reveal" data-sg-delay="1">Fit guide</p>
      <h1 id="zs-sg-page-title" class="zs-size-guide__page-title zs-size-guide__reveal" data-sg-delay="2">Find your perfect fit.</h1>
      <p class="zs-size-guide__page-sub zs-size-guide__reveal" data-sg-delay="3">
        A guide designed to help you discover your true size — and feel held, supported, and seen.
      </p>
    </div>
  </section>

  {% comment %} Zone 2 — How to measure {% endcomment %}
  <section class="zs-size-guide__zone zs-size-guide__zone--measure" data-zs-sg-reveal aria-labelledby="zs-sg-measure-title">
    <div class="zs-size-guide__measure-inner">
      <header class="zs-size-guide__section-head zs-size-guide__reveal" data-sg-delay="0">
        <p class="zs-size-guide__eyebrow">Step 1</p>
        <h2 id="zs-sg-measure-title" class="zs-size-guide__section-title">How to measure.</h2>
      </header>

      <ul class="zs-size-guide__cards" role="list">
        <li class="zs-size-guide__card zs-size-guide__reveal" data-sg-delay="1">
          <span class="zs-size-guide__step-pill" aria-hidden="true">01</span>
          <h3 class="zs-size-guide__card-title">Bust</h3>
          <p class="zs-size-guide__card-text">
            Measure around the fullest part of your bust, keeping the tape parallel to the floor.
          </p>
        </li>
        <li class="zs-size-guide__card zs-size-guide__reveal" data-sg-delay="2">
          <span class="zs-size-guide__step-pill" aria-hidden="true">02</span>
          <h3 class="zs-size-guide__card-title">Waist</h3>
          <p class="zs-size-guide__card-text">
            Find your natural waist — the narrowest part of your torso, usually right above your belly button.
          </p>
        </li>
        <li class="zs-size-guide__card zs-size-guide__reveal" data-sg-delay="3">
          <span class="zs-size-guide__step-pill" aria-hidden="true">03</span>
          <h3 class="zs-size-guide__card-title">Hips</h3>
          <p class="zs-size-guide__card-text">
            Stand with feet together and measure around the fullest part of your hips and rear.
          </p>
        </li>
      </ul>

      <div class="zs-size-guide__pro-tip zs-size-guide__reveal" data-sg-delay="4">
        <span class="zs-size-guide__ornament zs-size-guide__ornament--sm" aria-hidden="true"></span>
        <p>For best results, measure with light underwear, standing in a relaxed posture.</p>
      </div>
    </div>
  </section>

  {% comment %} Zone 3 — Size chart {% endcomment %}
  <section class="zs-size-guide__zone zs-size-guide__zone--chart" data-zs-sg-reveal aria-labelledby="zs-sg-chart-title">
    <div class="zs-size-guide__chart-inner">
      <header class="zs-size-guide__section-head zs-size-guide__reveal" data-sg-delay="0">
        <p class="zs-size-guide__eyebrow">Step 2</p>
        <h2 id="zs-sg-chart-title" class="zs-size-guide__section-title">The size chart.</h2>
      </header>

      <div class="zs-size-guide__unit-toggle zs-size-guide__reveal" data-sg-delay="1" role="group" aria-label="Measurement unit">
        <button type="button" class="zs-size-guide__unit-btn is-active" data-zs-sg-unit="in" aria-pressed="true">Inches</button>
        <button type="button" class="zs-size-guide__unit-btn" data-zs-sg-unit="cm" aria-pressed="false">Cm</button>
      </div>

      {% comment %}
        Size finder: reads the ranges straight from the table below (single source of truth).
        Hidden without JS (the table alone still works).
      {% endcomment %}
      <form class="zs-size-guide__finder zs-size-guide__reveal" data-sg-delay="2" data-zs-sg-finder novalidate hidden>
        <div class="zs-size-guide__finder-head">
          <p class="zs-size-guide__eyebrow">Find my size</p>
          <p class="zs-size-guide__finder-sub">Enter your measurements and we&rsquo;ll match you to your size.</p>
        </div>
        <div class="zs-size-guide__finder-fields">
          {% assign finder_fields = 'bust,waist,hips' | split: ',' %}
          {% for field in finder_fields %}
            <label class="zs-size-guide__field">
              <span class="zs-size-guide__field-label">{{ field | capitalize }}</span>
              <span class="zs-size-guide__field-control">
                <input
                  class="zs-size-guide__field-input"
                  type="number"
                  inputmode="decimal"
                  step="0.1"
                  min="0"
                  name="{{ field }}"
                  placeholder="—"
                  autocomplete="off"
                  data-zs-sg-input="{{ field }}"
                >
                <span class="zs-size-guide__field-unit" data-zs-sg-unit-label>in</span>
              </span>
            </label>
          {% endfor %}
          <button type="submit" class="zs-size-guide__finder-btn">Find my size</button>
        </div>
        <div class="zs-size-guide__result" data-zs-sg-result aria-live="polite" hidden>
          <p class="zs-size-guide__result-label" data-zs-sg-result-label>Your size</p>
          <p class="zs-size-guide__result-size" data-zs-sg-result-size></p>
          <p class="zs-size-guide__result-note" data-zs-sg-result-note></p>
        </div>
      </form>

      <div class="zs-size-guide__table-wrap zs-size-guide__reveal" data-sg-delay="3">
        <table class="zs-size-guide__table" data-zs-sg-table>
          <thead>
            <tr>
              <th scope="col">Size</th>
              <th scope="col">Bust</th>
              <th scope="col">Waist</th>
              <th scope="col">Hips</th>
            </tr>
          </thead>
          <tbody>
            <tr data-zs-sg-row="XS">
              <th scope="row">XS</th>
              <td data-zs-sg-measure data-in="31–33" data-cm="79–84">31–33</td>
              <td data-zs-sg-measure data-in="23–25" data-cm="58–64">23–25</td>
              <td data-zs-sg-measure data-in="33–35" data-cm="84–89">33–35</td>
            </tr>
            <tr data-zs-sg-row="S">
              <th scope="row">S</th>
              <td data-zs-sg-measure data-in="33–35" data-cm="84–89">33–35</td>
              <td data-zs-sg-measure data-in="25–27" data-cm="64–69">25–27</td>
              <td data-zs-sg-measure data-in="35–37" data-cm="89–94">35–37</td>
            </tr>
            <tr data-zs-sg-row="M">
              <th scope="row">M</th>
              <td data-zs-sg-measure data-in="35–37" data-cm="89–94">35–37</td>
              <td data-zs-sg-measure data-in="27–29" data-cm="69–74">27–29</td>
              <td data-zs-sg-measure data-in="37–39" data-cm="94–99">37–39</td>
            </tr>
            <tr data-zs-sg-row="L">
              <th scope="row">L</th>
              <td data-zs-sg-measure data-in="37–39" data-cm="94–99">37–39</td>
              <td data-zs-sg-measure data-in="29–31" data-cm="74–79">29–31</td>
              <td data-zs-sg-measure data-in="39–41" data-cm="99–104">39–41</td>
            </tr>
            <tr data-zs-sg-row="XL">
              <th scope="row">XL</th>
              <td data-zs-sg-measure data-in="39–42" data-cm="99–107">39–42</td>
              <td data-zs-sg-measure data-in="31–34" data-cm="79–86">31–34</td>
              <td data-zs-sg-measure data-in="41–44" data-cm="104–112">41–44</td>
            </tr>
            <tr data-zs-sg-row="XXL">
              <th scope="row">XXL</th>
              <td data-zs-sg-measure data-in="42–45" data-cm="107–114">42–45</td>
              <td data-zs-sg-measure data-in="34–37" data-cm="86–94">34–37</td>
              <td data-zs-sg-measure data-in="44–47" data-cm="112–119">44–47</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="zs-size-guide__table-note zs-size-guide__reveal" data-sg-delay="4">
        Body measurements, not garment measurements. Tap a size to highlight it.
      </p>
    </div>
  </section>

  {% comment %} Zone 4 — Between sizes {% endcomment %}
  <section class="zs-size-guide__zone zs-size-guide__zone--between" data-zs-sg-reveal aria-labelledby="zs-sg-between-title">
    <div class="zs-size-guide__between-inner">
      <header class="zs-size-guide__section-head zs-size-guide__section-head--center zs-size-guide__reveal" data-sg-delay="0">
        <p class="zs-size-guide__eyebrow">Step 3</p>
        <h2 id="zs-sg-between-title" class="zs-size-guide__section-title zs-size-guide__section-title--italic">Between sizes?</h2>
      </header>

      <ul class="zs-size-guide__guidance" role="list">
        <li class="zs-size-guide__guidance-card zs-size-guide__reveal" data-sg-delay="1">
          <p class="zs-size-guide__guidance-label">For comfort</p>
          <p class="zs-size-guide__guidance-body">Size up if you prefer a softer, more breathable fit.</p>
        </li>
        <li class="zs-size-guide__guidance-card zs-size-guide__reveal" data-sg-delay="2">
          <p class="zs-size-guide__guidance-label">For compression</p>
          <p class="zs-size-guide__guidance-body">Size down for stronger sculpting and definition.</p>
        </li>
        <li class="zs-size-guide__guidance-card zs-size-guide__reveal" data-sg-delay="3">
          <p class="zs-size-guide__guidance-label">Still unsure?</p>
          <p class="zs-size-guide__guidance-body">
            <a href="{{ routes.root_url }}pages/contact">Reach out to us</a> — we'll help you find your perfect match.
          </p>
        </li>
      </ul>
    </div>
  </section>

  {% comment %} Zone 5 — Trust promise {% endcomment %}
  <section class="zs-size-guide__zone zs-size-guide__zone--promise" data-zs-sg-reveal aria-labelledby="zs-sg-promise-title">
    <div class="zs-size-guide__promise-inner">
      <span class="zs-size-guide__ornament zs-size-guide__ornament--sm zs-size-guide__reveal" data-sg-delay="0" aria-hidden="true"></span>
      <p class="zs-size-guide__eyebrow zs-size-guide__reveal" data-sg-delay="1">Our promise</p>
      <h2 id="zs-sg-promise-title" class="zs-size-guide__promise-title zs-size-guide__reveal" data-sg-delay="2">
        Try it, love it, or send it back.
      </h2>

      <ul class="zs-size-guide__badges" role="list">
        <li class="zs-size-guide__badge zs-size-guide__reveal" data-sg-delay="3">
          <span class="zs-size-guide__badge-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
              <path d="M6 8h12v10H6V8z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
              <path d="M9 12H4l2-2M4 12l2 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
          <p class="zs-size-guide__badge-title">30-day returns</p>
          <p class="zs-size-guide__badge-desc">Easy returns within 30 days</p>
        </li>
        <li class="zs-size-guide__badge zs-size-guide__reveal" data-sg-delay="4">
          <span class="zs-size-guide__badge-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
              <path d="M3 8h11v8H3V8zM14 10h4l3 3v3h-7v-6z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
              <circle cx="7" cy="18" r="2" stroke="currentColor" stroke-width="1.5"/>
              <circle cx="17" cy="18" r="2" stroke="currentColor" stroke-width="1.5"/>
            </svg>
          </span>
          <p class="zs-size-guide__badge-title">Free shipping</p>
          <p class="zs-size-guide__badge-desc">On all orders over $75</p>
        </li>
        <li class="zs-size-guide__badge zs-size-guide__reveal" data-sg-delay="5">
          <span class="zs-size-guide__badge-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
              <path d="M4 6h16v10H7l-3 3V6z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
              <path d="M8 10h8M8 13h5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </span>
          <p class="zs-size-guide__badge-title">Human support</p>
          <p class="zs-size-guide__badge-desc">Real humans, not bots</p>
        </li>
      </ul>
    </div>
  </section>
</div>

<script>
  (() => {
    const root = document.querySelector('[data-zs-size-guide]');
    if (!root) return;

    const unitBtns = root.querySelectorAll('[data-zs-sg-unit]');
    const measureCells = root.querySelectorAll('[data-zs-sg-measure]');
    const rows = Array.from(root.querySelectorAll('[data-zs-sg-row]'));
    const finder = root.querySelector('[data-zs-sg-finder]');
    const finderInputs = finder ? Array.from(finder.querySelectorAll('[data-zs-sg-input]')) : [];
    const unitLabels = finder ? finder.querySelectorAll('[data-zs-sg-unit-label]') : [];
    const resultBox = finder?.querySelector('[data-zs-sg-result]');
    const resultLabel = finder?.querySelector('[data-zs-sg-result-label]');
    const resultSize = finder?.querySelector('[data-zs-sg-result-size]');
    const resultNote = finder?.querySelector('[data-zs-sg-result-note]');
    const contactUrl = '{{ routes.root_url }}pages/contact';
    const MEASURES = ['bust', 'waist', 'hips'];
    let activeUnit = 'in';
    let hasSearched = false;

    // --- Row highlight ---
    const selectRows = (sizes) => {
      rows.forEach((row) => {
        row.classList.toggle('is-selected', sizes.includes(row.getAttribute('data-zs-sg-row')));
      });
    };

    rows.forEach((row) => {
      row.setAttribute('tabindex', '0');
      const toggle = () => {
        const size = row.getAttribute('data-zs-sg-row');
        selectRows(row.classList.contains('is-selected') ? [] : [size]);
      };
      row.addEventListener('click', toggle);
      row.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          toggle();
        }
      });
    });

    // --- Size ranges, read from the table itself (single source of truth) ---
    // Each cell holds "31–33" style ranges in data-in / data-cm.
    const parseRange = (text) => {
      const nums = String(text || '')
        .split(/[–—-]/)
        .map((n) => parseFloat(n))
        .filter((n) => Number.isFinite(n));
      return nums.length === 2 ? { min: nums[0], max: nums[1] } : null;
    };

    const getRanges = (unit) =>
      rows.map((row) => {
        const cells = row.querySelectorAll('[data-zs-sg-measure]');
        const ranges = {};
        MEASURES.forEach((m, i) => {
          ranges[m] = parseRange(cells[i]?.getAttribute(unit === 'cm' ? 'data-cm' : 'data-in'));
        });
        return { size: row.getAttribute('data-zs-sg-row'), ranges };
      });

    // Where one measurement lands: a single size, "between" two sizes (near a shared edge), or out of range.
    const locate = (value, measure, table, unit) => {
      const edge = unit === 'cm' ? 1 : 0.5;
      const first = table[0].ranges[measure];
      const last = table[table.length - 1].ranges[measure];
      if (!first || !last) return null;
      if (value < first.min - edge) return { lo: 0, hi: 0, below: true };
      if (value > last.max + edge) return { above: true };
      for (let i = 0; i < table.length; i += 1) {
        const r = table[i].ranges[measure];
        const next = table[i + 1]?.ranges[measure];
        if (next && Math.abs(value - r.max) <= edge && Math.abs(value - next.min) <= edge) {
          return { lo: i, hi: i + 1 };
        }
        if (value <= r.max + (next ? 0 : edge)) return { lo: i, hi: i };
      }
      return { lo: table.length - 1, hi: table.length - 1 };
    };

    const showResult = ({ label, size, note, highlight }) => {
      if (!resultBox) return;
      resultLabel.textContent = label;
      resultSize.textContent = size || '';
      resultNote.innerHTML = note;
      // Restart the soft entrance animation on every new result.
      resultBox.hidden = true;
      void resultBox.offsetWidth;
      resultBox.hidden = false;
      selectRows(highlight || []);
    };

    const findSize = () => {
      const table = getRanges(activeUnit);
      const entered = finderInputs
        .map((input) => ({ measure: input.getAttribute('data-zs-sg-input'), value: parseFloat(input.value) }))
        .filter((e) => Number.isFinite(e.value) && e.value > 0);

      if (entered.length === 0) {
        showResult({ label: 'Almost there', note: 'Enter at least one measurement to find your size.' });
        return;
      }

      const [minOk, maxOk] = activeUnit === 'cm' ? [50, 200] : [20, 80];
      if (entered.some((e) => e.value < minOk || e.value > maxOk)) {
        const unitName = activeUnit === 'cm' ? 'centimeters' : 'inches';
        showResult({ label: 'Check your numbers', note: `That doesn&rsquo;t look quite right. Make sure you&rsquo;re measuring in ${unitName}.` });
        return;
      }

      const spots = entered.map((e) => ({ ...e, spot: locate(e.value, e.measure, table, activeUnit) }));
      const sizes = table.map((t) => t.size);

      if (spots.some((s) => s.spot?.above)) {
        showResult({
          label: 'Honest answer',
          note: `Your measurements are above our current range (up to ${sizes[sizes.length - 1]}). We&rsquo;d rather tell you than sell you the wrong fit. <a href="${contactUrl}">Talk to us</a> &mdash; we&rsquo;ll be honest about what will and won&rsquo;t work for you.`,
        });
        return;
      }

      // A shapewear piece has to fit the fullest point, so the largest size needed wins.
      const lo = Math.max(...spots.map((s) => s.spot.lo));
      const hi = Math.max(...spots.map((s) => s.spot.hi));
      const minLo = Math.min(...spots.map((s) => s.spot.lo));
      const below = spots.some((s) => s.spot.below);
      const basedOn = entered.length < MEASURES.length ? ` Based on your ${entered.map((e) => e.measure).join(' and ')}.` : '';

      if (lo !== hi) {
        showResult({
          label: 'You’re between',
          size: `${sizes[lo]} / ${sizes[hi]}`,
          note: `Choose <strong>${sizes[lo]}</strong> for more sculpting, <strong>${sizes[hi]}</strong> for more comfort.${basedOn}`,
          highlight: [sizes[lo], sizes[hi]],
        });
        return;
      }

      let note = `Your measurements fall within ${sizes[hi]}.${basedOn}`;
      if (minLo < hi) {
        note = `Your measurements span ${sizes[minLo]} to ${sizes[hi]}. We recommend ${sizes[hi]} so it fits comfortably at your fullest point.${basedOn}`;
      } else if (below) {
        note = `You&rsquo;re at the smaller end of ${sizes[hi]}, so it may feel a little less sculpting. <a href="${contactUrl}">Talk to us</a> if you&rsquo;d like advice.`;
      }
      showResult({ label: 'Your size', size: sizes[hi], note, highlight: [sizes[hi]] });
    };

    if (finder) {
      finder.hidden = false;
      finder.addEventListener('submit', (e) => {
        e.preventDefault();
        hasSearched = true;
        finderInputs.forEach((input) => input.blur());
        findSize();
      });
      // After the first search, the answer follows the numbers as they change.
      finderInputs.forEach((input) => {
        input.addEventListener('input', () => {
          if (hasSearched) findSize();
        });
      });
    }

    const applyUnit = (unit) => {
      const previous = activeUnit;
      activeUnit = unit;
      measureCells.forEach((cell) => {
        const val = unit === 'cm' ? cell.getAttribute('data-cm') : cell.getAttribute('data-in');
        if (val) cell.textContent = val;
      });
      unitBtns.forEach((btn) => {
        const isActive = btn.getAttribute('data-zs-sg-unit') === unit;
        btn.classList.toggle('is-active', isActive);
        btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
      });
      unitLabels.forEach((label) => {
        label.textContent = unit;
      });
      // Convert anything already typed so the visitor never has to re-enter it.
      if (previous !== unit) {
        finderInputs.forEach((input) => {
          const v = parseFloat(input.value);
          if (!Number.isFinite(v)) return;
          const converted = unit === 'cm' ? v * 2.54 : v / 2.54;
          input.value = String(Math.round(converted * 10) / 10);
        });
      }
      if (hasSearched) findSize();
    };

    unitBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const unit = btn.getAttribute('data-zs-sg-unit');
        if (!unit || unit === activeUnit) return;
        applyUnit(unit);
      });
    });

    const zones = root.querySelectorAll('[data-zs-sg-reveal]');
    const REVEAL_IO_DELAY_MS = 100;
    const REVEAL_FALLBACK_MS = 1200;
    const prefersReducedMotion =
      window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const isInViewport = (el) => {
      const r = el.getBoundingClientRect();
      const vh = window.innerHeight || document.documentElement.clientHeight;
      return r.bottom > 0 && r.top < vh;
    };

    const markZoneSettled = (zone) => {
      zone.classList.remove('is-visible');
      zone.classList.add('reveal-settled');
    };

    const markZoneAnimated = (zone) => {
      zone.classList.remove('reveal-settled');
      zone.classList.add('is-visible');
    };

    const setupZone = (zone) => {
      if (prefersReducedMotion) {
        markZoneSettled(zone);
        return;
      }

      if (!('IntersectionObserver' in window)) {
        markZoneSettled(zone);
        return;
      }

      if (isInViewport(zone)) {
        markZoneSettled(zone);
        return;
      }

      let done = false;
      let fallbackTimer = 0;
      let io = null;

      const finish = (animated) => {
        if (done) return;
        done = true;
        if (fallbackTimer) window.clearTimeout(fallbackTimer);
        if (io) io.disconnect();
        if (animated) markZoneAnimated(zone);
        else markZoneSettled(zone);
      };

      fallbackTimer = window.setTimeout(() => finish(false), REVEAL_FALLBACK_MS);

      let lastScrollY = window.scrollY || window.pageYOffset || 0;
      const onScroll = () => {
        lastScrollY = window.scrollY || window.pageYOffset || 0;
      };
      window.addEventListener('scroll', onScroll, { passive: true });

      io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting || entry.intersectionRatio < 0.15) return;
            const y = window.scrollY || window.pageYOffset || 0;
            const scrollingDown = y >= lastScrollY - 2;
            window.removeEventListener('scroll', onScroll);
            finish(scrollingDown);
          });
        },
        { threshold: [0, 0.15, 0.3, 0.45, 0.6] }
      );

      io.observe(zone);
    };

    window.setTimeout(() => {
      zones.forEach(setupZone);
    }, REVEAL_IO_DELAY_MS);
  })();
</script>

