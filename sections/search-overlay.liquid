{% comment %}
  Global fullscreen predictive search overlay. Included from layout/theme.liquid.
{% endcomment %}

<div
  id="zs-search-overlay-dialog"
  class="zs-search-overlay"
  data-zs-search-overlay
  role="dialog"
  aria-modal="true"
  aria-labelledby="zs-search-overlay-title"
  aria-hidden="true"
  {{ section.shopify_attributes }}
>
  <div class="zs-search-overlay__backdrop" data-zs-search-backdrop tabindex="-1" aria-hidden="true"></div>

  <button
    type="button"
    class="zs-search-overlay__close"
    data-zs-search-close
    aria-label="Close search"
  >
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M6 6L18 18M18 6L6 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
  </button>

  <div class="zs-search-overlay__content" data-zs-search-panel>
    <p id="zs-search-overlay-title" class="zs-search-overlay__eyebrow">Search</p>

    <form class="zs-search-overlay__form" action="{{ routes.search_url }}" method="get" role="search" data-zs-search-form>
      <label class="visually-hidden" for="zs-search-overlay-input">Search</label>
      <input
        id="zs-search-overlay-input"
        class="zs-search-overlay__input"
        type="search"
        name="q"
        value=""
        autocomplete="off"
        autocorrect="off"
        autocapitalize="off"
        spellcheck="false"
        placeholder="What are you looking for?"
        data-zs-search-input
      >
    </form>

    <div class="zs-search-overlay__results" data-zs-search-results>
      <div class="zs-search-overlay__state zs-search-overlay__state--popular" data-zs-search-state-popular>
        <p class="zs-search-overlay__section-label">Popular searches</p>
        <ul class="zs-search-overlay__popular-list" role="list">
          <li>
            <a class="zs-search-overlay__popular-link" href="{{ routes.root_url }}collections/bodysuits">Bodysuits</a>
          </li>
          <li>
            <a class="zs-search-overlay__popular-link" href="{{ routes.root_url }}collections/waist-trainers">Waist trainers</a>
          </li>
          <li>
            <a class="zs-search-overlay__popular-link" href="{{ routes.root_url }}collections/fajas">Fajas</a>
          </li>
          <li>
            <a class="zs-search-overlay__popular-link" href="{{ routes.all_products_collection_url }}?sort_by=best-selling">Best sellers</a>
          </li>
          <li>
            <a class="zs-search-overlay__popular-link" href="{{ routes.all_products_collection_url }}?sort_by=created-descending">New arrivals</a>
          </li>
        </ul>
      </div>

      <div class="zs-search-overlay__state zs-search-overlay__state--live" data-zs-search-state-live hidden>
        <p class="zs-search-overlay__section-label" data-zs-search-results-label>Results</p>
        <ul class="zs-search-overlay__product-list" role="list" data-zs-search-product-list></ul>
        <a class="zs-search-overlay__view-all" href="{{ routes.search_url }}" data-zs-search-view-all hidden>View all results →</a>
      </div>

      <div class="zs-search-overlay__state zs-search-overlay__state--empty" data-zs-search-state-empty hidden>
        <p class="zs-search-overlay__empty-msg">No results found.</p>
        <p class="zs-search-overlay__section-label zs-search-overlay__section-label--sub">Popular searches</p>
        <ul class="zs-search-overlay__popular-list" role="list">
          <li>
            <a class="zs-search-overlay__popular-link" href="{{ routes.root_url }}collections/bodysuits">Bodysuits</a>
          </li>
          <li>
            <a class="zs-search-overlay__popular-link" href="{{ routes.root_url }}collections/waist-trainers">Waist trainers</a>
          </li>
          <li>
            <a class="zs-search-overlay__popular-link" href="{{ routes.root_url }}collections/fajas">Fajas</a>
          </li>
          <li>
            <a class="zs-search-overlay__popular-link" href="{{ routes.all_products_collection_url }}?sort_by=best-selling">Best sellers</a>
          </li>
          <li>
            <a class="zs-search-overlay__popular-link" href="{{ routes.all_products_collection_url }}?sort_by=created-descending">New arrivals</a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</div>

<script type="application/json" data-zs-search-config>
  {
    "suggestUrl": {{ routes.predictive_search_url | append: '.json' | json }},
    "searchUrl": {{ routes.search_url | json }}
  }
</script>

{% stylesheet %}
  .zs-search-overlay {
    --zs-so-noir: #1a1a1a;
    --zs-so-ivory: #faf8f5;
    --zs-so-champagne: #c8a96e;
    --zs-so-taupe: #a07060;

    position: fixed;
    inset: 0;
    z-index: 300;
    width: 100vw;
    max-width: 100vw;
    height: 100vh;
    height: 100dvh;
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    background-color: var(--zs-so-ivory);
    opacity: 0;
    visibility: hidden;
    transform: scale(0.98);
    pointer-events: none;
    transition:
      opacity 0.5s cubic-bezier(0.4, 0, 0.2, 1),
      transform 0.5s cubic-bezier(0.4, 0, 0.2, 1),
      visibility 0s linear 0.5s;
    overflow-x: hidden;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }

  .zs-search-overlay.is-open {
    opacity: 1;
    visibility: visible;
    transform: scale(1);
    pointer-events: auto;
    transition:
      opacity 0.5s cubic-bezier(0.4, 0, 0.2, 1),
      transform 0.5s cubic-bezier(0.4, 0, 0.2, 1),
      visibility 0s linear 0s;
  }

  .zs-search-overlay:not(.is-open) .zs-search-overlay__backdrop,
  .zs-search-overlay:not(.is-open) .zs-search-overlay__close,
  .zs-search-overlay:not(.is-open) .zs-search-overlay__content {
    pointer-events: none;
  }

  .zs-search-overlay__backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: transparent;
    cursor: default;
  }

  .zs-search-overlay__close {
    position: absolute;
    top: 20px;
    right: 20px;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
    color: var(--zs-so-noir);
    cursor: pointer;
    transition:
      color 0.25s ease,
      transform 0.25s ease;
  }

  @media (min-width: 769px) {
    .zs-search-overlay__close {
      top: 32px;
      right: 40px;
    }
  }

  .zs-search-overlay__close:hover {
    color: var(--zs-so-champagne);
    transform: scale(1.1);
  }

  .zs-search-overlay__close:focus-visible {
    outline: 2px solid var(--zs-so-champagne);
    outline-offset: 4px;
  }

  .zs-search-overlay__content {
    position: absolute;
    left: 50%;
    top: 35%;
    z-index: 1;
    transform: translate(-50%, -50%);
    width: 100%;
    max-width: 800px;
    padding: 20px;
    box-sizing: border-box;
  }

  .zs-search-overlay.is-open .zs-search-overlay__content {
    pointer-events: auto;
  }

  @media (min-width: 769px) {
    .zs-search-overlay__content {
      padding: 40px;
    }
  }

  .zs-search-overlay__eyebrow {
    margin: 0 0 16px;
    font-family: Jost, var(--font-primary--family), system-ui, sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--zs-so-taupe);
  }

  .zs-search-overlay__form {
    margin: 0;
    padding: 0;
    width: 100%;
  }

  .zs-search-overlay__input {
    display: block;
    width: 100%;
    margin: 0;
    padding: 16px 0;
    border: none;
    border-bottom: 1px solid var(--zs-so-champagne);
    border-radius: 0;
    background: transparent;
    font-family: 'Cormorant Garamond', 'Times New Roman', Times, serif;
    font-weight: 300;
    font-size: 28px;
    font-style: normal;
    line-height: 1.2;
    color: var(--zs-so-noir);
    caret-color: var(--zs-so-champagne);
    outline: none;
    box-sizing: border-box;
    -webkit-appearance: none;
    appearance: none;
  }

  @media (min-width: 769px) {
    .zs-search-overlay__input {
      font-size: clamp(28px, 5vw, 56px);
    }
  }

  .zs-search-overlay__input::placeholder {
    font-style: italic;
    color: var(--zs-so-taupe);
    opacity: 0.6;
  }

  .zs-search-overlay__results {
    margin-top: 48px;
  }

  .zs-search-overlay__section-label {
    margin: 0 0 24px;
    font-family: Jost, var(--font-primary--family), system-ui, sans-serif;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--zs-so-taupe);
  }

  .zs-search-overlay__section-label--sub {
    margin-top: 8px;
  }

  .zs-search-overlay__popular-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .zs-search-overlay__popular-list li {
    margin: 0;
    padding: 0;
  }

  .zs-search-overlay__popular-link {
    display: inline-block;
    padding: 12px 0;
    font-family: 'Cormorant Garamond', 'Times New Roman', Times, serif;
    font-weight: 300;
    font-size: 22px;
    line-height: 1.3;
    color: var(--zs-so-noir);
    text-decoration: none;
    transition:
      color 0.3s ease,
      transform 0.3s ease;
  }

  @media (min-width: 769px) {
    .zs-search-overlay__popular-link {
      padding: 8px 0;
    }
  }

  .zs-search-overlay__popular-link:hover {
    color: var(--zs-so-champagne);
    transform: translateX(4px);
  }

  .zs-search-overlay__popular-link:focus-visible {
    outline: 2px solid var(--zs-so-champagne);
    outline-offset: 4px;
  }

  .zs-search-overlay__product-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .zs-search-overlay__product-item {
    margin: 0 0 12px;
    padding: 0;
  }

  .zs-search-overlay__product-item:last-child {
    margin-bottom: 0;
  }

  .zs-search-overlay__product-card {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 12px 0;
    text-decoration: none;
    color: inherit;
    border-radius: 0;
    transition: opacity 0.25s ease;
  }

  .zs-search-overlay__product-card:hover {
    opacity: 0.85;
  }

  .zs-search-overlay__product-card:focus-visible {
    outline: 2px solid var(--zs-so-champagne);
    outline-offset: 4px;
  }

  .zs-search-overlay__product-thumb {
    flex-shrink: 0;
    width: 60px;
    height: 80px;
    object-fit: cover;
    background: rgba(26, 26, 26, 0.06);
  }

  .zs-search-overlay__product-thumb--ph {
    display: block;
    flex-shrink: 0;
    width: 60px;
    height: 80px;
    background: rgba(26, 26, 26, 0.08);
  }

  .zs-search-overlay__product-meta {
    flex: 1;
    min-width: 0;
  }

  .zs-search-overlay__product-title {
    margin: 0 0 4px;
    font-family: 'Cormorant Garamond', 'Times New Roman', Times, serif;
    font-weight: 300;
    font-size: 20px;
    line-height: 1.25;
    color: var(--zs-so-noir);
  }

  @media (min-width: 769px) {
    .zs-search-overlay__product-title {
      font-size: 22px;
    }
  }

  .zs-search-overlay__product-price {
    margin: 0;
    font-family: Jost, var(--font-primary--family), system-ui, sans-serif;
    font-size: 13px;
    font-weight: 400;
    color: var(--zs-so-taupe);
  }

  .zs-search-overlay__view-all {
    display: inline-block;
    margin-top: 20px;
    font-family: Jost, var(--font-primary--family), system-ui, sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--zs-so-noir);
    text-decoration: none;
    border-bottom: 1px solid var(--zs-so-champagne);
    padding-bottom: 2px;
    transition: color 0.25s ease;
  }

  .zs-search-overlay__view-all:hover {
    color: var(--zs-so-champagne);
  }

  .zs-search-overlay__view-all:focus-visible {
    outline: 2px solid var(--zs-so-champagne);
    outline-offset: 4px;
  }

  .zs-search-overlay__empty-msg {
    margin: 0 0 24px;
    font-family: 'Cormorant Garamond', 'Times New Roman', Times, serif;
    font-weight: 300;
    font-size: 22px;
    font-style: italic;
    color: var(--zs-so-taupe);
  }

  .zs-search-overlay .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  html.zs-search-overlay--open,
  html.zs-search-overlay--open body {
    overflow: hidden;
  }
{% endstylesheet %}

<script>
  (() => {
    const overlay = document.querySelector('[data-zs-search-overlay]');
    const openBtn = document.querySelector('[data-zs-search-open]');
    const backdrop = document.querySelector('[data-zs-search-backdrop]');
    const closeBtn = document.querySelector('[data-zs-search-close]');
    const input = document.querySelector('[data-zs-search-input]');
    const form = document.querySelector('[data-zs-search-form]');
    const statePopular = document.querySelector('[data-zs-search-state-popular]');
    const stateLive = document.querySelector('[data-zs-search-state-live]');
    const stateEmpty = document.querySelector('[data-zs-search-state-empty]');
    const resultsLabel = document.querySelector('[data-zs-search-results-label]');
    const productList = document.querySelector('[data-zs-search-product-list]');
    const viewAll = document.querySelector('[data-zs-search-view-all]');

    const cfgEl = document.querySelector('[data-zs-search-config]');
    let suggestUrl = '/search/suggest.json';
    let searchUrl = '/search';
    if (cfgEl) {
      try {
        const cfg = JSON.parse(cfgEl.textContent);
        if (cfg.suggestUrl) suggestUrl = cfg.suggestUrl;
        if (cfg.searchUrl) searchUrl = cfg.searchUrl;
      } catch (_) {}
    }

    if (!overlay || !input) return;

    const DEBOUNCE_MS = 300;
    const MAX_RESULTS = 5;

    let debounceTimer = 0;
    let abortController = null;
    let lastFocused = null;
    let isOpen = false;

    const getFocusable = () =>
      Array.from(
        overlay.querySelectorAll(
          'a[href]:not([disabled]), button:not([disabled]), input:not([disabled]), [tabindex]:not([tabindex="-1"])'
        )
      ).filter((el) => !el.closest('[hidden]') && !el.hasAttribute('hidden'));

    const trapFocus = (e) => {
      if (e.key !== 'Tab' || !isOpen) return;
      const nodes = getFocusable();
      if (!nodes.length) return;
      const first = nodes[0];
      const last = nodes[nodes.length - 1];
      if (e.shiftKey) {
        if (document.activeElement === first) {
          e.preventDefault();
          last.focus();
        }
      } else if (document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    };

    const onDocKeydown = (e) => {
      if (!isOpen) return;
      if (e.key === 'Escape') {
        e.preventDefault();
        e.stopPropagation();
        close();
      }
    };

    const setBodyLock = (lock) => {
      document.documentElement.classList.toggle('zs-search-overlay--open', lock);
    };

    const resetUI = () => {
      input.value = '';
      productList.innerHTML = '';
      if (viewAll) {
        viewAll.hidden = true;
        viewAll.href = searchUrl;
      }
      statePopular.hidden = false;
      stateLive.hidden = true;
      stateEmpty.hidden = true;
    };

    const showPopular = () => {
      statePopular.hidden = false;
      stateLive.hidden = true;
      stateEmpty.hidden = true;
    };

    const showLive = () => {
      statePopular.hidden = true;
      stateLive.hidden = false;
      stateEmpty.hidden = true;
    };

    const showEmpty = () => {
      statePopular.hidden = true;
      stateLive.hidden = true;
      stateEmpty.hidden = false;
    };

    const buildSuggestRequestUrl = (q) => {
      const u = new URL(suggestUrl, window.location.origin);
      u.searchParams.set('q', q);
      u.searchParams.set('resources[type]', 'product');
      u.searchParams.set('resources[limit]', String(MAX_RESULTS));
      return u.toString();
    };

    const parseProducts = (data) => {
      try {
        const products = data?.resources?.results?.products;
        return Array.isArray(products) ? products : [];
      } catch (_) {
        return [];
      }
    };

    const formatPrice = (p) => {
      if (p == null) return '';
      if (typeof p === 'string') return p;
      if (typeof p.price === 'string') return p.price;
      if (typeof p.price === 'number') return String(p.price);
      if (typeof p.price_min === 'string') return p.price_min;
      if (typeof p.price_min === 'number') return String(p.price_min);
      return '';
    };

    const imageUrl = (p) => {
      if (!p) return '';
      if (typeof p.featured_image === 'string') return p.featured_image;
      if (p.featured_image?.url) return p.featured_image.url;
      if (p.image) return p.image;
      return '';
    };

    const renderProducts = (products) => {
      productList.innerHTML = '';
      const frag = document.createDocumentFragment();
      products.slice(0, MAX_RESULTS).forEach((p) => {
        const li = document.createElement('li');
        li.className = 'zs-search-overlay__product-item';
        const a = document.createElement('a');
        a.className = 'zs-search-overlay__product-card';
        a.href = p.url || '#';
        const img = document.createElement('img');
        img.className = 'zs-search-overlay__product-thumb';
        img.alt = '';
        img.loading = 'lazy';
        img.width = 60;
        img.height = 80;
        const meta = document.createElement('div');
        meta.className = 'zs-search-overlay__product-meta';
        const title = document.createElement('p');
        title.className = 'zs-search-overlay__product-title';
        title.textContent = p.title || '';
        const price = document.createElement('p');
        price.className = 'zs-search-overlay__product-price';
        price.textContent = formatPrice(p);
        meta.append(title, price);
        const src = imageUrl(p);
        if (src) {
          img.src = src;
          a.append(img, meta);
        } else {
          const ph = document.createElement('span');
          ph.className = 'zs-search-overlay__product-thumb zs-search-overlay__product-thumb--ph';
          ph.setAttribute('aria-hidden', 'true');
          a.append(ph, meta);
        }
        li.append(a);
        frag.append(li);
      });
      productList.append(frag);
    };

    const runFetch = async (q) => {
      if (abortController) abortController.abort();
      abortController = new AbortController();
      const url = buildSuggestRequestUrl(q);
      const res = await fetch(url, {
        signal: abortController.signal,
        headers: { Accept: 'application/json' },
      });
      if (!res.ok) throw new Error('Search request failed');
      return res.json();
    };

    const scheduleSearch = (raw) => {
      const q = raw.trim();
      if (viewAll) {
        const u = new URL(searchUrl, window.location.origin);
        u.searchParams.set('q', q);
        viewAll.href = u.pathname + u.search;
      }
      if (!q) {
        if (abortController) abortController.abort();
        showPopular();
        productList.innerHTML = '';
        if (viewAll) viewAll.hidden = true;
        if (resultsLabel) resultsLabel.textContent = 'Results';
        return;
      }

      window.clearTimeout(debounceTimer);
      debounceTimer = window.setTimeout(async () => {
        try {
          const data = await runFetch(q);
          const products = parseProducts(data);
          if (!products.length) {
            showEmpty();
            if (viewAll) viewAll.hidden = true;
            if (resultsLabel) resultsLabel.textContent = 'Results · 0';
            return;
          }
          showLive();
          if (resultsLabel) resultsLabel.textContent = `Results · ${products.length}`;
          renderProducts(products);
          if (viewAll) {
            viewAll.hidden = false;
            const u = new URL(searchUrl, window.location.origin);
            u.searchParams.set('q', q);
            viewAll.href = u.pathname + u.search;
          }
        } catch (err) {
          if (err.name === 'AbortError') return;
          showEmpty();
          if (resultsLabel) resultsLabel.textContent = 'Results';
          if (viewAll) viewAll.hidden = true;
        }
      }, DEBOUNCE_MS);
    };

    const open = () => {
      if (isOpen) return;
      isOpen = true;
      lastFocused = document.activeElement;
      overlay.classList.add('is-open');
      overlay.setAttribute('aria-hidden', 'false');
      openBtn?.setAttribute('aria-expanded', 'true');
      setBodyLock(true);
      window.requestAnimationFrame(() => {
        input.focus({ preventScroll: true });
      });
      document.addEventListener('keydown', onDocKeydown, true);
      document.addEventListener('keydown', trapFocus, true);
    };

    const close = () => {
      if (!isOpen) return;
      isOpen = false;
      overlay.classList.remove('is-open');
      overlay.setAttribute('aria-hidden', 'true');
      openBtn?.setAttribute('aria-expanded', 'false');
      setBodyLock(false);
      input.blur();
      resetUI();
      document.removeEventListener('keydown', onDocKeydown, true);
      document.removeEventListener('keydown', trapFocus, true);
      if (abortController) abortController.abort();
      window.clearTimeout(debounceTimer);
      if (lastFocused && typeof lastFocused.focus === 'function') {
        lastFocused.focus({ preventScroll: true });
      }
    };

    openBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      if (!isOpen) open();
    });

    closeBtn?.addEventListener('click', () => close());
    backdrop?.addEventListener('click', () => close());

    input.addEventListener('input', () => {
      scheduleSearch(input.value);
    });

    form?.addEventListener('submit', (e) => {
      const q = input.value.trim();
      if (!q) {
        e.preventDefault();
        return;
      }
      close();
    });

    /** Optional: arrow keys through product result cards */
    productList.addEventListener('keydown', (e) => {
      if (stateLive.hasAttribute('hidden')) return;
      if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
      const links = Array.from(productList.querySelectorAll('a.zs-search-overlay__product-card'));
      if (!links.length) return;
      const i = links.indexOf(document.activeElement);
      let next = i;
      if (e.key === 'ArrowDown') next = i < 0 ? 0 : Math.min(links.length - 1, i + 1);
      else next = i <= 0 ? 0 : i - 1;
      e.preventDefault();
      links[next]?.focus();
    });

    overlay.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
      const list = e.target.closest('.zs-search-overlay__popular-list');
      if (!list || !overlay.contains(list)) return;
      const links = Array.from(list.querySelectorAll('a.zs-search-overlay__popular-link'));
      if (!links.length) return;
      const i = links.indexOf(document.activeElement);
      let next = i;
      if (e.key === 'ArrowDown') next = i < 0 ? 0 : Math.min(links.length - 1, i + 1);
      else next = i <= 0 ? 0 : i - 1;
      e.preventDefault();
      links[next]?.focus();
    });
  })();
</script>

