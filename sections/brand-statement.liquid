{% liquid
  assign line_1 = section.settings.line_1 | default: "This isn't about hiding."
  assign line_2 = section.settings.line_2 | default: "It's about feeling held."
  assign accent_color = section.settings.accent_color | default: '#c8a96e'
  assign text_color_1 = section.settings.text_color_1 | default: '#1a1a1a'
  assign text_color_2 = section.settings.text_color_2 | default: '#a07060'
%}

<div
  class="brand-statement full-width"
  data-brand-statement
  data-header-theme="light"
  style="
    --bs-accent: {{ accent_color }};
    --bs-text-1: {{ text_color_1 }};
    --bs-text-2: {{ text_color_2 }};
  "
>
  <div class="brand-statement__inner">
    <div class="brand-statement__accent" aria-hidden="true"></div>
    <p class="brand-statement__line brand-statement__line--1">{{ line_1 }}</p>
    <p class="brand-statement__line brand-statement__line--2">{{ line_2 }}</p>
  </div>
</div>

{% stylesheet %}
  .brand-statement {
    --bs-ivory: #faf8f5;

    width: 100%;
    margin: 0;
    background-color: var(--bs-ivory);
    padding-block: 80px;
    box-sizing: border-box;
  }

  @media (min-width: 990px) {
    .brand-statement {
      padding-block: 120px;
    }
  }

  .brand-statement__inner {
    width: 100%;
    max-width: 880px;
    margin-inline: auto;
    padding-inline: var(--page-margin);
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .brand-statement__accent {
    width: 40px;
    height: 1px;
    margin: 0 0 48px;
    background-color: var(--bs-accent);
    transform: scaleX(1);
    transform-origin: center;
  }

  .brand-statement__line {
    margin: 0;
    max-width: 100%;
    font-family: 'Cormorant Garamond', 'Times New Roman', Times, serif;
    font-weight: 300;
    font-style: italic;
    font-size: clamp(28px, 4.5vw, 56px);
    line-height: 1.3;
    letter-spacing: 0.01em;
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  .brand-statement__line--1 {
    color: var(--bs-text-1);
  }

  .brand-statement__line--2 {
    color: var(--bs-text-2);
    margin-top: 0;
  }

  .brand-statement.is-visible .brand-statement__accent {
    animation: brand-statement-accent-grow 1s ease forwards;
  }

  .brand-statement.is-visible .brand-statement__line--1 {
    animation: brand-statement-line-reveal 0.8s ease forwards;
    animation-delay: 0.3s;
  }

  .brand-statement.is-visible .brand-statement__line--2 {
    animation: brand-statement-line-reveal 0.8s ease forwards;
    animation-delay: 0.7s;
  }

  .brand-statement.reveal-settled .brand-statement__accent,
  .brand-statement.reveal-settled .brand-statement__line {
    animation: none !important;
    opacity: 1 !important;
    transform: none !important;
  }

  .brand-statement.reveal-settled .brand-statement__accent {
    transform: scaleX(1) !important;
  }

  @keyframes brand-statement-accent-grow {
    from {
      transform: scaleX(0);
    }

    to {
      transform: scaleX(1);
    }
  }

  @keyframes brand-statement-line-reveal {
    from {
      opacity: 0;
      transform: translate3d(0, 20px, 0);
    }

    to {
      opacity: 1;
      transform: translate3d(0, 0, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-statement__accent {
      animation: none !important;
      transform: scaleX(1) !important;
    }

    .brand-statement__line {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }

    .brand-statement.reveal-settled .brand-statement__accent,
    .brand-statement.reveal-settled .brand-statement__line {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }

    .brand-statement.reveal-settled .brand-statement__accent {
      transform: scaleX(1) !important;
    }
  }
{% endstylesheet %}

<script>
  (() => {
    const root = document.querySelector('[data-brand-statement]');
    if (!root) return;

    const REVEAL_IO_DELAY_MS = 100;
    const REVEAL_FALLBACK_MS = 1000;
    let revealDone = false;
    let fallbackTimer = 0;
    let io = null;
    let removeScrollListener = null;

    const clearRevealFallback = () => {
      if (fallbackTimer) window.clearTimeout(fallbackTimer);
      fallbackTimer = 0;
    };

    const disconnectIo = () => {
      if (io) {
        io.disconnect();
        io = null;
      }
    };

    const markSettled = () => {
      if (revealDone) return;
      revealDone = true;
      clearRevealFallback();
      disconnectIo();
      if (typeof removeScrollListener === 'function') {
        removeScrollListener();
        removeScrollListener = null;
      }
      root.classList.remove('is-visible');
      root.classList.add('reveal-settled');
    };

    const markAnimated = () => {
      if (revealDone) return;
      revealDone = true;
      clearRevealFallback();
      disconnectIo();
      if (typeof removeScrollListener === 'function') {
        removeScrollListener();
        removeScrollListener = null;
      }
      root.classList.remove('reveal-settled');
      root.classList.add('is-visible');
    };

    const scheduleFallback = () => {
      clearRevealFallback();
      fallbackTimer = window.setTimeout(() => {
        if (revealDone) return;
        markSettled();
      }, REVEAL_FALLBACK_MS);
    };

    const isInViewport = (el) => {
      const r = el.getBoundingClientRect();
      const vh = window.innerHeight || document.documentElement.clientHeight;
      return r.bottom > 0 && r.top < vh;
    };

    const prefersReducedMotion =
      window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const startReveal = () => {
      if (prefersReducedMotion) {
        markSettled();
        return;
      }

      if (!('IntersectionObserver' in window)) {
        markSettled();
        return;
      }

      if (isInViewport(root)) {
        markSettled();
        return;
      }

      scheduleFallback();

      let lastScrollY = window.scrollY || window.pageYOffset || 0;
      const onScroll = () => {
        lastScrollY = window.scrollY || window.pageYOffset || 0;
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      removeScrollListener = () => window.removeEventListener('scroll', onScroll);

      io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            if (entry.intersectionRatio < 0.3) return;
            const y = window.scrollY || window.pageYOffset || 0;
            const scrollingDown = y >= lastScrollY - 2;
            if (scrollingDown) markAnimated();
            else markSettled();
          });
        },
        { threshold: [0, 0.15, 0.3, 0.45, 0.6, 0.75, 1] }
      );

      io.observe(root);
    };

    window.setTimeout(startReveal, REVEAL_IO_DELAY_MS);
  })();
</script>

{% schema %}
{
  "name": "Brand statement",
  "tag": "section",
  "class": "section-brand-statement",
  "settings": [
    {
      "type": "text",
      "id": "line_1",
      "label": "Line 1",
      "default": "This isn't about hiding."
    },
    {
      "type": "text",
      "id": "line_2",
      "label": "Line 2",
      "default": "It's about feeling held."
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent line color",
      "default": "#C8A96E"
    },
    {
      "type": "color",
      "id": "text_color_1",
      "label": "Line 1 color",
      "default": "#1A1A1A"
    },
    {
      "type": "color",
      "id": "text_color_2",
      "label": "Line 2 color",
      "default": "#A07060"
    }
  ],
  "presets": [
    {
      "name": "Brand statement"
    }
  ]
}
{% endschema %}
