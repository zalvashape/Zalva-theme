{% comment %}
  Real women — testimonials with fit notes (Option C, approved Oct 2026).
  One large quote at a time + "Usually wears / Wore / Fit" + author + product line.
  Stories-style Champagne segments (fill = time left), swipe, press-and-hold or hover to pause.
  ⚠️ Current quotes are design placeholders: replace with real reviews (or hide) before launch.
{% endcomment %}

{% liquid
  assign eyebrow_text = section.settings.eyebrow_text | default: 'Worn by women like you'
  assign testimonial_count = 0
  for block in section.blocks
    if block.type == 'testimonial' and block.settings.quote != blank
      assign testimonial_count = testimonial_count | plus: 1
    endif
  endfor
%}

<div
  class="real-women full-width"
  data-real-women
  style="--rw-dwell: 7000ms;"
  data-header-bg="#F0E8DF"
  data-header-text="#1A1A1A"
>
  <div class="real-women__inner">
    <div class="real-women__ornament" data-real-women-reveal aria-hidden="true">
      <span class="real-women__ornament-line"></span>
      <span class="real-women__ornament-dot"></span>
      <span class="real-women__ornament-line"></span>
    </div>

    <p class="real-women__eyebrow" data-real-women-reveal>{{ eyebrow_text }}</p>

    <div class="real-women__stage" data-real-women-reveal data-real-women-stage>
      <div class="real-women__slides" aria-live="polite">
        {% assign slide_index = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'testimonial' and block.settings.quote != blank %}
            {% liquid
              assign usual = block.settings.usual_size | strip
              assign worn = block.settings.size_worn | strip
              assign fit = block.settings.fit | strip
              assign product_name = block.settings.product_name | strip
              assign color = block.settings.color | strip
            %}
            <blockquote
              class="real-women__slide{% if slide_index == 0 %} is-active{% endif %}"
              data-real-women-slide
              {% unless slide_index == 0 %}aria-hidden="true"{% endunless %}
              {{ block.shopify_attributes }}
            >
              <p class="real-women__quote">&ldquo;{{ block.settings.quote }}&rdquo;</p>

              {% if usual != blank or worn != blank or fit != blank %}
                <dl class="real-women__fit">
                  {% if usual != blank %}
                    <div><dt>Usually wears</dt><dd>{{ usual }}</dd></div>
                  {% endif %}
                  {% if worn != blank %}
                    <div><dt>Wore</dt><dd>{{ worn }}</dd></div>
                  {% endif %}
                  {% if fit != blank %}
                    <div><dt>Fit</dt><dd><em>{{ fit }}</em></dd></div>
                  {% endif %}
                </dl>
              {% endif %}

              <cite class="real-women__author">
                {{- block.settings.author_name -}}
                {%- if block.settings.author_city != blank -%}, {{ block.settings.author_city }}{%- endif -%}
              </cite>

              {% if product_name != blank or color != blank %}
                <span class="real-women__context">
                  {{- product_name -}}
                  {%- if product_name != blank and color != blank %} &middot; {% endif -%}
                  {{- color -}}
                </span>
              {% endif %}
            </blockquote>
            {% assign slide_index = slide_index | plus: 1 %}
          {% endif %}
        {% endfor %}
      </div>

      {% if testimonial_count > 1 %}
        <div class="real-women__segments" role="tablist" aria-label="Choose a testimonial">
          {% for i in (1..testimonial_count) %}
            <button
              type="button"
              class="real-women__seg{% if forloop.first %} is-active{% endif %}"
              role="tab"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-label="Show testimonial {{ i }}"
              data-real-women-seg
            >
              <span></span>
            </button>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  .real-women {
    --rw-linen: #f0e8df;
    --rw-champagne: #c8a96e;
    --rw-noir: #1a1a1a;
    --rw-warm-taupe: #a07060;
    --rw-track: rgba(200, 169, 110, 0.22);
    --rw-rule: rgba(200, 169, 110, 0.4);
    --rw-ease: cubic-bezier(0.22, 1, 0.36, 1);

    width: 100%;
    margin: 0;
    background-color: var(--rw-linen);
    padding-block: 80px;
    box-sizing: border-box;
  }

  @media (min-width: 990px) {
    .real-women {
      padding-block: 120px;
    }
  }

  .real-women__inner {
    width: 100%;
    max-width: 880px;
    margin-inline: auto;
    padding-inline: clamp(20px, 5vw, 40px);
    box-sizing: border-box;
    text-align: center;
  }

  .real-women__ornament {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    margin: 0 auto 32px;
    opacity: 1;
    transform: scale(1);
  }

  .real-women__ornament-line {
    width: 24px;
    height: 1px;
    background-color: var(--rw-champagne);
  }

  .real-women__ornament-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background-color: var(--rw-champagne);
    flex-shrink: 0;
  }

  .real-women__eyebrow {
    margin: 0 0 40px;
    font-family: Jost, var(--font-primary--family), system-ui, sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--rw-warm-taupe);
    opacity: 1;
  }

  /* Stage: slides stack in one grid cell, so the tallest quote sets the height (no jumps, no fixed min-height). */
  .real-women__stage {
    position: relative;
    touch-action: pan-y;
    -webkit-user-select: none;
    user-select: none;
    opacity: 1;
  }

  .real-women__slides {
    display: grid;
  }

  .real-women__slide {
    grid-area: 1 / 1;
    margin: 0;
    padding: 0;
    opacity: 0;
    transform: translate3d(14px, 0, 0);
    transition:
      opacity 0.7s var(--rw-ease),
      transform 0.7s var(--rw-ease);
    pointer-events: none;
  }

  /* The incoming quote waits for the outgoing one to clear, so two texts never overlap. */
  .real-women__slide.is-active {
    opacity: 1;
    transform: none;
    pointer-events: auto;
    z-index: 1;
    transition-delay: 0.28s;
  }

  .real-women__slide.is-leaving {
    opacity: 0;
    transform: translate3d(-14px, 0, 0);
    transition-duration: 0.35s;
    transition-delay: 0s;
  }

  .real-women__quote {
    margin: 0 auto;
    max-width: 28ch;
    font-family: 'Cormorant Garamond', 'Times New Roman', Times, serif;
    font-weight: 300;
    font-style: italic;
    font-size: clamp(24px, 5vw, 36px);
    line-height: 1.35;
    color: var(--rw-noir);
    text-wrap: balance;
  }

  /* Fit notes: the three things a shapewear buyer wants to know */
  .real-women__fit {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    max-width: 520px;
    margin: 28px auto 0;
    border-block: 1px solid var(--rw-rule);
  }

  .real-women__fit div {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 14px 6px;
  }

  .real-women__fit div + div {
    border-left: 1px solid var(--rw-rule);
  }

  .real-women__fit dt {
    font-family: Jost, var(--font-primary--family), system-ui, sans-serif;
    font-size: 9.5px;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--rw-warm-taupe);
  }

  .real-women__fit dd {
    margin: 0;
    font-family: 'Cormorant Garamond', 'Times New Roman', Times, serif;
    font-size: 22px;
    font-weight: 400;
    line-height: 1.2;
    color: var(--rw-noir);
  }

  .real-women__fit dd em {
    font-style: italic;
    font-weight: 300;
  }

  .real-women__author {
    display: block;
    margin-top: 26px;
    font-family: Jost, var(--font-primary--family), system-ui, sans-serif;
    font-size: 11px;
    font-weight: 500;
    font-style: normal;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--rw-warm-taupe);
  }

  .real-women__context {
    display: block;
    margin-top: 8px;
    font-family: Jost, var(--font-primary--family), system-ui, sans-serif;
    font-size: 10.5px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--rw-champagne);
  }

  /* Stories-style segments: the active one fills over the dwell time */
  .real-women__segments {
    display: flex;
    justify-content: center;
    gap: 6px;
    margin-top: 44px;
  }

  .real-women__seg {
    position: relative;
    width: 36px;
    height: 3px;
    padding: 0;
    border: 0;
    border-radius: 3px;
    background-color: var(--rw-track);
    overflow: hidden;
    cursor: pointer;
  }

  /* Larger invisible tap target */
  .real-women__seg::before {
    content: '';
    position: absolute;
    inset: -12px -2px;
  }

  .real-women__seg span {
    position: absolute;
    inset: 0;
    border-radius: 3px;
    background-color: var(--rw-champagne);
    transform: scaleX(0);
    transform-origin: left center;
  }

  .real-women__seg.is-done span {
    transform: scaleX(1);
  }

  /* Without JS (or before it runs) the first segment simply shows as current */
  .real-women__seg.is-active span {
    transform: scaleX(1);
  }

  .real-women.is-rotating .real-women__seg.is-active span {
    animation: real-women-fill var(--rw-dwell, 7000ms) linear forwards;
  }

  .real-women.is-paused .real-women__seg.is-active span {
    animation-play-state: paused;
  }

  .real-women__seg:focus-visible {
    outline: 2px solid var(--rw-champagne);
    outline-offset: 4px;
  }

  @keyframes real-women-fill {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  /* Scroll reveal (class .is-revealed added by JS) */
  .real-women.is-revealed [data-real-women-reveal]:nth-child(1) {
    animation: real-women-ornament-in 0.8s ease forwards;
  }

  .real-women.is-revealed [data-real-women-reveal]:nth-child(2) {
    animation: real-women-fade-in 0.8s ease forwards;
    animation-delay: 0.3s;
  }

  .real-women.is-revealed [data-real-women-reveal]:nth-child(3) {
    animation: real-women-fade-in 0.8s ease forwards;
    animation-delay: 0.6s;
  }

  .real-women.reveal-settled [data-real-women-reveal] {
    animation: none !important;
    opacity: 1 !important;
    transform: none !important;
  }

  @keyframes real-women-ornament-in {
    from {
      opacity: 0;
      transform: scale(0.5);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes real-women-fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .real-women__slide {
      transition: none !important;
    }

    .real-women [data-real-women-reveal] {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }

    .real-women.is-rotating .real-women__seg.is-active span {
      animation: none;
      transform: scaleX(1);
    }
  }
{% endstylesheet %}

<script>
  (() => {
    const root = document.querySelector('[data-real-women]');
    if (!root) return;

    const prefersReducedMotion =
      window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // --- Scroll reveal (defensive: content is visible without it) ---
    const REVEAL_IO_DELAY_MS = 100;
    const REVEAL_FALLBACK_MS = 1000;
    let revealDone = false;
    let revealFallbackTimer = 0;
    let revealIo = null;
    let removeRevealScrollListener = null;

    const finishReveal = (animated) => {
      if (revealDone) return;
      revealDone = true;
      if (revealFallbackTimer) window.clearTimeout(revealFallbackTimer);
      if (revealIo) revealIo.disconnect();
      if (typeof removeRevealScrollListener === 'function') removeRevealScrollListener();
      root.classList.toggle('is-revealed', animated);
      root.classList.toggle('reveal-settled', !animated);
    };

    const isInViewport = (el) => {
      const r = el.getBoundingClientRect();
      const vh = window.innerHeight || document.documentElement.clientHeight;
      return r.bottom > 0 && r.top < vh;
    };

    const startReveal = () => {
      if (prefersReducedMotion || !('IntersectionObserver' in window) || isInViewport(root)) {
        finishReveal(false);
        return;
      }
      revealFallbackTimer = window.setTimeout(() => finishReveal(false), REVEAL_FALLBACK_MS);
      let lastScrollY = window.scrollY || 0;
      const onScroll = () => {
        lastScrollY = window.scrollY || 0;
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      removeRevealScrollListener = () => window.removeEventListener('scroll', onScroll);
      revealIo = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting || entry.intersectionRatio < 0.3) return;
            const scrollingDown = (window.scrollY || 0) >= lastScrollY - 2;
            finishReveal(scrollingDown);
          });
        },
        { threshold: [0, 0.15, 0.3, 0.45, 0.6] }
      );
      revealIo.observe(root);
    };

    window.setTimeout(startReveal, REVEAL_IO_DELAY_MS);

    // --- Rotation: stories-style segments ---
    const stage = root.querySelector('[data-real-women-stage]');
    const slides = Array.from(root.querySelectorAll('[data-real-women-slide]'));
    const segs = Array.from(root.querySelectorAll('[data-real-women-seg]'));
    if (!stage || slides.length < 2 || segs.length !== slides.length) return;

    let current = Math.max(0, slides.findIndex((el) => el.classList.contains('is-active')));
    let inView = false;
    let held = false;
    let hovered = false;

    const updatePaused = () => {
      root.classList.toggle('is-paused', held || hovered || !inView);
    };

    const show = (index) => {
      const next = ((index % slides.length) + slides.length) % slides.length;
      if (next === current) return;

      const leaving = slides[current];
      leaving.classList.remove('is-active');
      leaving.classList.add('is-leaving');
      leaving.setAttribute('aria-hidden', 'true');
      window.setTimeout(() => leaving.classList.remove('is-leaving'), 700);

      current = next;
      slides[current].classList.add('is-active');
      slides[current].removeAttribute('aria-hidden');

      segs.forEach((seg, i) => {
        seg.classList.toggle('is-done', i < current);
        seg.classList.remove('is-active');
        seg.setAttribute('aria-selected', i === current ? 'true' : 'false');
      });
      // Restart the fill animation on the new active segment.
      void segs[current].offsetWidth;
      segs[current].classList.add('is-active');
    };

    // Auto-advance when the active segment finishes filling, so "paused" simply pauses the animation.
    if (!prefersReducedMotion) {
      root.classList.add('is-rotating');
      stage.addEventListener('animationend', (e) => {
        if (!e.target.closest('[data-real-women-seg]')) return;
        show(current + 1);
      });
    }

    segs.forEach((seg, i) => seg.addEventListener('click', () => show(i)));

    // Swipe left/right + press-and-hold to pause (touch-action: pan-y keeps page scroll working).
    let startX = 0;
    let startY = 0;
    let tracking = false;
    let holdTimer = 0;

    stage.addEventListener('pointerdown', (e) => {
      if (e.target.closest('[data-real-women-seg]')) return;
      tracking = true;
      startX = e.clientX;
      startY = e.clientY;
      holdTimer = window.setTimeout(() => {
        held = true;
        updatePaused();
      }, 180);
    });

    const endPointer = (e) => {
      if (!tracking) return;
      tracking = false;
      window.clearTimeout(holdTimer);
      held = false;
      updatePaused();
      const dx = e.clientX - startX;
      const dy = e.clientY - startY;
      if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) show(current + (dx < 0 ? 1 : -1));
    };

    stage.addEventListener('pointerup', endPointer);
    stage.addEventListener('pointercancel', () => {
      tracking = false;
      window.clearTimeout(holdTimer);
      held = false;
      updatePaused();
    });

    if (window.matchMedia('(hover: hover)').matches) {
      stage.addEventListener('mouseenter', () => {
        hovered = true;
        updatePaused();
      });
      stage.addEventListener('mouseleave', () => {
        hovered = false;
        updatePaused();
      });
    }

    // Only run the timer while the section is on screen.
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        (entries) => {
          inView = entries.some((entry) => entry.isIntersecting);
          updatePaused();
        },
        { threshold: 0.25 }
      ).observe(root);
    } else {
      inView = true;
    }
    updatePaused();
  })();
</script>

{% schema %}
{
  "name": "Real women",
  "tag": "section",
  "class": "section-real-women",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow",
      "default": "Worn by women like you"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "I wear it on regular days now. A fitted tee, my favorite jeans, school run, groceries. I just feel put together."
        },
        {
          "type": "text",
          "id": "author_name",
          "label": "Author name",
          "default": "Maya R."
        },
        {
          "type": "text",
          "id": "author_city",
          "label": "Author city",
          "default": "Houston"
        },
        {
          "type": "header",
          "content": "Fit notes"
        },
        {
          "type": "text",
          "id": "usual_size",
          "label": "Usually wears",
          "info": "Her usual size, e.g. M or M / L. Leave empty to hide.",
          "default": "M"
        },
        {
          "type": "text",
          "id": "size_worn",
          "label": "Size she wore",
          "default": "M"
        },
        {
          "type": "text",
          "id": "fit",
          "label": "Fit",
          "info": "Short, in her words, e.g. True to size, Snug, Comfortable.",
          "default": "True to size"
        },
        {
          "type": "header",
          "content": "Product"
        },
        {
          "type": "text",
          "id": "product_name",
          "label": "Product",
          "default": "Contour Bodysuit"
        },
        {
          "type": "text",
          "id": "color",
          "label": "Color",
          "default": "Beige"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Real women",
      "category": "Custom",
      "blocks": [
        {
          "type": "testimonial"
        }
      ]
    }
  ]
}
{% endschema %}
