{% liquid
  assign headline_line_1 = section.settings.headline_line_1
  assign headline_line_2 = section.settings.headline_line_2
  assign subtitle = section.settings.subtitle
  assign button_label = section.settings.button_label
  assign button_link = section.settings.button_link | default: routes.all_products_collection_url
%}

<div class="editorial-cta" data-editorial-cta>
  <div class="editorial-cta-inner">
    <div class="editorial-cta-ornament" aria-hidden="true">
      <span class="editorial-cta-ornament-line"></span>
      <span class="editorial-cta-ornament-dot"></span>
      <span class="editorial-cta-ornament-line"></span>
    </div>

    <h2 class="editorial-cta-headline">
      <span class="editorial-cta-line-1">{{ headline_line_1 }}</span>
      <span class="editorial-cta-line-2">{{ headline_line_2 }}</span>
    </h2>

    <p class="editorial-cta-subtitle">{{ subtitle }}</p>

    <a class="editorial-cta-button" href="{{ button_link }}">{{ button_label }}</a>
  </div>
</div>

<style>
.editorial-cta { width: 100%; box-sizing: border-box; background: #F0E8DF; padding: 100px 20px; text-align: center; }
@media (min-width: 990px) { .editorial-cta { padding: 160px 40px; } }
.editorial-cta-inner { max-width: 720px; margin: 0 auto; box-sizing: border-box; padding: 0 20px; }
@media (min-width: 990px) { .editorial-cta-inner { padding: 0 40px; } }
.editorial-cta-ornament { display: flex; align-items: center; justify-content: center; gap: 4px; margin: 0 auto 40px; opacity: 1; transform: scale(1); transform-origin: center; }
.editorial-cta-ornament-line { width: 24px; height: 1px; background: #C8A96E; flex-shrink: 0; }
.editorial-cta-ornament-dot { width: 4px; height: 4px; border-radius: 50%; background: #C8A96E; flex-shrink: 0; }
.editorial-cta-headline { margin: 0; padding: 0; }
.editorial-cta-line-1, .editorial-cta-line-2 { display: block; font-family: 'Cormorant Garamond', serif; font-weight: 300; font-size: clamp(36px, 5vw, 64px); line-height: 1.2; letter-spacing: 0.01em; opacity: 1; transform: translate3d(0, 0, 0); }
.editorial-cta-line-1 { color: #1A1A1A; }
.editorial-cta-line-2 { font-style: italic; color: #A07060; margin-top: 0.12em; }
.editorial-cta-subtitle { margin: 32px 0 0; font-family: Jost, sans-serif; font-weight: 300; font-size: 14px; letter-spacing: 0.2em; color: #3D2B24; text-transform: uppercase; line-height: 1.6; opacity: 1; }
.editorial-cta-button { display: inline-block; margin-top: 56px; background: #1A1A1A; color: #C8A96E; font-family: Jost, sans-serif; font-size: 11px; font-weight: 500; letter-spacing: 0.3em; text-transform: uppercase; text-decoration: none; padding: 18px 48px; border: none; cursor: pointer; opacity: 1; transform: translate3d(0, 0, 0); transition: all 0.4s ease; }
.editorial-cta-button:hover { background: #C8A96E; color: #1A1A1A; transform: scale(1.02); }
.editorial-cta-button:focus-visible { outline: 2px solid #C8A96E; outline-offset: 4px; }
.editorial-cta.is-visible .editorial-cta-ornament { animation: editorial-cta-ornament-in 0.8s ease both; }
.editorial-cta.is-visible .editorial-cta-line-1 { animation: editorial-cta-rise-30 0.9s ease both; animation-delay: 0.3s; }
.editorial-cta.is-visible .editorial-cta-line-2 { animation: editorial-cta-rise-30 0.9s ease both; animation-delay: 0.5s; }
.editorial-cta.is-visible .editorial-cta-subtitle { animation: editorial-cta-fade-in 0.7s ease both; animation-delay: 0.8s; }
.editorial-cta.is-visible .editorial-cta-button { animation: editorial-cta-rise-20 0.7s ease both; animation-delay: 1.1s; }
@keyframes editorial-cta-ornament-in { from { opacity: 0; transform: scale(0); } to { opacity: 1; transform: scale(1); } }
@keyframes editorial-cta-rise-30 { from { opacity: 0; transform: translate3d(0, 30px, 0); } to { opacity: 1; transform: translate3d(0, 0, 0); } }
@keyframes editorial-cta-fade-in { from { opacity: 0; } to { opacity: 1; } }
@keyframes editorial-cta-rise-20 { from { opacity: 0; transform: translate3d(0, 20px, 0); } to { opacity: 1; transform: translate3d(0, 0, 0); } }
.editorial-cta.reveal-settled .editorial-cta-ornament,
.editorial-cta.reveal-settled .editorial-cta-line-1,
.editorial-cta.reveal-settled .editorial-cta-line-2,
.editorial-cta.reveal-settled .editorial-cta-subtitle,
.editorial-cta.reveal-settled .editorial-cta-button { animation: none !important; opacity: 1 !important; transform: none !important; }
.editorial-cta.reveal-settled .editorial-cta-ornament { transform: scale(1) !important; }
@media (prefers-reduced-motion: reduce) {
  .editorial-cta .editorial-cta-ornament, .editorial-cta .editorial-cta-line-1, .editorial-cta .editorial-cta-line-2, .editorial-cta .editorial-cta-subtitle, .editorial-cta .editorial-cta-button { animation: none !important; opacity: 1 !important; transform: none !important; }
  .editorial-cta .editorial-cta-ornament { transform: scale(1) !important; }
  .editorial-cta .editorial-cta-button { transition: none !important; }
}
</style>

<script>
  (() => {
    const root = document.querySelector('[data-editorial-cta]');
    if (!root) return;

    const REVEAL_FALLBACK_MS = 1000;
    let revealDone = false;
    let fallbackTimer = 0;

    const clearRevealFallback = () => {
      if (fallbackTimer) window.clearTimeout(fallbackTimer);
      fallbackTimer = 0;
    };

    const markRevealed = () => {
      if (revealDone) return;
      revealDone = true;
      clearRevealFallback();
      root.classList.remove('reveal-settled');
      root.classList.add('is-visible');
    };

    fallbackTimer = window.setTimeout(() => {
      if (revealDone) return;
      if (!root.classList.contains('is-visible')) root.classList.add('reveal-settled');
    }, REVEAL_FALLBACK_MS);

    const prefersReducedMotion =
      window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (prefersReducedMotion) {
      markRevealed();
      return;
    }

    if (!('IntersectionObserver' in window)) {
      markRevealed();
      return;
    }

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          if (entry.intersectionRatio < 0.3) return;
          markRevealed();
          io.disconnect();
        });
      },
      { threshold: [0, 0.15, 0.3, 0.45, 0.6, 0.75, 1] }
    );

    io.observe(root);
  })();
</script>

{% schema %}
{
  "name": "Editorial CTA",
  "tag": "section",
  "class": "section-editorial-cta",
  "settings": [
    {
      "type": "text",
      "id": "headline_line_1",
      "label": "Headline line 1",
      "default": "It starts with how"
    },
    {
      "type": "text",
      "id": "headline_line_2",
      "label": "Headline line 2",
      "default": "you feel underneath."
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "The piece begins. The story is yours."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "SHOP THE COLLECTION"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Leave blank to use the All products collection."
    }
  ],
  "presets": [
    {
      "name": "Editorial CTA",
      "category": "Custom"
    }
  ]
}
{% endschema %}
