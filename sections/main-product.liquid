{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured_media = current_variant.featured_media | default: product.featured_media
  assign product_form_id = 'ProductForm-' | append: section.id

  assign compression_label = product.metafields.custom.compression_level | default: 'Medium'
  assign compression_bars = 2
  assign compression_level = compression_label | downcase
  if compression_level contains 'light'
    assign compression_bars = 1
  elsif compression_level contains 'strong' or compression_level contains 'firm' or compression_level contains 'high'
    assign compression_bars = 3
  endif

  assign short_description = product.metafields.custom.short_description
  if short_description == blank and product.description != blank
    assign short_description = product.description | strip_html | truncate: 120
  endif

  assign compression_tip = section.settings.compression_tooltip_medium | default: 'Definition without restriction â€” held, not squeezed.'
  if compression_level contains 'light'
    assign compression_tip = section.settings.compression_tooltip_light | default: 'Sculpting without restriction. Perfect for everyday wear.'
  elsif compression_level contains 'strong'
    assign compression_tip = section.settings.compression_tooltip_strong | default: 'Maximum sculpting for fitted silhouettes and special occasions.'
  endif

  assign crafted_image = product.images[1] | default: product.featured_image

  assign details_metafield = product.metafields.custom.details
  assign fabric_metafield = product.metafields.custom.fabric_care
  assign shipping_metafield = product.metafields.custom.shipping_info

  assign spec_1_label = section.settings.spec_1_label | default: 'COVERAGE'
  assign spec_1_value = product.metafields.custom.coverage | default: section.settings.spec_1_fallback | default: 'Mid'
  assign spec_2_label = section.settings.spec_2_label | default: 'COMPRESSION'
  assign spec_2_value = compression_label
  assign spec_3_label = section.settings.spec_3_label | default: 'FABRIC'
  assign spec_3_value = product.metafields.custom.fabric | default: section.settings.spec_3_fallback | default: 'Premium Nylon-Elastane'
  assign spec_4_label = section.settings.spec_4_label | default: 'ORIGIN'
  assign spec_4_value = product.metafields.custom.origin | default: section.settings.spec_4_fallback | default: 'Designed for everyday wear'

  assign size_guide_url = section.settings.size_guide_url | default: '/pages/size-guide'
%}

<article
  class="zs-product full-width"
  data-zs-product
  data-section-id="{{ section.id }}"
  {{ section.shopify_attributes }}
>
  {% comment %} Zone 1 â€” Hero (gallery + buy box) {% endcomment %}
  <section
    class="zs-product__zone zs-product__zone--hero"
    data-zs-page-pull-up
    data-header-bg="#FAF8F5"
    data-header-text="#1A1A1A"
    data-zs-product-reveal
    aria-label="{{ product.title | escape }}"
  >
    <div class="zs-product__hero-inner">
      <div class="zs-product__gallery" id="Gallery-{{ section.id }}">
        {% if product.media.size > 0 %}
          <div class="zs-product__gallery-desktop">
            {% if product.media.size > 1 %}
              <div class="zs-product__thumbs-col" role="tablist" aria-label="Product images">
                {% for media in product.media %}
                  {% liquid
                    assign thumb_active = false
                    if featured_media and media.id == featured_media.id
                      assign thumb_active = true
                    elsif featured_media == nil and forloop.first
                      assign thumb_active = true
                    endif
                  %}
                  <button
                    type="button"
                    class="zs-product__thumb{% if thumb_active %} is-active{% endif %}"
                    data-zs-gallery-thumb
                    data-media-id="{{ media.id }}"
                    aria-label="View image {{ forloop.index }}"
                    aria-current="{% if thumb_active %}true{% else %}false{% endif %}"
                  >
                    {{
                      media.preview_image
                      | image_url: width: 200
                      | image_tag: loading: 'lazy', sizes: '80px', widths: '80, 160', alt: ''
                    }}
                  </button>
                {% endfor %}
              </div>
            {% endif %}

            <div class="zs-product__main-wrap">
              <div class="zs-product__main" id="MainMedia-{{ section.id }}">
                {% for media in product.media %}
                  {% liquid
                    assign slide_active = false
                    if featured_media and media.id == featured_media.id
                      assign slide_active = true
                    elsif featured_media == nil and forloop.first
                      assign slide_active = true
                    endif
                  %}
                  <div
                    class="zs-product__main-slide{% if slide_active %} is-active{% endif %}"
                    data-zs-gallery-slide
                    data-media-id="{{ media.id }}"
                    data-media-type="{{ media.media_type }}"
                  >
                    {% case media.media_type %}
                      {% when 'image' %}
                        {% assign img_alt = media.alt | default: product.title %}
                        {% if forloop.first %}
                          {{
                            media
                            | image_url: width: 1400
                            | image_tag:
                              loading: 'eager',
                              sizes: '(min-width: 990px) 36vw, 100vw',
                              widths: '375, 550, 750, 1100, 1400',
                              alt: img_alt,
                              class: 'zs-product__main-img'
                          }}
                        {% else %}
                          {{
                            media
                            | image_url: width: 1400
                            | image_tag:
                              loading: 'lazy',
                              sizes: '(min-width: 990px) 36vw, 100vw',
                              widths: '375, 550, 750, 1100, 1400',
                              alt: img_alt,
                              class: 'zs-product__main-img'
                          }}
                        {% endif %}
                      {% when 'video' %}
                        {{ media | video_tag: image_size: '1400x', controls: true, class: 'zs-product__main-video' }}
                      {% when 'external_video' %}
                        {{ media | external_video_tag: image_size: '1400x', class: 'zs-product__main-video' }}
                      {% when 'model' %}
                        <div class="zs-product__main-model">
                          {{ media | model_viewer_tag: image_size: '1400x', reveal: 'interaction', toggleable: true }}
                        </div>
                      {% else %}
                        <div class="zs-product__main-fallback" aria-hidden="true"></div>
                    {% endcase %}
                  </div>
                {% endfor %}
              </div>
            </div>
          </div>

          <div class="zs-product__gallery-mobile">
            <div class="zs-product__carousel" data-zs-gallery-carousel tabindex="0" aria-label="Product images">
              {% for media in product.media %}
                <div
                  class="zs-product__carousel-slide"
                  data-zs-gallery-slide
                  data-media-id="{{ media.id }}"
                >
                  {% if media.media_type == 'image' %}
                    {% if forloop.first %}
                      {{
                        media
                        | image_url: width: 900
                        | image_tag:
                          loading: 'eager',
                          sizes: '100vw',
                          widths: '375, 550, 750, 900',
                          alt: media.alt | default: product.title
                      }}
                    {% else %}
                      {{
                        media
                        | image_url: width: 900
                        | image_tag:
                          loading: 'lazy',
                          sizes: '100vw',
                          widths: '375, 550, 750, 900',
                          alt: media.alt | default: product.title
                      }}
                    {% endif %}
                  {% else %}
                    {{ media.preview_image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '100vw', alt: product.title }}
                  {% endif %}
                </div>
              {% endfor %}
            </div>
            {% if product.media.size > 1 %}
              <div class="zs-product__dots" role="tablist" aria-label="Image navigation">
                {% for media in product.media %}
                  <button
                    type="button"
                    class="zs-product__dot{% if forloop.first %} is-active{% endif %}"
                    data-zs-gallery-dot
                    aria-label="Go to image {{ forloop.index }}"
                    aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
                  ></button>
                {% endfor %}
              </div>
            {% endif %}
          </div>
        {% else %}
          <div class="zs-product__gallery-empty" role="img" aria-label="No product images">
            <span class="zs-product__gallery-empty-text">No images</span>
          </div>
        {% endif %}
      </div>

      <div class="zs-product__info">
        {% if product.type != blank %}
          <p class="zs-product__eyebrow">{{ product.type | upcase }}</p>
        {% endif %}

        <h1 class="zs-product__title">{{ product.title }}</h1>

        <div
          class="zs-product__price"
          id="Price-{{ section.id }}"
          data-money-format="{{ shop.money_format | escape }}"
        >
          {% if current_variant.compare_at_price > current_variant.price %}
            <span class="zs-product__sale-badge">SALE</span>
            <span class="zs-product__price-sale">{{ current_variant.price | money }}</span>
            <span class="zs-product__price-compare">{{ current_variant.compare_at_price | money }}</span>
          {% else %}
            <span class="zs-product__price-current">{{ current_variant.price | money }}</span>
          {% endif %}
        </div>

        {% if short_description != blank %}
          <p class="zs-product__short-desc">{{ short_description }}</p>
        {% endif %}

        <div
          class="zs-product__compression"
          data-zs-compression
          aria-label="Compression level {{ compression_label }}"
        >
          <div class="zs-product__compression-head">
            <span class="zs-product__compression-label">COMPRESSION</span>
            <span class="zs-product__compression-value">{{ compression_label | upcase }}</span>
          </div>
          <span class="zs-product__compression-bars" aria-hidden="true">
            <span class="zs-product__compression-bar{% if compression_bars >= 1 %} is-active{% endif %}"></span>
            <span class="zs-product__compression-bar{% if compression_bars >= 2 %} is-active{% endif %}"></span>
            <span class="zs-product__compression-bar{% if compression_bars >= 3 %} is-active{% endif %}"></span>
          </span>
          <p class="zs-product__compression-tip" data-zs-compression-tip>
            {{ compression_tip }}
          </p>
        </div>

        {% form 'product', product, id: product_form_id, class: 'zs-product__form', data_zs_ajax_cart_form: true %}
          <input type="hidden" name="id" value="{{ current_variant.id }}" id="VariantId-{{ section.id }}">
          <input type="hidden" name="quantity" value="1">

          {% unless product.has_only_default_variant %}
            {% for option in product.options_with_values %}
              {% assign option_name_down = option.name | strip | downcase %}
              {% unless option_name_down == 'color' or option_name_down == 'colour' %}
                {% continue %}
              {% endunless %}
              <fieldset class="zs-product__option zs-product__option--color" data-zs-variant-group>
                <legend class="zs-product__visually-hidden">Color</legend>
                <div class="zs-product__color-label-row">
                  <span class="zs-product__option-prefix">COLOR:</span>
                  <span class="zs-product__option-selected" data-zs-selected-label="color">
                    {{ current_variant.options[forloop.index0] }}
                  </span>
                </div>
                <div
                  class="zs-product__color-silhouettes"
                  role="radiogroup"
                  aria-label="Color"
                  data-zs-color-silhouettes
                >
                  {% for value in option.values %}
                    {% liquid
                      assign option_index = forloop.parentloop.index0
                      assign current_opt = current_variant.options[option_index]
                      assign color_active = false
                      if current_opt == value
                        assign color_active = true
                      endif

                      assign color_hex = ''
                      assign color_sold_out = true
                      for variant in product.variants
                        if variant.options[option_index] == value
                          if variant.metafields.custom.color_hex != blank and color_hex == ''
                            assign color_hex = variant.metafields.custom.color_hex.value | default: variant.metafields.custom.color_hex
                          endif
                          if variant.available
                            assign color_sold_out = false
                          endif
                        endif
                      endfor
                      if color_hex == ''
                        capture color_hex
                          render 'product-color-hex', color_name: value
                        endcapture
                        assign color_hex = color_hex | strip
                      endif
                    %}
                    {% render 'color-silhouette',
                      color: color_hex,
                      name: value,
                      size: 'medium',
                      active: color_active,
                      sold_out: color_sold_out,
                      option_index: option_index,
                      value: value
                    %}
                  {% endfor %}
                </div>
              </fieldset>
            {% endfor %}

            {% for option in product.options_with_values %}
              {% assign option_name_down = option.name | strip | downcase %}
              {% if option_name_down == 'color' or option_name_down == 'colour' %}
                {% continue %}
              {% endif %}
              <fieldset class="zs-product__option zs-product__option--size" data-zs-variant-group>
                <legend class="zs-product__option-legend zs-product__option-legend--size">
                  <span class="zs-product__option-prefix">SIZE:</span>
                  <span class="zs-product__option-selected" data-zs-selected-label="size">
                    {{ current_variant.options[forloop.index0] }}
                  </span>
                  <a class="zs-product__size-guide" href="{{ size_guide_url }}">SIZE GUIDE →</a>
                </legend>
                <div class="zs-product__sizes" role="radiogroup" aria-label="{{ option.name }}">
                  {% for value in option.values %}
                    {% liquid
                      assign option_index = forloop.parentloop.index0
                      assign current_opt = current_variant.options[option_index]
                      assign checked = false
                      if current_opt == value
                        assign checked = true
                      endif
                    %}
                    <button
                      type="button"
                      class="zs-product__size-btn{% if checked %} is-selected{% endif %}"
                      data-zs-variant-btn
                      data-zs-size-btn
                      data-option-index="{{ option_index }}"
                      data-value="{{ value | escape }}"
                      aria-pressed="{% if checked %}true{% else %}false{% endif %}"
                    >
                      {{ value }}
                    </button>
                  {% endfor %}
                </div>
              </fieldset>
            {% endfor %}
          {% endunless %}

          <button
            type="submit"
            name="add"
            class="zs-product__submit"
            data-zs-product-submit
            {% unless current_variant.available %}disabled{% endunless %}
          >
            {% if current_variant.available %}
              ADD TO BAG
            {% else %}
              SOLD OUT
            {% endif %}
          </button>

          {{ form | payment_button }}
        {% endform %}

        <ul class="zs-product__trust" role="list">
          <li class="zs-product__trust-item">
            <span class="zs-product__trust-icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.25" focusable="false">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 0 1-1.125-1.125v-1.5c0-1.036.84-1.875 1.875-1.875h3.75a1.125 1.125 0 0 1 1.125 1.125v3.75m8.25-3.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h3.375c.621 0 1.125.504 1.125 1.125v4.125c0 .621-.504 1.125-1.125 1.125H15.75a1.125 1.125 0 0 1-1.125-1.125v-4.125a1.125 1.125 0 0 1 1.125-1.125Z" />
              </svg>
            </span>
            <span>{{ section.settings.trust_shipping | default: 'Free shipping over $75' }}</span>
          </li>
          <li class="zs-product__trust-sep" aria-hidden="true">Â·</li>
          <li class="zs-product__trust-item">
            <span class="zs-product__trust-icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.25" focusable="false">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 15 3 9m0 0 6-6M3 9h12a6 6 0 0 1 6 6v9" />
              </svg>
            </span>
            <span>{{ section.settings.trust_returns | default: '30-day returns' }}</span>
          </li>
          <li class="zs-product__trust-sep" aria-hidden="true">Â·</li>
          <li class="zs-product__trust-item">
            <span class="zs-product__trust-icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.25" focusable="false">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
              </svg>
            </span>
            <span>{{ section.settings.trust_checkout | default: 'Secure checkout' }}</span>
          </li>
        </ul>

        <div class="zs-product__accordions" data-zs-product-accordion>
          <div class="zs-product__accordion-item" data-zs-product-accordion-item>
            <h2 class="zs-product__accordion-heading">
              <button
                type="button"
                class="zs-product__accordion-trigger"
                data-zs-product-accordion-trigger
                aria-expanded="false"
              >
                <span>DETAILS</span>
                <span class="zs-product__accordion-icon" aria-hidden="true"></span>
              </button>
            </h2>
            <div class="zs-product__accordion-panel" data-zs-product-accordion-panel hidden>
              <div class="zs-product__accordion-body rte">
                {% if details_metafield != blank %}
                  {{ details_metafield | metafield_tag }}
                {% elsif section.settings.details_fallback != blank %}
                  {{ section.settings.details_fallback }}
                {% else %}
                  <p>{{ section.settings.details_empty | default: 'Premium sculpting construction designed for all-day comfort.' }}</p>
                {% endif %}
              </div>
            </div>
          </div>

          <div class="zs-product__accordion-item" data-zs-product-accordion-item>
            <h2 class="zs-product__accordion-heading">
              <button
                type="button"
                class="zs-product__accordion-trigger"
                data-zs-product-accordion-trigger
                aria-expanded="false"
              >
                <span>FABRIC &amp; CARE</span>
                <span class="zs-product__accordion-icon" aria-hidden="true"></span>
              </button>
            </h2>
            <div class="zs-product__accordion-panel" data-zs-product-accordion-panel hidden>
              <div class="zs-product__accordion-body rte">
                {% if fabric_metafield != blank %}
                  {{ fabric_metafield | metafield_tag }}
                {% elsif section.settings.fabric_fallback != blank %}
                  {{ section.settings.fabric_fallback }}
                {% else %}
                  <p>{{ section.settings.fabric_empty | default: 'Hand wash cold. Lay flat to dry. Do not bleach or iron.' }}</p>
                {% endif %}
              </div>
            </div>
          </div>

          <div class="zs-product__accordion-item" data-zs-product-accordion-item>
            <h2 class="zs-product__accordion-heading">
              <button
                type="button"
                class="zs-product__accordion-trigger"
                data-zs-product-accordion-trigger
                aria-expanded="false"
              >
                <span>SHIPPING &amp; RETURNS</span>
                <span class="zs-product__accordion-icon" aria-hidden="true"></span>
              </button>
            </h2>
            <div class="zs-product__accordion-panel" data-zs-product-accordion-panel hidden>
              <div class="zs-product__accordion-body rte">
                {% if shipping_metafield != blank %}
                  {{ shipping_metafield | metafield_tag }}
                {% elsif section.settings.shipping_fallback != blank %}
                  {{ section.settings.shipping_fallback }}
                {% else %}
                  <p>{{ section.settings.shipping_empty | default: 'Orders ship within 1â€“2 business days. Free shipping on orders over $75.' }}</p>
                {% endif %}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {% comment %} Zone 2 â€” Details grid {% endcomment %}
  <section
    class="zs-product__zone zs-product__zone--details"
    data-zs-product-reveal
    data-header-bg="#F0E8DF"
    data-header-text="#1A1A1A"
    aria-labelledby="zs-product-details-heading-{{ section.id }}"
  >
    <div class="zs-product__zone-inner">
      {% if section.settings.details_eyebrow != blank %}
        <p class="zs-product__zone-eyebrow">{{ section.settings.details_eyebrow }}</p>
      {% endif %}
      <h2 id="zs-product-details-heading-{{ section.id }}" class="zs-product__zone-title">
        {{ section.settings.details_title | default: 'Crafted in every detail.' }}
      </h2>
      <div class="zs-product__spec-grid">
        <article class="zs-product__spec-card">
          <h3 class="zs-product__spec-label">{{ spec_1_label }}</h3>
          <p class="zs-product__spec-value">{{ spec_1_value }}</p>
        </article>
        <article class="zs-product__spec-card">
          <h3 class="zs-product__spec-label">{{ spec_2_label }}</h3>
          <p class="zs-product__spec-value">{{ spec_2_value }}</p>
        </article>
        <article class="zs-product__spec-card">
          <h3 class="zs-product__spec-label">{{ spec_3_label }}</h3>
          <p class="zs-product__spec-value">{{ spec_3_value }}</p>
        </article>
        <article class="zs-product__spec-card">
          <h3 class="zs-product__spec-label">{{ spec_4_label }}</h3>
          <p class="zs-product__spec-value">{{ spec_4_value }}</p>
        </article>
      </div>
    </div>
  </section>

  {% comment %} Zone 3 â€” Crafted for {% endcomment %}
  <section
    class="zs-product__zone zs-product__zone--crafted"
    data-zs-product-reveal
    aria-labelledby="zs-product-crafted-heading-{{ section.id }}"
  >
    <div class="zs-product__crafted-grid">
      <div class="zs-product__crafted-media">
        {% if crafted_image %}
          {{
            crafted_image
            | image_url: width: 1200
            | image_tag:
              loading: 'lazy',
              sizes: '(min-width: 990px) 50vw, 100vw',
              widths: '550, 750, 1100, 1200',
              alt: crafted_image.alt | default: product.title,
              class: 'zs-product__crafted-img'
          }}
        {% else %}
          <div class="zs-product__crafted-placeholder" aria-hidden="true"></div>
        {% endif %}
      </div>
      <div class="zs-product__crafted-copy">
        {% if section.settings.crafted_eyebrow != blank %}
          <p class="zs-product__zone-eyebrow">{{ section.settings.crafted_eyebrow }}</p>
        {% endif %}
        <h2 id="zs-product-crafted-heading-{{ section.id }}" class="zs-product__zone-title zs-product__zone-title--serif">
          {{ section.settings.crafted_title | default: 'Worn for every chapter.' }}
        </h2>
        <div class="zs-product__crafted-body rte">
          {{ section.settings.crafted_body | default: '<p>Every seam is placed with intention. Every fabric chosen for breathability and hold. This is shapewear that moves with you â€” not against you.</p>' }}
        </div>
      </div>
    </div>
  </section>

  {% comment %} Zone 4 â€” Reviews {% endcomment %}
  <section
    class="zs-product__zone zs-product__zone--reviews"
    data-zs-product-reveal
    data-header-bg="#F0E8DF"
    data-header-text="#1A1A1A"
    aria-labelledby="zs-product-reviews-heading-{{ section.id }}"
  >
    <div class="zs-product__zone-inner zs-product__zone-inner--narrow">
      {% if section.settings.reviews_eyebrow != blank %}
        <p class="zs-product__zone-eyebrow">{{ section.settings.reviews_eyebrow }}</p>
      {% endif %}
      <h2 id="zs-product-reviews-heading-{{ section.id }}" class="zs-product__zone-title">
        {{ section.settings.reviews_title | default: 'Worn and loved.' }}
      </h2>
      {% comment %}
        Optional Judge.me widget (enable when snippet exists):
        {% render 'judgeme_widgets', widget_type: 'judgeme_review_widget', concierge_install: true, product: product %}
      {% endcomment %}
      <div id="judgeme_product_reviews" class="zs-product__judgeme-placeholder">
        <p class="zs-product__judgeme-note">{{ section.settings.reviews_placeholder | default: 'Reviews powered by Judge.me will appear here.' }}</p>
      </div>
    </div>
  </section>

  {% comment %} Zone 5 â€” Find your fit {% endcomment %}
  <section
    class="zs-product__zone zs-product__zone--fit"
    data-zs-product-reveal
    aria-labelledby="zs-product-fit-heading-{{ section.id }}"
  >
    <div class="zs-product__fit-inner">
      {% if section.settings.fit_eyebrow != blank %}
        <p class="zs-product__zone-eyebrow">{{ section.settings.fit_eyebrow }}</p>
      {% endif %}
      <h2 id="zs-product-fit-heading-{{ section.id }}" class="zs-product__zone-title zs-product__zone-title--center">
        {{ section.settings.fit_title | default: 'Sized for you.' }}
      </h2>
      <p class="zs-product__fit-copy">{{ section.settings.fit_copy | default: 'Use our size guide to match your measurements with the perfect size.' }}</p>
      <a class="zs-product__fit-cta" href="{{ size_guide_url }}">{{ section.settings.fit_cta | default: 'VIEW FULL SIZE GUIDE →' }}</a>
    </div>
  </section>

  {% comment %} Zone 6 â€” Pairs well with {% endcomment %}
  <section
    class="zs-product__zone zs-product__zone--rec is-hidden"
    data-zs-product-zone-rec
    data-zs-product-reveal
    data-header-bg="#F0E8DF"
    data-header-text="#1A1A1A"
    aria-labelledby="zs-product-rec-heading-{{ section.id }}"
  >
    <div class="zs-product__zone-inner">
      {% if section.settings.rec_eyebrow != blank %}
        <p class="zs-product__zone-eyebrow">{{ section.settings.rec_eyebrow }}</p>
      {% endif %}
      <h2 id="zs-product-rec-heading-{{ section.id }}" class="zs-product__zone-title">
        {{ section.settings.rec_title | default: 'Complete the look.' }}
      </h2>
      <product-recommendations
        class="zs-product__rec-host"
        data-zs-product-recommendations
        data-url="{{ routes.product_recommendations_url }}?section_id=zs-product-recommendations&product_id={{ product.id }}&limit=4"
      >
        <p class="zs-product__rec-loading" aria-live="polite">{{ section.settings.rec_loading | default: 'Loading recommendationsâ€¦' }}</p>
      </product-recommendations>
    </div>
  </section>

  {% comment %} Zone 7 â€” Multi-outfit {% endcomment %}
  <section
    class="zs-product__zone zs-product__zone--outfit{% unless section.settings.show_multi_outfit %} is-hidden{% endunless %}"
    data-zs-product-reveal
    aria-labelledby="zs-product-outfit-heading-{{ section.id }}"
    {% unless section.settings.show_multi_outfit %}hidden{% endunless %}
  >
    <div class="zs-product__zone-inner zs-product__zone-inner--narrow">
      {% if section.settings.outfit_eyebrow != blank %}
        <p class="zs-product__zone-eyebrow zs-product__zone-eyebrow--light">{{ section.settings.outfit_eyebrow }}</p>
      {% endif %}
      <h2 id="zs-product-outfit-heading-{{ section.id }}" class="zs-product__zone-title zs-product__zone-title--light">
        {{ section.settings.outfit_title | default: 'Style it your way' }}
      </h2>
      <p class="zs-product__outfit-placeholder">{{ section.settings.outfit_placeholder | default: 'Multi-outfit looks coming soon.' }}</p>
    </div>
  </section>

  {% comment %} Zone 8 â€” FAQ {% endcomment %}
  <section
    class="zs-product__zone zs-product__zone--faq"
    data-zs-product-reveal
    aria-labelledby="zs-product-faq-heading-{{ section.id }}"
  >
    <div class="zs-product__zone-inner zs-product__zone-inner--narrow">
      {% if section.settings.faq_eyebrow != blank %}
        <p class="zs-product__zone-eyebrow">{{ section.settings.faq_eyebrow }}</p>
      {% endif %}
      <h2 id="zs-product-faq-heading-{{ section.id }}" class="zs-product__zone-title">
        {{ section.settings.faq_title | default: 'Want to know more?' }}
      </h2>
      <div class="zs-product__faq-list" data-zs-product-accordion>
        {% for block in section.blocks %}
          {% if block.type == 'faq' %}
            <div class="zs-product__accordion-item" data-zs-product-accordion-item {{ block.shopify_attributes }}>
              <h3 class="zs-product__accordion-heading">
                <button
                  type="button"
                  class="zs-product__accordion-trigger"
                  data-zs-product-accordion-trigger
                  aria-expanded="false"
                >
                  <span>{{ block.settings.question }}</span>
                  <span class="zs-product__accordion-icon" aria-hidden="true"></span>
                </button>
              </h3>
              <div class="zs-product__accordion-panel" data-zs-product-accordion-panel hidden>
                <div class="zs-product__accordion-body rte">{{ block.settings.answer }}</div>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
      <div class="zs-product__faq-cta">
        <p class="zs-product__faq-cta-text">{{ section.settings.faq_cta_text | default: 'Have more questions?' }}</p>
        <a class="zs-product__faq-cta-link" href="{{ section.settings.faq_cta_url | default: '/pages/faq' }}">
          {{ section.settings.faq_cta_label | default: 'VIEW ALL FAQs →' }}
        </a>
      </div>
    </div>
  </section>
</article>

<script type="application/json" id="ProductJson-{{ section.id }}">{{ product | json }}</script>
<script type="application/json" id="ProductSelectedOptions-{{ section.id }}">{{ current_variant.options | json }}</script>
<script src="{{ 'zs-product.js' | asset_url }}" defer></script>

{% stylesheet %}
  .zs-product {
    --zs-ivory: #faf8f5;
    --zs-linen: #f0e8df;
    --zs-noir: #1a1a1a;
    --zs-champagne: #c8a96e;
    --zs-warm-taupe: #a07060;
    --zs-deep-brown: #3d2b24;
    --zs-font-serif: 'Cormorant Garamond', 'Times New Roman', Times, serif;
    --zs-font-sans: Jost, var(--font-primary--family), system-ui, sans-serif;

    width: 100%;
    margin: 0;
    color: var(--zs-noir);
    background-color: var(--zs-ivory);
  }

  body.template-product .zs-product__zone--hero[data-zs-page-pull-up] {
    margin-top: calc(-1 * var(--zs-header-stack));
    padding-top: calc(var(--zs-header-stack) + 16px);
  }

  @media (min-width: 769px) {
    body.template-product .zs-product__zone--hero[data-zs-page-pull-up] {
      padding-top: calc(var(--zs-header-stack) + 24px);
    }
  }

  .zs-product__zone--hero {
    padding-bottom: 60px;
    padding-inline: 16px;
    background-color: var(--zs-ivory);
  }

  @media (min-width: 990px) {
    .zs-product__zone--hero {
      padding-bottom: 80px;
      padding-inline: 40px;
    }
  }

  .zs-product__hero-inner {
    display: flex;
    flex-direction: column;
    gap: 32px;
    width: 100%;
    max-width: 1440px;
    margin-inline: auto;
  }

  @media (min-width: 990px) {
    .zs-product__hero-inner {
      display: grid;
      grid-template-columns: 60fr 40fr;
      gap: 48px;
      align-items: start;
    }
  }

  /* Gallery â€” desktop */
  .zs-product__gallery-desktop {
    display: none;
  }

  @media (min-width: 990px) {
    .zs-product__gallery-desktop {
      display: grid;
      grid-template-columns: 80px 1fr;
      gap: 16px;
      align-items: start;
    }

    .zs-product__gallery-mobile {
      display: none;
    }
  }

  .zs-product__thumbs-col {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-height: min(80vh, 640px);
    overflow-y: auto;
    overflow-x: hidden;
    padding-right: 4px;
    scrollbar-width: thin;
    scrollbar-color: var(--zs-champagne) transparent;
  }

  .zs-product__thumbs-col::-webkit-scrollbar {
    width: 4px;
  }

  .zs-product__thumbs-col::-webkit-scrollbar-thumb {
    background-color: var(--zs-champagne);
    border-radius: 4px;
  }

  .zs-product__thumb {
    width: 80px;
    height: 100px;
    aspect-ratio: 4 / 5;
    padding: 0;
    border: 1px solid rgba(26, 26, 26, 0.12);
    background: var(--zs-ivory);
    cursor: pointer;
    overflow: hidden;
    flex-shrink: 0;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .zs-product__thumb.is-active {
    border-color: var(--zs-noir);
    box-shadow: 0 0 0 1px var(--zs-noir);
  }

  .zs-product__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .zs-product__main-wrap {
    position: sticky;
    top: calc(var(--zs-header-stack) + 24px);
  }

  .zs-product__main {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    background-color: var(--zs-linen);
    overflow: hidden;
  }

  .zs-product__main-slide {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }

  .zs-product__main-slide.is-active {
    opacity: 1;
    z-index: 1;
    pointer-events: auto;
  }

  .zs-product__main-img,
  .zs-product__main-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.45s ease;
  }

  .zs-product__main:hover .zs-product__main-img,
  .zs-product__main:hover .zs-product__main-slide.is-active img {
    transform: scale(1.02);
  }

  .zs-product__main-video,
  .zs-product__main-model {
    width: 100%;
    height: 100%;
  }

  /* Gallery â€” mobile */
  .zs-product__gallery-mobile {
    display: block;
    width: 100%;
  }

  .zs-product__carousel {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    gap: 0;
    aspect-ratio: 4 / 5;
    background: var(--zs-linen);
  }

  .zs-product__carousel::-webkit-scrollbar {
    display: none;
  }

  .zs-product__carousel-slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
    width: 100%;
    height: 100%;
  }

  .zs-product__carousel-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .zs-product__dots {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    margin-top: 16px;
  }

  .zs-product__dot {
    width: 6px;
    height: 6px;
    padding: 0;
    border: none;
    border-radius: 999px;
    background: #d4b5a0;
    cursor: pointer;
    transition: width 0.25s ease, background-color 0.25s ease;
  }

  .zs-product__dot.is-active {
    width: 24px;
    background: var(--zs-noir);
  }

  .zs-product__gallery-empty {
    aspect-ratio: 4 / 5;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--zs-linen);
    font-family: var(--zs-font-sans);
    color: var(--zs-warm-taupe);
  }

  /* Info panel */
  .zs-product__info {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 28rem;
  }

  @media (min-width: 990px) {
    .zs-product__info {
      position: sticky;
      top: calc(var(--zs-header-stack) + 24px);
      max-width: none;
      padding-left: 24px;
      padding-top: 8px;
    }
  }

  .zs-product__eyebrow {
    font-family: var(--zs-font-sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--zs-champagne);
    margin: 0;
  }

  .zs-product__title {
    font-family: var(--zs-font-serif);
    font-weight: 300;
    font-style: italic;
    font-size: clamp(32px, 4vw, 48px);
    line-height: 1.1;
    margin: 8px 0 0;
  }

  .zs-product__price {
    font-family: var(--zs-font-sans);
    font-size: 1.125rem;
    font-weight: 500;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
  }

  .zs-product__sale-badge {
    display: inline-block;
    padding: 4px 10px;
    margin-right: 8px;
    font-family: var(--zs-font-sans);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--zs-noir);
    background: var(--zs-champagne);
    border-radius: 999px;
  }

  .zs-product__price-sale {
    color: #a04040;
  }

  .zs-product__price-compare {
    text-decoration: line-through;
    color: var(--zs-warm-taupe);
    margin-left: 8px;
    font-weight: 300;
    font-size: 18px;
  }

  .zs-product__price-current {
    color: var(--zs-noir);
    font-weight: 300;
    font-size: 18px;
    letter-spacing: 0.05em;
  }

  .zs-product__short-desc {
    font-family: var(--zs-font-serif);
    font-weight: 300;
    font-size: 15px;
    line-height: 1.75;
    color: rgba(26, 26, 26, 0.85);
    margin: 0;
  }

  .zs-product__compression {
    margin-top: 4px;
    padding: 16px;
    border: 1px solid rgba(200, 169, 110, 0.25);
    border-radius: 2px;
  }

  .zs-product__compression-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .zs-product__compression-label {
    font-family: var(--zs-font-sans);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--zs-champagne);
  }

  .zs-product__compression-value {
    font-family: var(--zs-font-sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.15em;
    color: var(--zs-noir);
  }

  .zs-product__compression-bars {
    display: flex;
    gap: 6px;
    margin-top: 12px;
  }

  .zs-product__compression-bar {
    flex: 1;
    height: 4px;
    background: rgba(160, 112, 96, 0.2);
    border-radius: 0;
  }

  .zs-product__compression-bar.is-active {
    background: var(--zs-champagne);
  }

  .zs-product__compression-tip {
    margin: 8px 0 0;
    font-family: var(--zs-font-serif);
    font-style: italic;
    font-weight: 300;
    font-size: 12px;
    line-height: 1.5;
    color: var(--zs-warm-taupe);
  }

  @media (min-width: 769px) {
    .zs-product__compression-tip {
      opacity: 0;
      max-height: 0;
      margin-top: 0;
      overflow: hidden;
      transition: opacity 0.25s ease, max-height 0.25s ease, margin 0.25s ease;
    }

    .zs-product__compression:hover .zs-product__compression-tip {
      opacity: 1;
      max-height: 4rem;
      margin-top: 8px;
    }
  }

  .zs-product__form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .zs-product__option {
    border: none;
    margin: 0;
    padding: 0;
  }

  .zs-product__option-prefix {
    color: var(--zs-warm-taupe);
  }

  .zs-product__option-selected {
    color: var(--zs-noir);
  }

  .zs-product__option-legend--size {
    justify-content: space-between;
  }

  .zs-product__size-guide {
    margin-left: auto;
    font-family: var(--zs-font-sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--zs-champagne);
    text-decoration: none;
    border-bottom: 1px solid var(--zs-champagne);
    padding-bottom: 2px;
  }

  .zs-product__option-legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-family: var(--zs-font-sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 10px;
    width: 100%;
  }

  .zs-product__option-selected {
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0;
    color: var(--zs-warm-taupe);
  }

  .zs-product__size-guide {
    margin-left: auto;
    font-size: 11px;
    letter-spacing: 0.04em;
    text-transform: none;
    color: var(--zs-noir);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--zs-champagne);
  }

  .zs-product__visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .zs-product__color-label-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
    width: 100%;
    font-family: var(--zs-font-sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.25em;
    text-transform: uppercase;
  }

  .zs-product__color-silhouettes {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 8px;
  }

  @media (max-width: 768px) {
    .zs-product__color-silhouettes {
      gap: 16px;
    }
  }

  .zs-color-silhouette {
    background: transparent;
    border: none;
    padding: 0;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    width: 56px;
    transition: opacity 0.3s ease;
  }

  .zs-color-silhouette:focus-visible {
    outline: 2px solid var(--zs-champagne);
    outline-offset: 2px;
    border-radius: 4px;
  }

  .zs-color-silhouette__inner {
    width: 48px;
    height: 80px;
    padding: 4px 6px;
    border: 1px solid transparent;
    border-radius: 4px;
    background: rgba(250, 248, 245, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease, border-color 0.3s ease, background-color 0.3s ease, box-shadow 0.3s ease;
  }

  .zs-color-silhouette__svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .zs-color-silhouette__name {
    font-family: var(--zs-font-serif);
    font-weight: 300;
    font-style: italic;
    font-size: 10px;
    color: var(--zs-warm-taupe);
    text-align: center;
    letter-spacing: 0.02em;
    opacity: 0;
    transition: opacity 0.3s ease, color 0.3s ease;
  }

  @media (max-width: 768px) {
    .zs-color-silhouette__name {
      opacity: 1;
    }
  }

  @keyframes zs-color-silhouette-breathe {
    0% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.05) translateY(-2px);
    }
    100% {
      transform: scale(1.05) translateY(-2px);
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .zs-color-silhouette:not(.is-sold-out):hover .zs-color-silhouette__inner {
      animation: zs-color-silhouette-breathe 0.3s ease forwards;
      border-color: rgba(200, 169, 110, 0.5);
      background: var(--zs-ivory);
    }

    .zs-color-silhouette:not(.is-sold-out):hover .zs-color-silhouette__name {
      opacity: 1;
    }
  }

  .zs-color-silhouette.is-selected .zs-color-silhouette__inner,
  .zs-color-silhouette[aria-pressed='true'] .zs-color-silhouette__inner {
    border: 2px solid var(--zs-champagne);
    background: var(--zs-ivory);
    transform: scale(1.02);
    box-shadow: 0 0 0 1px rgba(200, 169, 110, 0.15);
  }

  .zs-color-silhouette.is-selected .zs-color-silhouette__name,
  .zs-color-silhouette[aria-pressed='true'] .zs-color-silhouette__name {
    opacity: 1;
    color: var(--zs-noir);
    font-weight: 400;
  }

  .zs-color-silhouette.is-sold-out {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .zs-color-silhouette--small .zs-color-silhouette__inner {
    width: 36px;
    height: 60px;
    padding: 3px 5px;
  }

  .zs-color-silhouette--small {
    width: 44px;
  }

  .zs-color-silhouette--large .zs-color-silhouette__inner {
    width: 54px;
    height: 90px;
    padding: 5px 7px;
  }

  .zs-color-silhouette--large {
    width: 62px;
  }

  .zs-product__sizes {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .zs-product__size-btn {
    min-width: 56px;
    height: 44px;
    padding: 0 12px;
    font-family: var(--zs-font-sans);
    font-size: 13px;
    font-weight: 500;
    border: 1px solid var(--zs-noir);
    background: transparent;
    color: var(--zs-noir);
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease, opacity 0.2s ease;
  }

  .zs-product__size-btn.is-selected {
    background: var(--zs-noir);
    color: #fff;
  }

  .zs-product__size-btn.is-sold-out {
    opacity: 0.35;
    text-decoration: line-through;
    cursor: not-allowed;
  }

  .zs-product__submit {
    font-family: var(--zs-font-sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    width: 100%;
    min-height: 52px;
    padding: 20px 24px;
    border: none;
    cursor: pointer;
    background: var(--zs-noir);
    color: var(--zs-champagne);
    transition: background-color 0.4s ease, color 0.4s ease;
  }

  .zs-product__submit:hover:not(:disabled):not(.is-loading):not(.is-success) {
    background: var(--zs-champagne);
    color: var(--zs-noir);
  }

  .zs-product__submit:disabled,
  .zs-product__submit.is-loading {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .zs-product__submit.is-success {
    background: var(--zs-noir);
    color: #fff;
    opacity: 1;
  }

  .zs-product__form .shopify-payment-button {
    width: 100%;
    margin-top: 4px;
  }

  .zs-product__form .shopify-payment-button__button,
  .zs-product__form .shopify-payment-button__button--unbranded {
    font-family: var(--zs-font-sans) !important;
    font-size: 12px !important;
    font-weight: 600 !important;
    letter-spacing: 0.16em !important;
    text-transform: uppercase !important;
    min-height: 52px !important;
    border-radius: 0 !important;
    background: var(--zs-ivory) !important;
    color: var(--zs-noir) !important;
    border: 1px solid var(--zs-noir) !important;
  }

  .zs-product__trust {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    font-family: var(--zs-font-sans);
    font-size: 11px;
    color: rgba(26, 26, 26, 0.75);
  }

  .zs-product__trust-item {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .zs-product__trust-sep {
    color: var(--zs-champagne);
  }

  .zs-product__trust-icon {
    width: 14px;
    height: 14px;
    display: inline-flex;
  }

  .zs-product__trust-icon svg {
    width: 100%;
    height: 100%;
  }

  .zs-product__accordions {
    border-top: 1px solid rgba(26, 26, 26, 0.12);
    margin-top: 8px;
  }

  .zs-product__accordion-item {
    border-bottom: 1px solid rgba(26, 26, 26, 0.12);
  }

  .zs-product__accordion-heading {
    margin: 0;
    font-size: inherit;
    font-weight: inherit;
  }

  .zs-product__accordion-trigger {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 16px 0;
    border: none;
    background: none;
    cursor: pointer;
    font-family: var(--zs-font-sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-align: left;
    color: var(--zs-noir);
  }

  .zs-product__accordion-icon {
    width: 12px;
    height: 12px;
    position: relative;
    flex-shrink: 0;
  }

  .zs-product__accordion-icon::before,
  .zs-product__accordion-icon::after {
    content: '';
    position: absolute;
    background: var(--zs-noir);
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    transition: transform 0.2s ease;
  }

  .zs-product__accordion-icon::before {
    width: 12px;
    height: 1px;
  }

  .zs-product__accordion-icon::after {
    width: 1px;
    height: 12px;
  }

  .zs-product__accordion-item.is-open .zs-product__accordion-icon::after {
    transform: translate(-50%, -50%) scaleY(0);
  }

  .zs-product__accordion-body {
    font-family: var(--zs-font-sans);
    font-size: 14px;
    line-height: 1.75;
    padding-bottom: 16px;
  }

  .zs-product__accordion-body p {
    margin: 0 0 0.75em;
  }

  /* Zone 2 â€” Details */
  .zs-product__zone--details {
    background: var(--zs-linen);
    padding-block: 60px;
    padding-inline: 16px;
  }

  @media (min-width: 990px) {
    .zs-product__zone--details {
      padding-block: 80px;
      padding-inline: 40px;
    }
  }

  .zs-product__zone-inner {
    max-width: 1200px;
    margin-inline: auto;
  }

  .zs-product__zone-inner--narrow {
    max-width: 800px;
    margin-inline: auto;
    text-align: center;
  }

  .zs-product__zone-eyebrow {
    font-family: var(--zs-font-sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--zs-warm-taupe);
    margin: 0 0 12px;
  }

  .zs-product__zone-eyebrow--light {
    color: var(--zs-champagne);
  }

  .zs-product__zone-title {
    font-family: var(--zs-font-serif);
    font-weight: 300;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    line-height: 1.15;
    margin: 0 0 32px;
  }

  .zs-product__zone-title--serif {
    margin-bottom: 20px;
  }

  .zs-product__zone-title--center {
    text-align: center;
  }

  .zs-product__zone-title--light {
    color: var(--zs-ivory);
  }

  .zs-product__spec-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  @media (min-width: 600px) {
    .zs-product__spec-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 990px) {
    .zs-product__spec-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 24px;
    }
  }

  .zs-product__spec-card {
    background: var(--zs-ivory);
    padding: 24px 20px;
    border: 1px solid rgba(26, 26, 26, 0.06);
  }

  .zs-product__spec-label {
    font-family: var(--zs-font-sans);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--zs-warm-taupe);
    margin: 0 0 8px;
  }

  .zs-product__spec-value {
    font-family: var(--zs-font-serif);
    font-size: 1.25rem;
    font-weight: 400;
    line-height: 1.3;
    margin: 0;
  }

  /* Zone 3 â€” Crafted */
  .zs-product__zone--crafted {
    background: var(--zs-ivory);
    padding-block: 60px;
    padding-inline: 16px;
  }

  @media (min-width: 990px) {
    .zs-product__zone--crafted {
      padding-block: 100px;
      padding-inline: 40px;
    }
  }

  .zs-product__crafted-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    max-width: 1200px;
    margin-inline: auto;
    align-items: center;
  }

  @media (min-width: 990px) {
    .zs-product__crafted-grid {
      grid-template-columns: 1fr 1fr;
      gap: 64px;
    }
  }

  .zs-product__crafted-img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    display: block;
  }

  .zs-product__crafted-placeholder {
    aspect-ratio: 4 / 5;
    background: var(--zs-linen);
  }

  .zs-product__crafted-body {
    font-family: var(--zs-font-sans);
    font-size: 15px;
    line-height: 1.8;
  }

  /* Zone 4 â€” Reviews */
  .zs-product__zone--reviews {
    background: var(--zs-linen);
    padding-block: 60px;
    padding-inline: 16px;
  }

  @media (min-width: 990px) {
    .zs-product__zone--reviews {
      padding-block: 80px;
      padding-inline: 40px;
    }
  }

  .zs-product__judgeme-placeholder {
    min-height: 120px;
    padding: 24px;
    border: 1px dashed rgba(26, 26, 26, 0.15);
    background: rgba(250, 248, 245, 0.5);
  }

  .zs-product__judgeme-note {
    font-family: var(--zs-font-sans);
    font-size: 14px;
    color: var(--zs-warm-taupe);
    margin: 0;
  }

  /* Zone 5 â€” Fit */
  .zs-product__zone--fit {
    background: var(--zs-ivory);
    padding-block: 60px;
    padding-inline: 16px;
    text-align: center;
  }

  @media (min-width: 990px) {
    .zs-product__zone--fit {
      padding-block: 80px;
    }
  }

  .zs-product__fit-inner {
    max-width: 520px;
    margin-inline: auto;
  }

  .zs-product__fit-copy {
    font-family: var(--zs-font-sans);
    font-size: 15px;
    line-height: 1.75;
    margin: 0 0 24px;
    color: rgba(26, 26, 26, 0.85);
  }

  .zs-product__fit-cta {
    display: inline-block;
    font-family: var(--zs-font-sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 14px 32px;
    border: 1px solid var(--zs-noir);
    color: var(--zs-noir);
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .zs-product__fit-cta:hover {
    background: var(--zs-noir);
    color: #fff;
  }

  /* Zone 6 â€” Recommendations */
  .zs-product__zone--rec {
    background: var(--zs-ivory);
    padding-block: 60px;
    padding-inline: 16px;
  }

  @media (min-width: 990px) {
    .zs-product__zone--rec {
      padding-block: 80px;
      padding-inline: 40px;
    }
  }

  .zs-product__zone--rec.is-hidden {
    display: none;
  }

  .zs-product__rec-host {
    display: block;
    min-height: 48px;
  }

  .zs-product__rec-loading {
    font-family: var(--zs-font-sans);
    font-size: 14px;
    color: var(--zs-warm-taupe);
    text-align: center;
    margin: 0;
  }

  .zs-product :is(.zs-product__rec-grid) {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  @media (min-width: 990px) {
    .zs-product :is(.zs-product__rec-grid) {
      grid-template-columns: repeat(4, 1fr);
      gap: 24px;
    }
  }

  .zs-product :is(.zs-product__rec-card) {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .zs-product :is(.zs-product__rec-media) {
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--zs-linen);
  }

  .zs-product :is(.zs-product__rec-media img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }

  .zs-product :is(.zs-product__rec-card:hover .zs-product__rec-media img) {
    transform: scale(1.02);
  }

  .zs-product :is(.zs-product__rec-title) {
    font-family: var(--zs-font-serif);
    font-size: 1.125rem;
    color: var(--zs-noir);
    text-decoration: none;
  }

  .zs-product :is(.zs-product__rec-price) {
    font-family: var(--zs-font-sans);
    font-size: 14px;
    margin: 0;
  }

  /* Zone 7 â€” Multi-outfit */
  .zs-product__zone--outfit {
    background: var(--zs-noir);
    color: var(--zs-ivory);
    padding-block: 60px;
    padding-inline: 16px;
    text-align: center;
  }

  .zs-product__zone--outfit.is-hidden,
  .zs-product__zone--outfit[hidden] {
    display: none;
  }

  .zs-product__outfit-placeholder {
    font-family: var(--zs-font-sans);
    font-size: 15px;
    line-height: 1.7;
    color: rgba(250, 248, 245, 0.75);
    margin: 0;
  }

  /* Zone 8 â€” FAQ */
  .zs-product__zone--faq {
    background: var(--zs-ivory);
    padding-block: 60px;
    padding-inline: 16px;
  }

  @media (min-width: 990px) {
    .zs-product__zone--faq {
      padding-block: 80px;
      padding-inline: 40px;
    }
  }

  .zs-product__faq-list {
    text-align: left;
    border-top: 1px solid rgba(26, 26, 26, 0.12);
  }

  .zs-product__zone--faq .zs-product__zone-inner--narrow {
    text-align: center;
  }

  .zs-product__zone--faq .zs-product__zone-title {
    text-align: center;
  }

  .zs-product__zone-line {
    display: block;
    width: 32px;
    height: 1px;
    margin: 0 auto 24px;
    background: var(--zs-champagne);
  }

  .zs-product__faq-cta {
    margin-top: 40px;
    text-align: center;
  }

  .zs-product__faq-cta-text {
    margin: 0 0 12px;
    font-family: var(--zs-font-serif);
    font-style: italic;
    font-weight: 300;
    font-size: 16px;
    color: var(--zs-warm-taupe);
  }

  .zs-product__faq-cta-link {
    display: inline-block;
    font-family: var(--zs-font-sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--zs-champagne);
    text-decoration: none;
    border-bottom: 1px solid var(--zs-champagne);
    padding-bottom: 4px;
  }

  /* Reveal */
  .zs-product [data-zs-product-reveal] {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  .zs-product [data-zs-product-reveal].is-visible {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .zs-product [data-zs-product-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  .zs-product.is-hidden {
    display: none !important;
  }
{% endstylesheet %}

