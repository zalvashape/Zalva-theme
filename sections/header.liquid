  .zs-search-dropdown__result-row:focus-visible {
    outline: 2px solid var(--zs-sd-champagne);
    outline-offset: 2px;
  }

  .zs-search-dropdown__result-thumb {
    flex-shrink: 0;
    width: 60px;
    height: 80px;
    border-radius: 2px;
    overflow: hidden;
    background-color: rgba(26, 26, 26, 0.06);
  }

  .zs-search-dropdown__result-thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: opacity 0.3s ease;
  }

  .zs-search-dropdown__result-row:hover .zs-search-dropdown__result-thumb img {
    opacity: 0.85;
  }

  .zs-search-dropdown__result-meta {
    margin-left: 16px;
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .zs-search-dropdown__result-name {
    margin: 0;
    font-family: 'Cormorant Garamond', 'Times New Roman', Times, serif;
    font-weight: 300;
    font-size: 16px;
    line-height: 1.3;
    color: inherit;
  }

  .zs-search-dropdown__result-price {
    margin: 4px 0 0;
    font-family: Jost, var(--font-primary--family), system-ui, sans-serif;
    font-size: 12px;
    font-weight: 300;
    letter-spacing: 0.05em;
    color: var(--zs-sd-taupe);
  }

  .zs-search-dropdown__noresults-wrap[hidden] {
    display: none !important;
  }

  .zs-search-dropdown__noresults-empty {
    margin: 0;
    font-family: 'Cormorant Garamond', 'Times New Roman', Times, serif;
    font-weight: 300;
    font-size: 14px;
    font-style: italic;
    line-height: 1.4;
    color: inherit;
    opacity: 0.5;
  }

  .zs-search-dropdown__noresults-hint {
    margin: 8px 0 0;
    font-family: Jost, var(--font-primary--family), system-ui, sans-serif;
    font-size: 11px;
    font-weight: 400;
    color: var(--zs-sd-taupe);
  }

  .zs-search-dropdown__view-all {
    display: inline-block;
    width: fit-content;
    max-width: 100%;
    margin: 20px 0 0;
    font-family: Jost, var(--font-primary--family), system-ui, sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--zs-sd-champagne);
    padding: 0;
    transition:
      color 0.25s ease,
      text-decoration-color 0.25s ease;
  }

  .zs-search-dropdown__view-all:hover {
    text-decoration: underline;
    text-decoration-color: var(--zs-sd-champagne);
    text-underline-offset: 3px;
  }

  .zs-search-dropdown__view-all:focus-visible {
    outline: 2px solid var(--zs-sd-champagne);
    outline-offset: 4px;
  }

  .zs-search-dropdown__view-all[hidden] {
    display: none !important;
  }

  .zs-search-dropdown__visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .zs-header__overlay {
    position: fixed;
    inset: 0;
    z-index: 150;
    background-color: rgba(26, 26, 26, 0.5);
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 0.5s ease,
      visibility 0.5s ease;
  }

  .zs-header__overlay.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .zs-header__overlay[hidden] {
    display: block;
  }

  /* ——— The Cabinet mega menu ——— */
  .zs-cabinet-menu {
    --cabinet-ivory: #faf8f5;
    --cabinet-noir: #1a1a1a;
    --cabinet-champagne: #c8a96e;
    --cabinet-taupe: #a07060;
    --cabinet-editorial: #3d2b24;

    position: fixed;
    top: 0;
    left: 0;
    z-index: 200;
    width: min(60vw, 1100px);
    height: 100vh;
    height: 100dvh;
    max-height: 100vh;
    max-height: 100dvh;
    background-color: var(--cabinet-ivory);
    color: var(--cabinet-noir);
    box-sizing: border-box;
    overflow-x: hidden;
    overflow-y: auto;
    overscroll-behavior-y: contain;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: var(--cabinet-champagne) rgba(200, 169, 110, 0.15);
    transform: translateX(-100%);
    will-change: transform;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: none;
  }

  .zs-cabinet-menu.is-active {
    transform: translateX(0);
    pointer-events: auto;
  }

  .zs-cabinet-menu:not(.is-active) {
    pointer-events: none;
  }

  .zs-cabinet-menu[hidden] {
    display: block;
  }

  .zs-cabinet-menu::-webkit-scrollbar {
    width: 2px;
  }

  .zs-cabinet-menu::-webkit-scrollbar-track {
    background: rgba(200, 169, 110, 0.15);
  }

  .zs-cabinet-menu::-webkit-scrollbar-thumb {
    background: var(--cabinet-champagne);
    border-radius: 0;
  }

  @media (max-width: 768px) {
    .zs-cabinet-menu {
      width: 100vw;
    }
  }

  .zs-cabinet-menu__close {
    position: absolute;
    top: 32px;
    right: 32px;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
    color: var(--cabinet-noir);
    cursor: pointer;
    transition:
      color 0.3s ease,
      transform 0.35s ease;
  }

  .zs-cabinet-menu__close:hover {
    color: var(--cabinet-champagne);
    transform: rotate(90deg);
  }

  .zs-cabinet-menu__close:focus-visible {
    outline: 2px solid var(--cabinet-champagne);
    outline-offset: 4px;
  }

  @media (max-width: 768px) {
    .zs-cabinet-menu__close--desktop {
      display: none;
    }
  }

  .zs-cabinet-menu__mobile {
    display: none;
    width: 100%;
    box-sizing: border-box;
  }

  @media (max-width: 768px) {
    .zs-cabinet-menu__mobile {
      display: block;
    }
  }

  @media (min-width: 769px) {
    .zs-cabinet-menu__mobile {
      display: none !important;
    }
  }

  .zs-cabinet-menu__m-topbar {
    position: sticky;
    top: 0;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 60px;
    padding-inline: 20px;
    box-sizing: border-box;
    background-color: var(--cabinet-ivory);
    border-bottom: 1px solid rgba(200, 169, 110, 0.2);
    opacity: 0;
    will-change: opacity;
  }

  .zs-cabinet-menu.is-active .zs-cabinet-menu__m-topbar {
    animation: zs-cabinet-m-topbar-in 0.4s ease forwards;
  }

  .zs-cabinet-menu:not(.is-active) .zs-cabinet-menu__m-topbar {
    animation: none;
    opacity: 0;
  }

  .zs-cabinet-menu:not(.is-active) .zs-cabinet-menu__m-secondary {
    animation: none;
    opacity: 0;
    transform: translateY(12px);
  }

  .zs-cabinet-menu:not(.is-active) .zs-cabinet-menu__m-footer {
    animation: none;
    opacity: 0;
    transform: translateY(10px);
  }

  .zs-cabinet-menu:not(.is-active) .zs-cabinet-menu__m-editors {
    animation: none;
    opacity: 0;
    transform: scale(0.98);
  }

  @keyframes zs-cabinet-m-topbar-in {
    to {
      opacity: 1;
    }
  }

  .zs-cabinet-menu__m-logo {
    font-family: 'Cormorant Garamond', 'Times New Roman', Times, serif;
    font-weight: 300;
    font-size: 16px;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: var(--cabinet-noir);
  }

  .zs-cabinet-menu__m-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin: 0;
    margin-right: -8px;
    padding: 0;
    border: none;
    background: transparent;
    color: var(--cabinet-noir);
    cursor: pointer;
    transition: color 0.3s ease;
  }

  .zs-cabinet-menu__m-close:hover {
    color: var(--cabinet-champagne);
  }

  .zs-cabinet-menu__m-close:focus-visible {
    outline: 2px solid var(--cabinet-champagne);
    outline-offset: 2px;
  }

  .zs-cabinet-menu__m-scroll {
    padding-bottom: 48px;
    box-sizing: border-box;
  }

  .zs-cabinet-menu__m-cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
    padding: 24px 16px 0;
    box-sizing: border-box;
  }

  .zs-cabinet-menu__m-row-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .zs-cabinet-menu__m-card {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 4px;
    text-decoration: none;
    color: inherit;
    box-sizing: border-box;
    opacity: 0;
    transform: translateY(20px);
    will-change: opacity, transform;
  }

  .zs-cabinet-menu:not(.is-active) .zs-cabinet-menu__m-card--stagger {
    animation: none;
    opacity: 0;
    transform: translateY(20px);
  }

  .zs-cabinet-menu.is-active .zs-cabinet-menu__m-card--stagger {
    animation: zs-cabinet-m-card-in 0.5s ease forwards;
    animation-delay: calc(0.1s + var(--cabinet-m-i, 0) * 0.08s);
  }

  @keyframes zs-cabinet-m-card-in {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .zs-cabinet-menu__m-card--hero {
    aspect-ratio: 3 / 2;
  }

  .zs-cabinet-menu__m-card--narrow {
    aspect-ratio: 4 / 5;
  }

  .zs-cabinet-menu__m-card-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    transition: transform 0.5s ease;
  }

  .zs-cabinet-menu__m-card:active .zs-cabinet-menu__m-card-bg {
    transform: scale(1.02);
  }

  .zs-cabinet-menu__m-card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(26, 26, 26, 0.5) 0%, transparent 55%);
    pointer-events: none;
  }

  .zs-cabinet-menu__m-card-label {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 24px;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    pointer-events: none;
  }

  .zs-cabinet-menu__m-card-title {
    font-family: 'Cormorant Garamond', 'Times New Roman', Times, serif;
    font-weight: 300;
    font-size: 32px;
    line-height: 1.1;
    letter-spacing: 0.02em;
    color: var(--cabinet-ivory);
    text-transform: none;
  }

  .zs-cabinet-menu__m-card-title--sm {
    font-size: clamp(22px, 5vw, 28px);
  }

  .zs-cabinet-menu__m-card-caption {
    margin-top: 6px;
    font-family: Jost, var(--font-primary--family), system-ui, sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--cabinet-champagne);
  }

  .zs-cabinet-menu__m-card-caption--sm {
    margin-top: 4px;
    font-size: 10px;
    letter-spacing: 0.2em;
  }

  .zs-cabinet-menu__m-card--shopall {
    background-color: #f0e8df;
  }

  .zs-cabinet-menu__m-card--shopall .zs-cabinet-menu__m-card-bg,
  .zs-cabinet-menu__m-card--shopall .zs-cabinet-menu__m-card-overlay {
    display: none;
  }

  .zs-cabinet-menu__m-shopall-inner {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 16px;
    text-align: center;
    box-sizing: border-box;
  }

  .zs-cabinet-menu__m-shopall-icon {
    color: var(--cabinet-champagne);
    margin-bottom: 8px;
  }

  .zs-cabinet-menu__m-card-title:not(.zs-cabinet-menu__m-card-title--shop) {
    text-transform: uppercase;
  }

  .zs-cabinet-menu__m-card-title--shop {
    font-size: 24px;
    color: var(--cabinet-noir);
  }

  .zs-cabinet-menu__m-card-caption--shop {
    margin-top: 8px;
    color: var(--cabinet-taupe);
  }

  .zs-cabinet-menu__m-secondary {
    margin-top: 40px;
    padding-inline: 24px;
    opacity: 0;
    transform: translateY(12px);
  }

  .zs-cabinet-menu.is-active .zs-cabinet-menu__m-secondary {
    animation: zs-cabinet-m-fade-up 0.45s ease 0.42s forwards;
  }

  @keyframes zs-cabinet-m-fade-up {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .zs-cabinet-menu__m-secondary-rule {
    display: block;
    width: 32px;
    height: 1px;
    margin-bottom: 24px;
    background-color: var(--cabinet-champagne);
  }

  .zs-cabinet-menu__m-secondary-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .zs-cabinet-menu__m-secondary-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 12px;
    margin-inline: -12px;
    border-radius: 2px;
    font-family: 'Cormorant Garamond', 'Times New Roman', Times, serif;
    font-weight: 300;
    font-size: 18px;
    color: var(--cabinet-noir);
    text-decoration: none;
    transition: background-color 0.2s ease;
  }

  .zs-cabinet-menu__m-secondary-link:active {
    background-color: rgba(200, 169, 110, 0.05);
  }

  .zs-cabinet-menu__m-secondary-arrow {
    font-family: Jost, var(--font-primary--family), system-ui, sans-serif;
    color: var(--cabinet-champagne);
    opacity: 0.5;
    font-size: 14px;
  }

  .zs-cabinet-menu__m-secondary-link:focus-visible {
    outline: 2px solid var(--cabinet-champagne);
    outline-offset: 2px;
  }

  .zs-cabinet-menu__m-editors {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 48px;
    margin-inline: 16px;
    padding: 16px;
    background-color: #f0e8df;
    border-radius: 4px;
    text-decoration: none;
    color: inherit;
    box-sizing: border-box;
    opacity: 0;
    transform: scale(0.98);
    will-change: opacity, transform;
  }

  .zs-cabinet-menu.is-active .zs-cabinet-menu__m-editors {
    animation: zs-cabinet-m-editors-in 0.55s cubic-bezier(0.4, 0, 0.2, 1) 0.5s forwards;
  }

  @keyframes zs-cabinet-m-editors-in {
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .zs-cabinet-menu__m-editors-imgwrap {
    flex-shrink: 0;
    width: 80px;
    height: 100px;
    border-radius: 2px;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: rgba(26, 26, 26, 0.06);
  }

  .zs-cabinet-menu__m-editors-imgwrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .zs-cabinet-menu__m-editors-copy {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .zs-cabinet-menu__m-editors-eyebrow {
    font-family: Jost, var(--font-primary--family), system-ui, sans-serif;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--cabinet-champagne);
  }

  .zs-cabinet-menu__m-editors-name {
    font-family: 'Cormorant Garamond', 'Times New Roman', Times, serif;
    font-weight: 300;
    font-size: 18px;
    color: var(--cabinet-noir);
  }

  .zs-cabinet-menu__m-editors-cta {
    font-family: Jost, var(--font-primary--family), system-ui, sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--cabinet-noir);
  }

  .zs-cabinet-menu__m-footer {
    margin-top: 48px;
    padding: 32px 24px 56px;
    text-align: center;
    opacity: 0;
    transform: translateY(10px);
  }

  .zs-cabinet-menu.is-active .zs-cabinet-menu__m-footer {
    animation: zs-cabinet-m-fade-up 0.5s ease 0.55s forwards;
  }

  .zs-cabinet-menu__m-tagline {
    min-height: 1.5em;
  }

  .zs-cabinet-menu__m-tagline-line {
    margin: 0;
    font-family: 'Cormorant Garamond', 'Times New Roman', Times, serif;
    font-weight: 300;
    font-style: italic;
    font-size: 16px;
    line-height: 1.45;
    color: var(--cabinet-taupe);
    text-align: center;
    transition: opacity 0.6s ease;
  }

  .zs-cabinet-menu__m-tagline-line:not(.is-visible) {
    opacity: 0;
  }

  .zs-cabinet-menu__m-tagline-line.is-visible {
    opacity: 1;
  }

  .zs-cabinet-menu__m-social {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 24px;
    margin-top: 24px;
  }

  .zs-cabinet-menu__m-social-link {
    display: flex;
    color: var(--cabinet-noir);
    transition: color 0.3s ease;
  }

  .zs-cabinet-menu__m-social-link:hover {
    color: var(--cabinet-champagne);
  }

  .zs-cabinet-menu__m-social-link:focus-visible {
    outline: 2px solid var(--cabinet-champagne);
    outline-offset: 4px;
  }

  .zs-cabinet-menu__grid {
    display: grid;
    grid-template-columns: 40% 60%;
    min-height: 100%;
    height: auto;
    box-sizing: border-box;
  }

  @media (max-width: 768px) {
    .zs-cabinet-menu__grid {
      display: none;
    }
  }

  .zs-cabinet-menu__left {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: 48px;
    padding: 100px 0 60px 80px;
    min-height: min(100%, 100dvh);
    box-sizing: border-box;
  }

  @media (max-width: 768px) {
    .zs-cabinet-menu__left {
      padding: 80px 40px 60px 40px;
      min-height: min-content;
    }
  }

  .zs-cabinet-menu__nav {
    flex: 0 0 auto;
    min-width: 0;
  }

  .zs-cabinet-menu__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .zs-cabinet-menu__item--divider {
    margin: 0;
    pointer-events: none;
  }

  .zs-cabinet-menu__rule {
    display: block;
    width: 32px;
    height: 1px;
    margin-block: 0;
    background-color: var(--cabinet-champagne);
  }

  .zs-cabinet-menu__link {
    display: inline-block;
    font-family: 'Cormorant Garamond', 'Times New Roman', Times, serif;
    font-weight: 300;
    font-size: clamp(28px, 3vw, 42px);
    letter-spacing: 0.01em;
    color: var(--cabinet-noir);
    text-decoration: none;
    padding: 6px 0;
    cursor: pointer;
    transition:
      color 0.3s ease,
      transform 0.3s ease;
  }

  @media (max-width: 768px) {
    .zs-cabinet-menu__link {
      font-size: clamp(24px, 6vw, 32px);
    }
  }

  @media (min-width: 769px) {
    .zs-cabinet-menu__link:hover {
      color: var(--cabinet-taupe);
      transform: translateX(8px);
    }
  }

  .zs-cabinet-menu__link:focus-visible {
    outline: 2px solid var(--cabinet-champagne);
    outline-offset: 4px;
  }

  .zs-cabinet-menu__link--thumb-wrap {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 16px;
  }

  .zs-cabinet-menu__thumb {
    flex-shrink: 0;
    display: none;
    width: 40px;
    height: 52px;
    border-radius: 2px;
    overflow: hidden;
    background: rgba(26, 26, 26, 0.06);
  }

  .zs-cabinet-menu__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  @media (max-width: 768px) {
    .zs-cabinet-menu__thumb {
      display: block;
    }
  }

  @media (min-width: 769px) {
    .zs-cabinet-menu__link--thumb-wrap {
      display: inline-block;
    }
  }

  .zs-cabinet-menu:not(.is-active) .zs-cabinet-menu__item--stagger {
    animation: none;
    opacity: 0;
    transform: translateX(-12px);
  }

  .zs-cabinet-menu.is-active .zs-cabinet-menu__item--stagger {
    animation: zs-cabinet-stagger 0.55s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    animation-delay: calc(0.08s + var(--cabinet-i, 0) * 0.05s);
    will-change: opacity, transform;
  }

  @keyframes zs-cabinet-stagger {
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .zs-cabinet-menu__bottom {
    flex-shrink: 0;
    padding-top: 32px;
    min-width: 0;
  }

  .zs-cabinet-menu__editors-label {
    margin: 0 0 16px;
    font-family: Jost, var(--font-primary--family), system-ui, sans-serif;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--cabinet-champagne);
  }

  .zs-cabinet-menu__editors-card {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 16px;
    max-width: 320px;
    text-decoration: none;
    color: inherit;
    transition: opacity 0.3s ease;
  }

  .zs-cabinet-menu__editors-card:hover {
    opacity: 0.88;
  }

  .zs-cabinet-menu__editors-media {
    flex-shrink: 0;
    width: 60px;
    height: 80px;
    border-radius: 2px;
    overflow: hidden;
    background: rgba(26, 26, 26, 0.06);
  }

  .zs-cabinet-menu__editors-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .zs-cabinet-menu__editors-meta {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }

  .zs-cabinet-menu__editors-name {
    font-family: 'Cormorant Garamond', 'Times New Roman', Times, serif;
    font-weight: 300;
    font-size: 16px;
    line-height: 1.3;
    color: var(--cabinet-noir);
  }

  .zs-cabinet-menu__editors-cta {
    font-family: Jost, var(--font-primary--family), system-ui, sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    color: var(--cabinet-champagne);
  }

  .zs-cabinet-menu__tagline-rotator {
    position: relative;
    margin-top: 32px;
    min-height: 1.6em;
  }

  .zs-cabinet-menu__tagline-line {
    margin: 0;
    font-family: 'Cormorant Garamond', 'Times New Roman', Times, serif;
    font-weight: 300;
    font-style: italic;
    font-size: 18px;
    line-height: 1.45;
    color: var(--cabinet-editorial);
    transition: opacity 0.6s ease;
  }

  .zs-cabinet-menu__tagline-line:not(.is-visible) {
    opacity: 0;
  }

  .zs-cabinet-menu__tagline-line.is-visible {
    opacity: 1;
  }

  .zs-cabinet-menu__social {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 20px;
    margin-top: 32px;
  }

  .zs-cabinet-menu__social-link {
    display: flex;
    color: var(--cabinet-noir);
    transition: color 0.3s ease;
  }

  .zs-cabinet-menu__social-link:hover {
    color: var(--cabinet-champagne);
  }

  .zs-cabinet-menu__social-link:focus-visible {
    outline: 2px solid var(--cabinet-champagne);
    outline-offset: 4px;
  }

  .zs-cabinet-menu__right {
    position: relative;
    display: block;
    overflow: hidden;
    min-height: 0;
    background: #1a1a1a;
  }

  @media (max-width: 768px) {
    .zs-cabinet-menu__right {
      display: none;
    }
  }

  .zs-cabinet-menu__preview-visual {
    position: absolute;
    inset: 0;
    will-change: contents;
  }

  .zs-cabinet-menu__preview-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0;
    transition: opacity 0.6s ease;
    transform: scale(1.03);
    will-change: opacity, transform;
  }

  .zs-cabinet-menu__preview-img.is-active {
    opacity: 1;
    transform: scale(1);
  }

  .zs-cabinet-menu--intro .zs-cabinet-menu__preview-img.is-active {
    animation: zs-cabinet-preview-in 0.8s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  @keyframes zs-cabinet-preview-in {
    from {
      opacity: 0;
      transform: scale(1.03);
    }

    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .zs-cabinet-menu__preview-gradient {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(to top, rgba(26, 26, 26, 0.6) 0%, transparent 55%);
    pointer-events: none;
  }

  .zs-cabinet-menu__preview-copy {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    padding: 60px;
    pointer-events: none;
  }

  .zs-cabinet-menu__preview-eyebrow {
    margin: 0 0 10px;
    font-family: Jost, var(--font-primary--family), system-ui, sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--cabinet-champagne);
  }

  .zs-cabinet-menu__preview-tagline {
    margin: 0;
    font-family: 'Cormorant Garamond', 'Times New Roman', Times, serif;
    font-weight: 300;
    font-style: italic;
    font-size: 28px;
    line-height: 1.25;
    color: var(--cabinet-ivory);
    max-width: 20ch;
  }

  html.zs-header--panel-open,
  html.zs-header--panel-open body {
    overflow: hidden;
  }
{% endstylesheet %}

<script>
  (() => {
    const root = document.querySelector('[data-zs-header]');
    if (!root) return;

    const panel = root.querySelector('[data-zs-panel]');
    const overlay = root.querySelector('[data-zs-overlay]');
    const openBtn = root.querySelector('[data-zs-menu-open]');
    const closeEls = [...root.querySelectorAll('[data-zs-menu-close]'), overlay].filter(Boolean);
    const announceEl = root.querySelector('[data-zs-announce-text]');

    const searchDropdown = root.querySelector('[data-zs-search-dropdown]');
    const searchDim = root.querySelector('[data-zs-search-dim]');
    const searchOpenBtn = root.querySelector('[data-zs-search-open]');
    const searchCloseBtn = root.querySelector('[data-zs-search-close]');
    const searchInput = root.querySelector('[data-zs-search-input]');
    const searchForm = root.querySelector('[data-zs-search-form]');
    const columnsEl = root.querySelector('[data-zs-search-columns]');
    const liveEl = root.querySelector('[data-zs-search-live]');
    const productListEl = root.querySelector('[data-zs-search-product-list]');
    const resultsHeadEl = root.querySelector('[data-zs-search-results-head]');
    const resultsCountEl = root.querySelector('[data-zs-search-results-count]');
    const noResWrapEl = root.querySelector('[data-zs-search-noresults-wrap]');
    const viewAllEl = root.querySelector('[data-zs-search-view-all]');
    const searchScroll = root.querySelector('[data-zs-search-scroll]');
    const searchProgress = root.querySelector('[data-zs-search-progress]');
    const searchProgressFill = root.querySelector('[data-zs-search-progress-fill]');

    const cabinetNavList = root.querySelector('[data-zs-cabinet-nav-list]');
    const cabinetPreviewEyebrow = root.querySelector('[data-cabinet-preview-eyebrow]');
    const cabinetPreviewTagline = root.querySelector('[data-cabinet-preview-tagline]');
    const cabinetImgA = root.querySelector('[data-cabinet-layer="a"]');
    const cabinetImgB = root.querySelector('[data-cabinet-layer="b"]');
    const cabinetRotatorLine = root.querySelector('[data-cabinet-rotator-line]');
    const cabinetRotatorLineMobile = root.querySelector('[data-cabinet-rotator-line-mobile]');
    const cabinetMSecondaryList = root.querySelector('[data-zs-cabinet-m-secondary-list]');
    const cfgEl = root.querySelector('[data-zs-search-config]');
    let suggestUrl = '/search/suggest.json';
    let searchUrl = '/search';
    if (cfgEl) {
      try {
        const cfg = JSON.parse(cfgEl.textContent);
        if (cfg.suggestUrl) suggestUrl = cfg.suggestUrl;
        if (cfg.searchUrl) searchUrl = cfg.searchUrl;
      } catch (_) {}
    }

    const messages = [
      'COMPLIMENTARY SHIPPING OVER $75',
      'FREE 30-DAY RETURNS',
      'NEW · CONTOUR BODYSUIT',
    ];

    let announceIndex = 0;
    if (announceEl) {
      const rotateAnnounce = () => {
        announceEl.classList.add('is-fade-out');
        window.setTimeout(() => {
          announceIndex = (announceIndex + 1) % messages.length;
          announceEl.textContent = messages[announceIndex];
          announceEl.classList.remove('is-fade-out');
        }, 400);
      };
      window.setInterval(rotateAnnounce, 5000);
    }

    const DEBOUNCE_MS = 300;
    const MIN_QUERY = 2;
    const MAX_VISIBLE = 4;
    const SUGGEST_LIMIT = 10;
    let debounceTimer = 0;
    let abortController = null;
    let scrollProgressRaf = 0;
    let searchScrollWasAtEnd = false;
    let searchDropdownHasAutoScrolledToTop = false;

    const resetSearchDropdownTypeSessionScroll = () => {
      searchDropdownHasAutoScrolledToTop = false;
    };

    const maybeScrollSearchDropdownToTopForTyping = () => {
      if (!searchScroll || searchDropdownHasAutoScrolledToTop) return;
      if (searchScroll.scrollTop <= 0) return;
      searchScroll.scrollTo({ top: 0, behavior: 'smooth' });
      searchDropdownHasAutoScrolledToTop = true;
      scheduleSearchScrollProgress();
    };

    const updateSearchScrollProgress = () => {
      if (!searchScroll || !searchProgressFill) return;
      const { scrollTop, scrollHeight, clientHeight } = searchScroll;
      const maxScroll = scrollHeight - clientHeight;

      if (maxScroll <= 1) {
        searchProgress?.setAttribute('hidden', '');
        searchProgress?.setAttribute('aria-hidden', 'true');
        searchProgressFill.style.height = '0';
        searchScrollWasAtEnd = false;
        return;
      }

      searchProgress?.removeAttribute('hidden');
      searchProgress?.setAttribute('aria-hidden', 'false');
      const pct = Math.min(100, Math.max(0, (scrollTop / maxScroll) * 100));
      searchProgressFill.style.height = `${pct}%`;

      const atEnd = scrollTop >= maxScroll - 2;
      if (atEnd && !searchScrollWasAtEnd) {
        searchProgress?.classList.add('is-complete');
        const onAnimEnd = () => {
          searchProgress?.classList.remove('is-complete');
          searchProgressFill.removeEventListener('animationend', onAnimEnd);
        };
        searchProgressFill.addEventListener('animationend', onAnimEnd);
      }
      searchScrollWasAtEnd = atEnd;
    };

    const scheduleSearchScrollProgress = () => {
      if (scrollProgressRaf) return;
      scrollProgressRaf = window.requestAnimationFrame(() => {
        scrollProgressRaf = 0;
        updateSearchScrollProgress();
      });
    };

    if (searchScroll) {
      searchScroll.addEventListener('scroll', scheduleSearchScrollProgress, { passive: true });
      if (typeof ResizeObserver !== 'undefined') {
        const scrollResizeObserver = new ResizeObserver(() => scheduleSearchScrollProgress());
        scrollResizeObserver.observe(searchScroll);
      }
    }

    const syncSearchDim = () => {
      const barEl = root.querySelector('[data-zs-header-bar]');
      if (!searchDim || !barEl) return;
      const top = Math.round(barEl.getBoundingClientRect().bottom);
      searchDim.style.setProperty('--zs-search-dim-top', `${top}px`);
    };

    const formatPrice = (p) => {
      if (p == null) return '';
      if (typeof p === 'string') return p;
      if (typeof p.price === 'string') return p.price;
      if (typeof p.price === 'number') return String(p.price);
      if (typeof p.price_min === 'string') return p.price_min;
      if (typeof p.price_min === 'number') return String(p.price_min);
      return '';
    };

    const imageUrl = (p) => {
      if (!p) return '';
      if (typeof p.featured_image === 'string') return p.featured_image;
      if (p.featured_image?.url) return p.featured_image.url;
      if (p.image) return p.image;
      return '';
    };

    const parseProducts = (data) => {
      try {
        const products = data?.resources?.results?.products;
        return Array.isArray(products) ? products : [];
      } catch (_) {
        return [];
      }
    };

    const setResultsHead = (total) => {
      if (!resultsHeadEl || !resultsCountEl) return;
      if (total <= 0) {
        resultsHeadEl.hidden = true;
        resultsCountEl.textContent = '';
        return;
      }
      resultsHeadEl.hidden = false;
      resultsCountEl.textContent = total === 1 ? '1 RESULT' : `${total} RESULTS`;
    };

    const resetSearchResults = () => {
      resetSearchDropdownTypeSessionScroll();
      if (columnsEl) columnsEl.hidden = false;
      if (liveEl) liveEl.hidden = true;
      if (productListEl) productListEl.innerHTML = '';
      if (noResWrapEl) noResWrapEl.hidden = true;
      if (resultsHeadEl) resultsHeadEl.hidden = true;
      if (resultsCountEl) resultsCountEl.textContent = '';
      if (viewAllEl) {
        viewAllEl.hidden = true;
        viewAllEl.href = searchUrl;
        viewAllEl.textContent = 'View all results →';
      }
      scheduleSearchScrollProgress();
    };

    const renderProducts = (allProducts, query) => {
      if (!productListEl) return;
      const visible = allProducts.slice(0, MAX_VISIBLE);
      productListEl.innerHTML = '';
      const frag = document.createDocumentFragment();
      visible.forEach((p) => {
        const li = document.createElement('li');
        li.className = 'zs-search-dropdown__result-item';
        const a = document.createElement('a');
        a.className = 'zs-search-dropdown__result-row';
        a.href = p.url || '#';
        const thumb = document.createElement('span');
        thumb.className = 'zs-search-dropdown__result-thumb';
        const src = imageUrl(p);
        if (src) {
          const img = document.createElement('img');
          img.src = src;
          img.alt = '';
          img.loading = 'lazy';
          img.width = 60;
          img.height = 80;
          thumb.append(img);
        }
        const meta = document.createElement('span');
        meta.className = 'zs-search-dropdown__result-meta';
        const name = document.createElement('span');
        name.className = 'zs-search-dropdown__result-name';
        name.textContent = p.title || '';
        const price = document.createElement('span');
        price.className = 'zs-search-dropdown__result-price';
        price.textContent = formatPrice(p);
        meta.append(name, price);
        a.append(thumb, meta);
        li.append(a);
        frag.append(li);
      });
      productListEl.append(frag);
      setResultsHead(allProducts.length);

      if (viewAllEl && query) {
        const u = new URL(searchUrl, window.location.origin);
        u.searchParams.set('q', query);
        u.searchParams.set('type', 'product');
        viewAllEl.href = u.pathname + u.search;
        const showViewAll = allProducts.length > MAX_VISIBLE;
        viewAllEl.hidden = !showViewAll;
        if (showViewAll) {
          const atSuggestCap = allProducts.length >= SUGGEST_LIMIT;
          const n = atSuggestCap ? `${SUGGEST_LIMIT}+` : String(allProducts.length);
          viewAllEl.textContent = `View all ${n} results →`;
        }
      }
      scheduleSearchScrollProgress();
    };

    const buildSuggestUrl = (q) => {
      const u = new URL(suggestUrl, window.location.origin);
      u.searchParams.set('q', q);
      u.searchParams.set('resources[type]', 'product');
      u.searchParams.set('resources[limit]', String(SUGGEST_LIMIT));
      return u.toString();
    };

    const runFetch = async (q) => {
      if (abortController) abortController.abort();
      abortController = new AbortController();
      const res = await fetch(buildSuggestUrl(q), {
        signal: abortController.signal,
        headers: { Accept: 'application/json' },
      });
      if (!res.ok) throw new Error('Suggest failed');
      return res.json();
    };

    const scheduleSearch = (q) => {
      window.clearTimeout(debounceTimer);
      debounceTimer = window.setTimeout(async () => {
        try {
          const data = await runFetch(q);
          const products = parseProducts(data);
          if (!products.length) {
            if (productListEl) productListEl.innerHTML = '';
            if (resultsHeadEl) resultsHeadEl.hidden = true;
            if (resultsCountEl) resultsCountEl.textContent = '';
            if (noResWrapEl) noResWrapEl.hidden = false;
            if (viewAllEl) viewAllEl.hidden = true;
            scheduleSearchScrollProgress();
            return;
          }
          if (noResWrapEl) noResWrapEl.hidden = true;
          renderProducts(products, q);
        } catch (err) {
          if (err.name === 'AbortError') return;
          if (productListEl) productListEl.innerHTML = '';
          if (resultsHeadEl) resultsHeadEl.hidden = true;
          if (resultsCountEl) resultsCountEl.textContent = '';
          if (noResWrapEl) noResWrapEl.hidden = false;
          if (viewAllEl) viewAllEl.hidden = true;
        }
        scheduleSearchScrollProgress();
      }, DEBOUNCE_MS);
    };

    let searchRelayout = null;

    function setSearchOpen(open, options = {}) {
      const preserveInput = options.preserveInput === true;
      if (!searchDropdown || !searchOpenBtn) return;
      if (open && searchDropdown.classList.contains('is-open')) return;
      if (!open && !searchDropdown.classList.contains('is-open')) return;
      if (open && panel?.classList.contains('is-active')) {
        setPanelOpen(false);
      }
      searchDropdown.classList.toggle('is-open', open);
      searchDropdown.setAttribute('aria-hidden', open ? 'false' : 'true');
      searchOpenBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
      searchDim?.classList.toggle('is-active', open);
      if (open) {
        syncSearchDim();
        searchRelayout = () => syncSearchDim();
        window.addEventListener('resize', searchRelayout);
        window.addEventListener('scroll', searchRelayout, { passive: true });
        window.requestAnimationFrame(() => {
          window.requestAnimationFrame(() => {
            syncSearchDim();
            searchInput?.focus({ preventScroll: true });
            resetSearchDropdownTypeSessionScroll();
            scheduleSearchScrollProgress();
          });
        });
      } else {
        if (searchRelayout) {
          window.removeEventListener('resize', searchRelayout);
          window.removeEventListener('scroll', searchRelayout);
          searchRelayout = null;
        }
        if (abortController) abortController.abort();
        window.clearTimeout(debounceTimer);
        if (searchInput && !preserveInput) {
          searchInput.value = '';
          searchInput.dispatchEvent(new Event('input', { bubbles: true }));
        }
        resetSearchResults();
        searchInput?.blur();
        searchOpenBtn.focus({ preventScroll: true });
        searchDim?.classList.remove('is-active');
        searchProgress?.setAttribute('hidden', '');
        searchProgress?.setAttribute('aria-hidden', 'true');
        searchProgress?.classList.remove('is-complete');
        if (searchProgressFill) searchProgressFill.style.height = '0';
        searchScrollWasAtEnd = false;
      }
    }

    const CABINET_TAGLINES = ['She wears herself.', 'Sculpted to feel held.', 'For every body.'];
    let cabinetLayerFront = 'a';
    let cabinetTaglineTimer = 0;
    let cabinetTaglineIndex = 0;
    let cabinetFocusTrapHandler = null;
    let cabinetPreviewLeaveTimer = 0;

    const getCabinetDefaultPreview = () => ({
      url: panel?.dataset.cabinetDefaultPreview || '',
      eyebrow: panel?.dataset.cabinetDefaultEyebrow || 'SHOP ALL',
      tagline: panel?.dataset.cabinetDefaultTagline || 'The complete collection.',
    });

    function preloadCabinetImages() {
      if (!panel) return;
      const urls = new Set();
      panel.querySelectorAll('[data-cabinet-preview]').forEach((el) => {
        const u = el.getAttribute('data-cabinet-preview');
        if (u) urls.add(u);
      });
      const d = getCabinetDefaultPreview().url;
      if (d) urls.add(d);
      urls.forEach((u) => {
        const im = new Image();
        im.src = u;
      });
    }

    function setCabinetPreviewCopy(eyebrow, tagline) {
      if (cabinetPreviewEyebrow) cabinetPreviewEyebrow.textContent = eyebrow;
      if (cabinetPreviewTagline) cabinetPreviewTagline.textContent = tagline;
    }

    function swapCabinetPreviewImage(url) {
      if (!cabinetImgA || !cabinetImgB || !url) return;
      const front = cabinetLayerFront === 'a' ? cabinetImgA : cabinetImgB;
      const back = cabinetLayerFront === 'a' ? cabinetImgB : cabinetImgA;
      const swap = () => {
        back.classList.add('is-active');
        front.classList.remove('is-active');
        cabinetLayerFront = cabinetLayerFront === 'a' ? 'b' : 'a';
      };
      const attr = back.getAttribute('src') || '';
      if (attr === url || back.src === url) {
        swap();
        return;
      }
      const done = () => {
        back.onload = null;
        swap();
      };
      back.onload = done;
      back.src = url;
      if (back.complete) done();
    }

    function applyCabinetPreviewFromLink(linkEl) {
      if (!linkEl || window.matchMedia('(max-width: 768px)').matches) return;
      const url = linkEl.getAttribute('data-cabinet-preview');
      const eyebrow = linkEl.getAttribute('data-cabinet-eyebrow');
      const tagline = linkEl.getAttribute('data-cabinet-tagline');
      if (url) swapCabinetPreviewImage(url);
      if (eyebrow && tagline) setCabinetPreviewCopy(eyebrow, tagline);
    }

    function resetCabinetPreview() {
      if (window.matchMedia('(max-width: 768px)').matches) return;
      const d = getCabinetDefaultPreview();
      if (d.url) swapCabinetPreviewImage(d.url);
      setCabinetPreviewCopy(d.eyebrow, d.tagline);
    }

    function scheduleCabinetPreviewReset() {
      window.clearTimeout(cabinetPreviewLeaveTimer);
      cabinetPreviewLeaveTimer = window.setTimeout(() => {
        const hovering = cabinetNavList?.querySelector('a.zs-cabinet-menu__link:hover');
        if (!hovering) resetCabinetPreview();
      }, 80);
    }

    function wireCabinetPreview() {
      if (!cabinetNavList) return;
      cabinetNavList.querySelectorAll('a[data-cabinet-preview]').forEach((link) => {
        link.addEventListener('mouseenter', () => {
          window.clearTimeout(cabinetPreviewLeaveTimer);
          applyCabinetPreviewFromLink(link);
        });
        link.addEventListener('mouseleave', scheduleCabinetPreviewReset);
        link.addEventListener('focus', () => applyCabinetPreviewFromLink(link));
      });
      cabinetNavList.addEventListener('focusout', (e) => {
        if (!cabinetNavList.contains(e.relatedTarget)) {
          window.setTimeout(() => resetCabinetPreview(), 0);
        }
      });
    }

    function startCabinetTaglines() {
      stopCabinetTaglines();
      if (!cabinetRotatorLine && !cabinetRotatorLineMobile) return;
      const setLines = (index, visible) => {
        const text = CABINET_TAGLINES[index];
        [cabinetRotatorLine, cabinetRotatorLineMobile].forEach((el) => {
          if (!el) return;
          el.textContent = text;
          el.classList.toggle('is-visible', visible);
        });
      };
      cabinetTaglineIndex = 0;
      setLines(0, true);
      cabinetTaglineTimer = window.setInterval(() => {
        [cabinetRotatorLine, cabinetRotatorLineMobile].forEach((el) => el?.classList.remove('is-visible'));
        window.setTimeout(() => {
          cabinetTaglineIndex = (cabinetTaglineIndex + 1) % CABINET_TAGLINES.length;
          setLines(cabinetTaglineIndex, true);
        }, 600);
      }, 8000);
    }

    function stopCabinetTaglines() {
      if (cabinetTaglineTimer) {
        window.clearInterval(cabinetTaglineTimer);
        cabinetTaglineTimer = 0;
      }
    }

    function getCabinetFocusables() {
      if (!panel) return [];
      return Array.from(
        panel.querySelectorAll(
          'button:not([disabled]), [href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'
        )
      ).filter((el) => {
        if (!panel.contains(el)) return false;
        const st = window.getComputedStyle(el);
        return st.display !== 'none' && st.visibility !== 'hidden';
      });
    }

    function bindCabinetFocusTrap() {
      unbindCabinetFocusTrap();
      cabinetFocusTrapHandler = (e) => {
        if (e.key !== 'Tab' || !panel?.classList.contains('is-active')) return;
        const f = getCabinetFocusables();
        if (f.length === 0) return;
        const first = f[0];
        const last = f[f.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      };
      document.addEventListener('keydown', cabinetFocusTrapHandler, true);
    }

    function unbindCabinetFocusTrap() {
      if (cabinetFocusTrapHandler) {
        document.removeEventListener('keydown', cabinetFocusTrapHandler, true);
        cabinetFocusTrapHandler = null;
      }
    }

    function setPanelOpen(open) {
      if (!panel || !overlay) return;
      if (open && searchDropdown?.classList.contains('is-open')) {
        setSearchOpen(false);
      }
      document.documentElement.classList.toggle('zs-header--panel-open', open);
      openBtn?.setAttribute('aria-expanded', open ? 'true' : 'false');
      if (open) {
        preloadCabinetImages();
        panel.hidden = false;
        overlay.hidden = false;
        cabinetLayerFront = 'a';
        const d = getCabinetDefaultPreview();
        if (cabinetImgA && d.url) {
          cabinetImgA.src = d.url;
          cabinetImgA.classList.add('is-active');
        }
        if (cabinetImgB && d.url) {
          cabinetImgB.src = d.url;
          cabinetImgB.classList.remove('is-active');
        }
        setCabinetPreviewCopy(d.eyebrow, d.tagline);
        window.requestAnimationFrame(() => {
          window.requestAnimationFrame(() => {
            panel.classList.add('is-active');
            overlay.classList.add('is-active');
            panel.classList.add('zs-cabinet-menu--intro');
            window.setTimeout(() => panel.classList.remove('zs-cabinet-menu--intro'), 850);
            startCabinetTaglines();
            bindCabinetFocusTrap();
            const isCabinetMobile = window.matchMedia('(max-width: 768px)').matches;
            const firstFocus = isCabinetMobile
              ? panel.querySelector('.zs-cabinet-menu__m-card')
              : cabinetNavList?.querySelector('a.zs-cabinet-menu__link');
            firstFocus?.focus({ preventScroll: true });
          });
        });
      } else {
        stopCabinetTaglines();
        unbindCabinetFocusTrap();
        window.clearTimeout(cabinetPreviewLeaveTimer);
        panel.classList.remove('zs-cabinet-menu--intro');
        panel.classList.remove('is-active');
        overlay.classList.remove('is-active');
        window.setTimeout(() => {
          panel.hidden = true;
          overlay.hidden = true;
        }, 600);
      }
    }

    openBtn?.addEventListener('click', () => {
      const expanded = openBtn.getAttribute('aria-expanded') === 'true';
      setPanelOpen(!expanded);
    });

    closeEls.forEach((el) => {
      el?.addEventListener('click', () => setPanelOpen(false));
    });

    panel?.querySelectorAll(
      'a.zs-cabinet-menu__link, a.zs-cabinet-menu__editors-card, a.zs-cabinet-menu__social-link, a.zs-cabinet-menu__m-card, a.zs-cabinet-menu__m-secondary-link, a.zs-cabinet-menu__m-editors, a.zs-cabinet-menu__m-social-link'
    ).forEach((link) => {
      link.addEventListener('click', () => setPanelOpen(false));
    });

    cabinetNavList?.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
      if (!panel?.classList.contains('is-active') || !cabinetNavList.contains(document.activeElement)) return;
      const links = Array.from(cabinetNavList.querySelectorAll('a.zs-cabinet-menu__link'));
      if (links.length === 0) return;
      const i = links.indexOf(document.activeElement);
      if (i < 0) return;
      e.preventDefault();
      const next = e.key === 'ArrowDown' ? Math.min(i + 1, links.length - 1) : Math.max(i - 1, 0);
      links[next]?.focus();
    });

    cabinetMSecondaryList?.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
      if (!panel?.classList.contains('is-active') || !cabinetMSecondaryList.contains(document.activeElement)) return;
      const links = Array.from(cabinetMSecondaryList.querySelectorAll('a.zs-cabinet-menu__m-secondary-link'));
      if (links.length === 0) return;
      const i = links.indexOf(document.activeElement);
      if (i < 0) return;
      e.preventDefault();
      const next = e.key === 'ArrowDown' ? Math.min(i + 1, links.length - 1) : Math.max(i - 1, 0);
      links[next]?.focus();
    });

    wireCabinetPreview();

    searchOpenBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      const next = !searchDropdown.classList.contains('is-open');
      setSearchOpen(next);
    });

    searchCloseBtn?.addEventListener('click', () => setSearchOpen(false));
    searchDim?.addEventListener('click', () => setSearchOpen(false));

    searchInput?.addEventListener('input', () => {
      const q = searchInput.value.trim();
      if (q.length < MIN_QUERY) {
        if (abortController) abortController.abort();
        window.clearTimeout(debounceTimer);
        resetSearchResults();
        return;
      }
      maybeScrollSearchDropdownToTopForTyping();
      if (columnsEl) columnsEl.hidden = true;
      if (liveEl) liveEl.hidden = false;
      if (noResWrapEl) noResWrapEl.hidden = true;
      scheduleSearchScrollProgress();
      scheduleSearch(q);
    });

    searchForm?.addEventListener('submit', () => {
      setSearchOpen(false, { preserveInput: true });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      if (searchDropdown?.classList.contains('is-open')) {
        e.preventDefault();
        setSearchOpen(false);
        return;
      }
      if (panel?.classList.contains('is-active')) {
        e.preventDefault();
        setPanelOpen(false);
      }
    });
  })();
</script>

