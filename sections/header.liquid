<div
  class="zs-header full-width"
  data-zs-header
  data-is-home="{% if request.page_type == 'index' %}true{% else %}false{% endif %}"
  {{ section.shopify_attributes }}
>
  <div class="zs-header__announce" aria-live="polite">
    <p class="zs-header__announce-text" data-zs-announce-text>COMPLIMENTARY SHIPPING OVER $75</p>
  </div>

  <header
    class="zs-header__bar"
    data-zs-header-bar
    style="background-color: #F0E8DF; color: #1A1A1A;"
  >
    <div class="zs-header__inner">
      <div class="zs-header__col zs-header__col--left">
        <button
          type="button"
          class="zs-header__menu-btn"
          data-zs-menu-open
          aria-expanded="false"
          aria-controls="zs-header-panel"
        >
          <span class="zs-header__hamburger" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </span>
          <span class="zs-header__menu-label">MENU</span>
        </button>
      </div>

      <div class="zs-header__col zs-header__col--center">
        <a class="zs-header__logo" href="{{ routes.root_url }}">ZALVA SHAPE</a>
      </div>

      <div class="zs-header__col zs-header__col--right">
        <button
          type="button"
          class="zs-header__icon-link zs-header__icon-btn"
          data-zs-search-open
          aria-expanded="false"
          aria-controls="zs-search-dropdown-dialog"
          aria-label="Search"
        >
          <svg class="zs-header__icon-svg" width="24" height="24" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <circle cx="8.5" cy="8.5" r="5" stroke="currentColor" stroke-width="1.5"/>
            <path d="M12.5 12.5L17 17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </button>
        {% if shop.customer_accounts_enabled %}
          <a class="zs-header__icon-link" href="{{ routes.account_url }}" aria-label="Account">
            <svg class="zs-header__icon-svg" width="24" height="24" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M10 11.5C12.4853 11.5 14.5 9.48528 14.5 7C14.5 4.51472 12.4853 2.5 10 2.5C7.51472 2.5 5.5 4.51472 5.5 7C5.5 9.48528 7.51472 11.5 10 11.5Z" stroke="currentColor" stroke-width="1.5"/>
              <path d="M3.5 17.5C3.5 14.4624 6.73858 12 10.5 12C14.2614 12 17.5 14.4624 17.5 17.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </a>
        {% endif %}
        <a class="zs-header__icon-link zs-header__icon-link--cart" href="{{ routes.cart_url }}" aria-label="Cart">
          <span class="zs-header__cart-wrap">
            <svg
              class="zs-header__icon-svg zs-header__icon-svg--cart"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              style="display: block; box-sizing: border-box;"
            >
              <path d="M6 8h12l-1 11a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2L6 8z"/>
              <path d="M9 8V6a3 3 0 0 1 6 0v2"/>
            </svg>
            {% if cart.item_count > 0 %}
              <span class="zs-header__cart-count">{{ cart.item_count }}</span>
            {% endif %}
          </span>
        </a>
      </div>
    </div>

    <div
      id="zs-search-dropdown-dialog"
      class="zs-search-dropdown"
      data-zs-search-dropdown
      role="dialog"
      aria-modal="true"
      aria-hidden="true"
      aria-labelledby="zs-search-dropdown-eyebrow"
    >
      <div class="zs-search-dropdown__inner">
        <button
          type="button"
          class="zs-search-dropdown__close"
          data-zs-search-close
          aria-label="Close search"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M6 6L18 18M18 6L6 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </button>

        <p id="zs-search-dropdown-eyebrow" class="zs-search-dropdown__eyebrow">Search</p>

        <form class="zs-search-dropdown__form" action="{{ routes.search_url }}" method="get" role="search" data-zs-search-form>
          <input type="hidden" name="type" value="product">
          <label class="zs-search-dropdown__visually-hidden" for="zs-search-dropdown-input">Search</label>
          <div class="search-input-wrapper">
            <input
              id="zs-search-dropdown-input"
              class="zs-search-dropdown__input zs-search-input"
              type="search"
              name="q"
              value=""
              autocomplete="off"
              autocorrect="off"
              autocapitalize="off"
              spellcheck="false"
              placeholder="What are you looking for?"
              data-zs-search-input
            >
            {% render 'search-clear-button' %}
          </div>
        </form>

        <span class="zs-search-dropdown__divider" aria-hidden="true"></span>

        <div class="zs-search-dropdown__scroll-area">
          <div class="zs-search-dropdown__body" data-zs-search-scroll>
            <div class="zs-search-dropdown__live" data-zs-search-live hidden>
              <p class="zs-search-dropdown__results-line" data-zs-search-results-head hidden>
                <span data-zs-search-results-count></span>
              </p>
              <ul class="zs-search-dropdown__results" data-zs-search-product-list role="list"></ul>
              <div class="zs-search-dropdown__noresults-wrap" data-zs-search-noresults-wrap hidden>
                <p class="zs-search-dropdown__noresults-empty">No products found.</p>
                <p class="zs-search-dropdown__noresults-hint">Try searching for &lsquo;bodysuit&rsquo; or &lsquo;shapewear&rsquo;</p>
              </div>
              <a class="zs-search-dropdown__view-all" href="{{ routes.search_url }}" data-zs-search-view-all hidden>View all results →</a>
            </div>

            <div class="zs-search-dropdown__columns" data-zs-search-columns>
              <div class="zs-search-dropdown__col">
                <p class="zs-search-dropdown__col-label">Popular searches</p>
                <ul class="zs-search-dropdown__links" role="list">
                  <li>
                    <a class="zs-search-dropdown__link" href="{{ routes.root_url }}collections/bodysuits">Bodysuits</a>
                  </li>
                  <li>
                    <a class="zs-search-dropdown__link" href="{{ routes.root_url }}collections/waist-trainers">Waist trainers</a>
                  </li>
                  <li>
                    <a class="zs-search-dropdown__link" href="{{ routes.root_url }}collections/fajas">Fajas</a>
                  </li>
                  <li>
                    <a class="zs-search-dropdown__link" href="{{ routes.all_products_collection_url }}?sort_by=best-selling">Best sellers</a>
                  </li>
                  <li>
                    <a class="zs-search-dropdown__link" href="{{ routes.all_products_collection_url }}?sort_by=created-descending">New arrivals</a>
                  </li>
                </ul>
            </div>
            <div class="zs-search-dropdown__col">
              <p class="zs-search-dropdown__col-label">Quick links</p>
              <ul class="zs-search-dropdown__links" role="list">
                <li>
                  <a class="zs-search-dropdown__link" href="{{ routes.all_products_collection_url }}">Shop All</a>
                </li>
                <li>
                  <a class="zs-search-dropdown__link" href="{{ routes.root_url }}pages/about">The Story</a>
                </li>
                <li>
                  <a class="zs-search-dropdown__link" href="{{ routes.root_url }}pages/size-guide">Size Guide</a>
                </li>
                <li>
                  <a class="zs-search-dropdown__link" href="{{ routes.root_url }}pages/faq">FAQ</a>
                </li>
                <li>
                  <a class="zs-search-dropdown__link" href="{{ routes.root_url }}pages/contact">Contact</a>
                </li>
              </ul>
            </div>
          </div>
          </div>
          <div class="zs-search-dropdown__progress" data-zs-search-progress hidden aria-hidden="true">
            <span class="zs-search-dropdown__progress-track" aria-hidden="true"></span>
            <span class="zs-search-dropdown__progress-fill" data-zs-search-progress-fill></span>
          </div>
        </div>
      </div>
    </div>
  </header>

  <div class="zs-header__search-dim" data-zs-search-dim aria-hidden="true"></div>

  <div class="zs-header__overlay" data-zs-overlay hidden></div>

  {% assign cabinet_preview = 'https://cdn.shopify.com/s/files/1/0998/1086/9562/files/GENERA_1.png?v=1778876800' %}
  <div
    class="zs-cabinet-menu"
    id="zs-header-panel"
    role="dialog"
    aria-modal="true"
    aria-label="Main navigation"
    data-zs-panel
    data-cabinet-default-preview="{{ cabinet_preview | escape }}"
    data-cabinet-default-eyebrow="SHOP ALL"
    data-cabinet-default-tagline="The complete collection."
    hidden
  >
    <button type="button" class="zs-cabinet-menu__close zs-cabinet-menu__close--desktop" data-zs-menu-close aria-label="Close menu">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M6 6L18 18M18 6L6 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </button>

    <div class="zs-cabinet-menu__mobile">
      <header class="zs-cabinet-menu__m-topbar">
        <span class="zs-cabinet-menu__m-logo">Zalva Shape</span>
        <button type="button" class="zs-cabinet-menu__m-close" data-zs-menu-close aria-label="Close menu">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M6 6L18 18M18 6L6 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </button>
      </header>
      <div class="zs-cabinet-menu__m-scroll">
        <div class="zs-cabinet-menu__m-cards">
          <a
            class="zs-cabinet-menu__m-card zs-cabinet-menu__m-card--hero zs-cabinet-menu__m-card--stagger"
            style="--cabinet-m-i: 0"
            href="{{ routes.root_url }}collections/bodysuits"
          >
            <span class="zs-cabinet-menu__m-card-bg" style="background-image: url('{{ cabinet_preview | escape }}');"></span>
            <span class="zs-cabinet-menu__m-card-overlay"></span>
            <span class="zs-cabinet-menu__m-card-label">
              <span class="zs-cabinet-menu__m-card-title">Bodysuits</span>
              <span class="zs-cabinet-menu__m-card-caption">Sculpting essentials</span>
            </span>
          </a>
          <a
            class="zs-cabinet-menu__m-card zs-cabinet-menu__m-card--hero zs-cabinet-menu__m-card--stagger"
            style="--cabinet-m-i: 1"
            href="{{ routes.root_url }}collections/waist-trainers"
          >
            <span class="zs-cabinet-menu__m-card-bg" style="background-image: url('{{ cabinet_preview | escape }}');"></span>
            <span class="zs-cabinet-menu__m-card-overlay"></span>
            <span class="zs-cabinet-menu__m-card-label">
              <span class="zs-cabinet-menu__m-card-title">Waist Trainers</span>
              <span class="zs-cabinet-menu__m-card-caption">Definition redefined</span>
            </span>
          </a>
          <div class="zs-cabinet-menu__m-row-split">
            <a
              class="zs-cabinet-menu__m-card zs-cabinet-menu__m-card--narrow zs-cabinet-menu__m-card--stagger"
              style="--cabinet-m-i: 2"
              href="{{ routes.root_url }}collections/fajas"
            >
              <span class="zs-cabinet-menu__m-card-bg" style="background-image: url('{{ cabinet_preview | escape }}');"></span>
              <span class="zs-cabinet-menu__m-card-overlay"></span>
              <span class="zs-cabinet-menu__m-card-label">
                <span class="zs-cabinet-menu__m-card-title zs-cabinet-menu__m-card-title--sm">Fajas</span>
                <span class="zs-cabinet-menu__m-card-caption zs-cabinet-menu__m-card-caption--sm">Full coverage</span>
              </span>
            </a>
            <a
              class="zs-cabinet-menu__m-card zs-cabinet-menu__m-card--narrow zs-cabinet-menu__m-card--shopall zs-cabinet-menu__m-card--stagger"
              style="--cabinet-m-i: 3"
              href="{{ routes.all_products_collection_url }}"
            >
              <span class="zs-cabinet-menu__m-shopall-inner">
                <svg class="zs-cabinet-menu__m-shopall-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M4 4h7v7H4V4zm9 0h7v7h-7V4zM4 13h7v7H4v-7zm9 0h7v7h-7v-7z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                </svg>
                <span class="zs-cabinet-menu__m-card-title zs-cabinet-menu__m-card-title--shop">Shop All</span>
                <span class="zs-cabinet-menu__m-card-caption zs-cabinet-menu__m-card-caption--shop">Discover everything</span>
              </span>
            </a>
          </div>
        </div>

        <nav class="zs-cabinet-menu__m-secondary" aria-label="More links">
          <span class="zs-cabinet-menu__m-secondary-rule" aria-hidden="true"></span>
          <ul class="zs-cabinet-menu__m-secondary-list" role="list" data-zs-cabinet-m-secondary-list>
            <li>
              <a class="zs-cabinet-menu__m-secondary-link" href="{{ routes.root_url }}pages/about">
                <span>The Story</span>
                <span class="zs-cabinet-menu__m-secondary-arrow" aria-hidden="true">&rarr;</span>
              </a>
            </li>
            <li>
              <a class="zs-cabinet-menu__m-secondary-link" href="{{ routes.root_url }}pages/size-guide">
                <span>Size Guide</span>
                <span class="zs-cabinet-menu__m-secondary-arrow" aria-hidden="true">&rarr;</span>
              </a>
            </li>
            <li>
              <a class="zs-cabinet-menu__m-secondary-link" href="{{ routes.root_url }}pages/faq">
                <span>FAQ</span>
                <span class="zs-cabinet-menu__m-secondary-arrow" aria-hidden="true">&rarr;</span>
              </a>
            </li>
            <li>
              <a class="zs-cabinet-menu__m-secondary-link" href="{{ routes.root_url }}pages/contact">
                <span>Contact</span>
                <span class="zs-cabinet-menu__m-secondary-arrow" aria-hidden="true">&rarr;</span>
              </a>
            </li>
            {% if shop.customer_accounts_enabled %}
              <li>
                <a class="zs-cabinet-menu__m-secondary-link" href="{{ routes.account_url }}">
                  <span>Account</span>
                  <span class="zs-cabinet-menu__m-secondary-arrow" aria-hidden="true">&rarr;</span>
                </a>
              </li>
            {% endif %}
          </ul>
        </nav>

        <a class="zs-cabinet-menu__m-editors" href="{{ routes.root_url }}products/contour-bodysuit">
          <span class="zs-cabinet-menu__m-editors-imgwrap">
            <img src="{{ cabinet_preview | escape }}" width="80" height="100" alt="">
          </span>
          <span class="zs-cabinet-menu__m-editors-copy">
            <span class="zs-cabinet-menu__m-editors-eyebrow">Editor&rsquo;s pick</span>
            <span class="zs-cabinet-menu__m-editors-name">Contour Bodysuit</span>
            <span class="zs-cabinet-menu__m-editors-cta">Discover &rarr;</span>
          </span>
        </a>

        <footer class="zs-cabinet-menu__m-footer">
          <div class="zs-cabinet-menu__m-tagline" data-cabinet-rotator-mobile aria-live="polite">
            <p class="zs-cabinet-menu__m-tagline-line is-visible" data-cabinet-rotator-line-mobile>She wears herself.</p>
          </div>
          <div class="zs-cabinet-menu__m-social" aria-label="Social">
            <a class="zs-cabinet-menu__m-social-link" href="#" aria-label="Instagram">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.5"/>
                <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.5"/>
                <circle cx="17.5" cy="6.5" r="1" fill="currentColor"/>
              </svg>
            </a>
            <a class="zs-cabinet-menu__m-social-link" href="#" aria-label="TikTok">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M10 8v10a3 3 0 1 1-3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M14 6c2 2 4 2 6 1v5a6 6 0 0 1-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </a>
            <a class="zs-cabinet-menu__m-social-link" href="#" aria-label="Pinterest">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M12 3C8 3 5 6 5 10c0 3 1.5 5 4 6v4l3-3c3 1 6-1 7-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <circle cx="12" cy="10" r="3" stroke="currentColor" stroke-width="1.5"/>
              </svg>
            </a>
          </div>
        </footer>
      </div>
    </div>

    <div class="zs-cabinet-menu__grid">
      <div class="zs-cabinet-menu__left" data-zs-cabinet-nav-zone>
        <nav class="zs-cabinet-menu__nav" aria-label="Primary">
          <ul class="zs-cabinet-menu__list" role="list" data-zs-cabinet-nav-list>
            <li class="zs-cabinet-menu__item zs-cabinet-menu__item--stagger" style="--cabinet-i: 0">
              <a
                class="zs-cabinet-menu__link"
                href="{{ routes.all_products_collection_url }}"
                data-cabinet-preview="{{ cabinet_preview | escape }}"
                data-cabinet-eyebrow="SHOP ALL"
                data-cabinet-tagline="The complete collection."
              >
                Shop All
              </a>
            </li>
            <li class="zs-cabinet-menu__item zs-cabinet-menu__item--stagger" style="--cabinet-i: 1">
              <a
                class="zs-cabinet-menu__link zs-cabinet-menu__link--thumb-wrap"
                href="{{ routes.root_url }}collections/bodysuits"
                data-cabinet-preview="{{ cabinet_preview | escape }}"
                data-cabinet-eyebrow="BODYSUITS"
                data-cabinet-tagline="Sculpting essentials."
              >
                <span class="zs-cabinet-menu__thumb" aria-hidden="true">
                  <img src="{{ cabinet_preview | escape }}" width="40" height="52" alt="">
                </span>
                <span class="zs-cabinet-menu__link-text">Bodysuits</span>
              </a>
            </li>
            <li class="zs-cabinet-menu__item zs-cabinet-menu__item--stagger" style="--cabinet-i: 2">
              <a
                class="zs-cabinet-menu__link zs-cabinet-menu__link--thumb-wrap"
                href="{{ routes.root_url }}collections/waist-trainers"
                data-cabinet-preview="{{ cabinet_preview | escape }}"
                data-cabinet-eyebrow="WAIST TRAINERS"
                data-cabinet-tagline="Define your silhouette."
              >
                <span class="zs-cabinet-menu__thumb" aria-hidden="true">
                  <img src="{{ cabinet_preview | escape }}" width="40" height="52" alt="">
                </span>
                <span class="zs-cabinet-menu__link-text">Waist Trainers</span>
              </a>
            </li>
            <li class="zs-cabinet-menu__item zs-cabinet-menu__item--stagger" style="--cabinet-i: 3">
              <a
                class="zs-cabinet-menu__link zs-cabinet-menu__link--thumb-wrap"
                href="{{ routes.root_url }}collections/fajas"
                data-cabinet-preview="{{ cabinet_preview | escape }}"
                data-cabinet-eyebrow="FAJAS"
                data-cabinet-tagline="Confidence, tailored."
              >
                <span class="zs-cabinet-menu__thumb" aria-hidden="true">
                  <img src="{{ cabinet_preview | escape }}" width="40" height="52" alt="">
                </span>
                <span class="zs-cabinet-menu__link-text">Fajas</span>
              </a>
            </li>
            <li class="zs-cabinet-menu__item zs-cabinet-menu__item--divider zs-cabinet-menu__item--stagger" style="--cabinet-i: 4" aria-hidden="true">
              <span class="zs-cabinet-menu__rule"></span>
            </li>
            <li class="zs-cabinet-menu__item zs-cabinet-menu__item--stagger" style="--cabinet-i: 5">
              <a
                class="zs-cabinet-menu__link"
                href="{{ routes.root_url }}pages/about"
                data-cabinet-preview="{{ cabinet_preview | escape }}"
                data-cabinet-eyebrow="THE STORY"
                data-cabinet-tagline="Who we are."
              >
                The Story
              </a>
            </li>
            <li class="zs-cabinet-menu__item zs-cabinet-menu__item--stagger" style="--cabinet-i: 6">
              <a
                class="zs-cabinet-menu__link"
                href="{{ routes.root_url }}pages/size-guide"
                data-cabinet-preview="{{ cabinet_preview | escape }}"
                data-cabinet-eyebrow="SIZE GUIDE"
                data-cabinet-tagline="Find your fit."
              >
                Size Guide
              </a>
            </li>
            <li class="zs-cabinet-menu__item zs-cabinet-menu__item--stagger" style="--cabinet-i: 7">
              <a
                class="zs-cabinet-menu__link"
                href="{{ routes.root_url }}pages/faq"
                data-cabinet-preview="{{ cabinet_preview | escape }}"
                data-cabinet-eyebrow="FAQ"
                data-cabinet-tagline="Quick answers."
              >
                FAQ
              </a>
            </li>
            <li class="zs-cabinet-menu__item zs-cabinet-menu__item--stagger" style="--cabinet-i: 8">
              <a
                class="zs-cabinet-menu__link"
                href="{{ routes.root_url }}pages/contact"
                data-cabinet-preview="{{ cabinet_preview | escape }}"
                data-cabinet-eyebrow="CONTACT"
                data-cabinet-tagline="We're here to help."
              >
                Contact
              </a>
            </li>
          </ul>
        </nav>
        <div class="zs-cabinet-menu__bottom">
          <div class="zs-cabinet-menu__editors">
            <p class="zs-cabinet-menu__editors-label">Editor&rsquo;s pick</p>
            <a class="zs-cabinet-menu__editors-card" href="{{ routes.root_url }}products/contour-bodysuit">
              <span class="zs-cabinet-menu__editors-media">
                <img src="{{ cabinet_preview | escape }}" width="60" height="80" alt="">
              </span>
              <span class="zs-cabinet-menu__editors-meta">
                <span class="zs-cabinet-menu__editors-name">Contour Bodysuit</span>
                <span class="zs-cabinet-menu__editors-cta">Discover &rarr;</span>
              </span>
            </a>
          </div>
          <div class="zs-cabinet-menu__tagline-rotator" data-cabinet-rotator aria-live="polite">
