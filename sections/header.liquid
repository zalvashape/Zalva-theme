<div
  class="zs-header full-width"
  data-zs-header
  data-is-home="{% if request.page_type == 'index' %}true{% else %}false{% endif %}"
  {{ section.shopify_attributes }}
>
  <div class="zs-header__announce" aria-live="polite">
    <p class="zs-header__announce-text" data-zs-announce-text>COMPLIMENTARY SHIPPING OVER $75</p>
  </div>

  <header class="zs-header__bar" data-zs-header-bar>
    <div class="zs-header__inner">
      <div class="zs-header__col zs-header__col--left">
        <button
          type="button"
          class="zs-header__menu-btn"
          data-zs-menu-open
          aria-expanded="false"
          aria-controls="zs-header-panel"
        >
          <span class="zs-header__hamburger" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </span>
          <span class="zs-header__menu-label">MENU</span>
        </button>
      </div>

      <div class="zs-header__col zs-header__col--center">
        <a class="zs-header__logo" href="{{ routes.root_url }}">ZALVA SHAPE</a>
      </div>

      <div class="zs-header__col zs-header__col--right">
        <a class="zs-header__icon-link" href="{{ routes.search_url }}" aria-label="Search">
          <svg class="zs-header__icon-svg" width="24" height="24" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <circle cx="8.5" cy="8.5" r="5" stroke="currentColor" stroke-width="1.5"/>
            <path d="M12.5 12.5L17 17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </a>
        {% if shop.customer_accounts_enabled %}
          <a class="zs-header__icon-link" href="{{ routes.account_url }}" aria-label="Account">
            <svg class="zs-header__icon-svg" width="24" height="24" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M10 11.5C12.4853 11.5 14.5 9.48528 14.5 7C14.5 4.51472 12.4853 2.5 10 2.5C7.51472 2.5 5.5 4.51472 5.5 7C5.5 9.48528 7.51472 11.5 10 11.5Z" stroke="currentColor" stroke-width="1.5"/>
              <path d="M3.5 17.5C3.5 14.4624 6.73858 12 10.5 12C14.2614 12 17.5 14.4624 17.5 17.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </a>
        {% endif %}
        <a class="zs-header__icon-link zs-header__icon-link--cart" href="{{ routes.cart_url }}" aria-label="Cart">
          <span class="zs-header__cart-wrap">
            <svg
              class="zs-header__icon-svg zs-header__icon-svg--cart"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              style="display: block; box-sizing: border-box;"
            >
              <path d="M6 8h12l-1 11a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2L6 8z"/>
              <path d="M9 8V6a3 3 0 0 1 6 0v2"/>
            </svg>
            {% if cart.item_count > 0 %}
              <span class="zs-header__cart-count">{{ cart.item_count }}</span>
            {% endif %}
          </span>
        </a>
      </div>
    </div>
  </header>

  <div class="zs-header__overlay" data-zs-overlay hidden></div>

  <div
    class="zs-header__panel"
    id="zs-header-panel"
    role="dialog"
    aria-modal="true"
    aria-label="Menu"
    data-zs-panel
    hidden
  >
    <button type="button" class="zs-header__panel-close" data-zs-menu-close aria-label="Close menu">
      <span aria-hidden="true">&times;</span>
    </button>
    <nav class="zs-header__panel-nav" aria-label="Primary">
      <ul class="zs-header__panel-list">
        <li><a class="zs-header__panel-link" href="{{ routes.all_products_collection_url }}">Shop</a></li>
        <li><a class="zs-header__panel-link" href="{{ routes.root_url }}collections/bodysuits">Bodysuits</a></li>
        <li><a class="zs-header__panel-link" href="{{ routes.root_url }}collections/waist-trainers">Waist Trainers</a></li>
        <li><a class="zs-header__panel-link" href="{{ routes.root_url }}collections/fajas">Fajas</a></li>
        <li><a class="zs-header__panel-link" href="{{ routes.root_url }}pages/about">The Story</a></li>
        <li><a class="zs-header__panel-link" href="{{ routes.root_url }}pages/size-guide">Size Guide</a></li>
        <li><a class="zs-header__panel-link" href="{{ routes.root_url }}pages/contact">Contact</a></li>
      </ul>
    </nav>
    <div class="zs-header__panel-footer">
      <span class="zs-header__panel-line" aria-hidden="true"></span>
      <p class="zs-header__panel-social">INSTAGRAM · TIKTOK</p>
    </div>
  </div>
</div>

{% stylesheet %}
  .zs-header {
    --zs-noir: #1a1a1a;
    --zs-ivory: #faf8f5;
    --zs-champagne: #c8a96e;
    --zs-taupe: #a07060;
    --zs-border: #e5ddd3;

    position: relative;
    z-index: 100;
    width: 100%;
    box-sizing: border-box;
  }

  .zs-header__announce {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 32px;
    min-height: 32px;
    width: 100%;
    box-sizing: border-box;
    padding-inline: 20px;
    background-color: var(--zs-noir);
    color: var(--zs-champagne);
    will-change: background-color, color;
    transition:
      background-color 0.4s ease,
      color 0.4s ease;
  }

  @media (min-width: 769px) {
    .zs-header__announce {
      height: 36px;
      min-height: 36px;
      padding-inline: 40px;
    }
  }

  .zs-header__announce-text {
    margin: 0;
    font-family: Jost, var(--font-primary--family), system-ui, sans-serif;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    line-height: 1;
    opacity: 1;
    transition: opacity 0.4s ease;
    text-align: center;
    max-width: 100%;
  }

  @media (min-width: 769px) {
    .zs-header__announce-text {
      font-size: 11px;
    }
  }

  .zs-header__announce-text.is-fade-out {
    opacity: 0;
  }

  .zs-header__bar {
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
    box-sizing: border-box;
    height: 72px;
    display: flex;
    align-items: center;
    background-color: rgba(250, 248, 245, 0.92);
    color: var(--zs-noir);
    border-bottom: 1px solid var(--zs-border);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    will-change: background-color, color;
    transition:
      background-color 0.4s ease,
      color 0.4s ease,
      border-color 0.4s ease,
      backdrop-filter 0.4s ease,
      -webkit-backdrop-filter 0.4s ease;
  }

  @media (min-width: 769px) {
    .zs-header__bar {
      height: 96px;
    }
  }

  /* Adaptive themes (classes applied by layout/theme.liquid script). */
  .zs-header.header-theme-light .zs-header__bar {
    background-color: #faf8f5;
    color: #1a1a1a;
    border-bottom-color: var(--zs-border);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }

  .zs-header.header-theme-light .zs-header__announce {
    background-color: var(--zs-noir);
    color: var(--zs-champagne);
  }

  .zs-header.header-theme-dark .zs-header__bar {
    background-color: #1a1a1a;
    color: #faf8f5;
    border-bottom-color: rgba(255, 255, 255, 0.12);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }

  .zs-header.header-theme-dark .zs-header__announce {
    background-color: #faf8f5;
    color: #1a1a1a;
  }

  .zs-header__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    width: 100%;
    box-sizing: border-box;
    padding-inline: 20px 16px;
  }

  @media (min-width: 769px) {
    .zs-header__inner {
      display: flex;
      justify-content: space-between;
      padding-inline: 40px;
    }
  }

  .zs-header__col--left {
    position: relative;
    z-index: 2;
    grid-column: 1;
    justify-self: start;
    display: flex;
    justify-content: flex-start;
    flex: 0 0 auto;
    min-width: 0;
  }

  @media (min-width: 769px) {
    .zs-header__col--left {
      grid-column: auto;
      justify-self: auto;
    }
  }

  .zs-header__col--center {
    position: static;
    grid-column: 2;
    justify-self: center;
    z-index: 1;
    transform: none;
    display: flex;
    justify-content: center;
    text-align: center;
    width: auto;
    max-width: 100%;
    min-width: 0;
    pointer-events: auto;
  }

  @media (min-width: 769px) {
    .zs-header__col--center {
      position: absolute;
      left: 50%;
      top: 50%;
      grid-column: auto;
      justify-self: auto;
      transform: translate(-50%, -50%);
      width: max-content;
      max-width: min(100vw - 160px, 100%);
      pointer-events: none;
    }

    .zs-header__col--center .zs-header__logo {
      pointer-events: auto;
    }
  }

  .zs-header__col--right {
    position: relative;
    z-index: 2;
    grid-column: 3;
    justify-self: end;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 12px;
    flex: 0 0 auto;
    min-width: 0;
  }

  @media (min-width: 769px) {
    .zs-header__col--right {
      grid-column: auto;
      justify-self: auto;
      gap: 24px;
    }
  }

  .zs-header__menu-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 0;
    margin: 0;
    border: none;
    background: transparent;
    color: inherit;
    cursor: pointer;
    font-family: Jost, var(--font-primary--family), system-ui, sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    line-height: 1;
  }

  @media (min-width: 769px) {
    .zs-header__menu-btn {
      font-size: 12px;
    }
  }

  .zs-header__menu-btn:focus-visible {
    outline: 2px solid var(--zs-champagne);
    outline-offset: 4px;
  }

  .zs-header__hamburger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    width: 18px;
    flex-shrink: 0;
  }

  .zs-header__hamburger span {
    display: block;
    width: 18px;
    height: 1.5px;
    background-color: currentColor;
    border-radius: 0.5px;
  }

  @media (min-width: 769px) {
    .zs-header__hamburger {
      width: 22px;
    }

    .zs-header__hamburger span {
      width: 22px;
    }
  }

  @media (max-width: 768px) {
    .zs-header__menu-label {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    .zs-header__menu-btn {
      gap: 0;
    }
  }

  .zs-header__logo {
    pointer-events: auto;
    font-family: 'Cormorant Garamond', 'Times New Roman', Times, serif;
    font-weight: 300;
    font-size: 16px;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    text-decoration: none;
    color: inherit;
    line-height: 1.1;
    white-space: nowrap;
  }

  .zs-header__logo:focus-visible {
    outline: 2px solid var(--zs-champagne);
    outline-offset: 4px;
  }

  @media (min-width: 769px) {
    .zs-header__logo {
      font-size: 26px;
    }
  }

  .zs-header__icon-link {
    display: flex;
    align-items: center;
    justify-content: center;
    color: inherit;
    text-decoration: none;
    position: relative;
  }

  .zs-header__icon-link:focus-visible {
    outline: 2px solid var(--zs-champagne);
    outline-offset: 4px;
  }

  .zs-header__icon-svg {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
  }

  @media (min-width: 769px) {
    .zs-header__icon-svg {
      width: 24px;
      height: 24px;
    }
  }

  .zs-header__cart-wrap {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    overflow: visible;
  }

  @media (min-width: 769px) {
    .zs-header__cart-wrap {
      width: 24px;
      height: 24px;
    }
  }

  .zs-header__cart-wrap .zs-header__icon-svg--cart {
    width: 20px;
    height: 20px;
    min-width: 20px;
    min-height: 20px;
    max-width: 20px;
    max-height: 20px;
  }

  @media (min-width: 769px) {
    .zs-header__cart-wrap .zs-header__icon-svg--cart {
      width: 24px;
      height: 24px;
      min-width: 24px;
      min-height: 24px;
      max-width: 24px;
      max-height: 24px;
    }
  }

  .zs-header__cart-count {
    position: absolute;
    top: -5px;
    right: -7px;
    font-family: Jost, var(--font-primary--family), system-ui, sans-serif;
    font-size: 10px;
    font-weight: 500;
    color: var(--zs-champagne);
    line-height: 1;
    pointer-events: none;
  }

  @media (min-width: 769px) {
    .zs-header__cart-count {
      font-size: 11px;
    }
  }

  .zs-header.header-theme-dark .zs-header__cart-count {
    color: var(--zs-champagne);
  }

  .zs-header__overlay {
    position: fixed;
    inset: 0;
    z-index: 150;
    background-color: rgba(26, 26, 26, 0.4);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 0.4s ease,
      visibility 0.4s ease;
  }

  .zs-header__overlay.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .zs-header__overlay[hidden] {
    display: block;
  }

  .zs-header__panel {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 200;
    width: 400px;
    max-width: 100%;
    height: 100vh;
    height: 100dvh;
    background-color: var(--zs-ivory);
    color: var(--zs-noir);
    transform: translateX(-100%);
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    overflow-y: auto;
    padding-top: 60px;
    box-sizing: border-box;
  }

  .zs-header__panel.is-active {
    transform: translateX(0);
    pointer-events: auto;
  }

  .zs-header__panel:not(.is-active) {
    pointer-events: none;
  }

  .zs-header__panel[hidden] {
    display: block;
  }

  @media (max-width: 768px) {
    .zs-header__panel {
      width: 100%;
    }
  }

  .zs-header__panel-close {
    position: absolute;
    top: 20px;
    right: 24px;
    padding: 0;
    border: none;
    background: transparent;
    color: var(--zs-noir);
    font-size: 16px;
    line-height: 1;
    cursor: pointer;
  }

  .zs-header__panel-close:focus-visible {
    outline: 2px solid var(--zs-champagne);
    outline-offset: 2px;
  }

  .zs-header__panel-nav {
    padding-left: 60px;
    padding-right: 24px;
  }

  .zs-header__panel-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .zs-header__panel-link {
    font-family: 'Cormorant Garamond', 'Times New Roman', Times, serif;
    font-weight: 300;
    font-size: clamp(28px, 4vw, 36px);
    color: var(--zs-noir);
    letter-spacing: 0.02em;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .zs-header__panel-link:hover {
    color: var(--zs-taupe);
  }

  .zs-header__panel-footer {
    position: absolute;
    bottom: 40px;
    left: 60px;
    right: 24px;
  }

  .zs-header__panel-line {
    display: block;
    width: 24px;
    height: 1px;
    background-color: var(--zs-champagne);
    margin-bottom: 16px;
  }

  .zs-header__panel-social {
    margin: 0;
    font-family: Jost, var(--font-primary--family), system-ui, sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--zs-taupe);
  }

  html.zs-header--panel-open,
  html.zs-header--panel-open body {
    overflow: hidden;
  }
{% endstylesheet %}

<script>
  (() => {
    const root = document.querySelector('[data-zs-header]');
    if (!root) return;

    const panel = root.querySelector('[data-zs-panel]');
    const overlay = root.querySelector('[data-zs-overlay]');
    const openBtn = root.querySelector('[data-zs-menu-open]');
    const closeEls = [root.querySelector('[data-zs-menu-close]'), overlay].filter(Boolean);
    const announceEl = root.querySelector('[data-zs-announce-text]');

    const messages = [
      'COMPLIMENTARY SHIPPING OVER $75',
      'FREE 30-DAY RETURNS',
      'NEW · CONTOUR BODYSUIT',
    ];

    let announceIndex = 0;
    if (announceEl) {
      const rotateAnnounce = () => {
        announceEl.classList.add('is-fade-out');
        window.setTimeout(() => {
          announceIndex = (announceIndex + 1) % messages.length;
          announceEl.textContent = messages[announceIndex];
          announceEl.classList.remove('is-fade-out');
        }, 400);
      };
      window.setInterval(rotateAnnounce, 5000);
    }

    const setPanelOpen = (open) => {
      if (!panel || !overlay) return;
      document.documentElement.classList.toggle('zs-header--panel-open', open);
      openBtn?.setAttribute('aria-expanded', open ? 'true' : 'false');
      if (open) {
        panel.hidden = false;
        overlay.hidden = false;
        window.requestAnimationFrame(() => {
          window.requestAnimationFrame(() => {
            panel.classList.add('is-active');
            overlay.classList.add('is-active');
          });
        });
      } else {
        panel.classList.remove('is-active');
        overlay.classList.remove('is-active');
        window.setTimeout(() => {
          panel.hidden = true;
          overlay.hidden = true;
        }, 500);
      }
    };

    openBtn?.addEventListener('click', () => {
      const expanded = openBtn.getAttribute('aria-expanded') === 'true';
      setPanelOpen(!expanded);
    });

    closeEls.forEach((el) => {
      el?.addEventListener('click', () => setPanelOpen(false));
    });

    panel?.querySelectorAll('a.zs-header__panel-link').forEach((link) => {
      link.addEventListener('click', () => setPanelOpen(false));
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && panel?.classList.contains('is-active')) {
        setPanelOpen(false);
      }
    });

  })();
</script>

{% schema %}
{
  "name": "t:general.header",
  "tag": "div",
  "class": "section-zs-header",
  "settings": []
}
{% endschema %}
