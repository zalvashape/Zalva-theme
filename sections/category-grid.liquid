{% liquid
  assign eyebrow_text = section.settings.eyebrow_text | default: 'EXPLORE THE COLLECTION'
  assign main_title = section.settings.main_title | default: 'Find your shape.'

  assign img_def_1 = 'https://images.unsplash.com/photo-1564859228273-274232fdb516?w=900&q=85'
  assign img_def_2 = 'https://images.unsplash.com/photo-1571513722275-4b41940f54b8?w=900&q=85'
  assign img_def_3 = 'https://images.unsplash.com/photo-1518310383802-640c2de311b2?w=900&q=85'

  assign tone_def_1 = '#d4b5a0'
  assign tone_def_2 = '#a07060'
  assign tone_def_3 = '#3d2b24'

  assign tone_1 = section.settings.card_1_tone | default: tone_def_1
  assign tone_2 = section.settings.card_2_tone | default: tone_def_2
  assign tone_3 = section.settings.card_3_tone | default: tone_def_3

  assign tone_1_top = tone_1 | color_modify: 'alpha', 0.3
  assign tone_1_deep = tone_1 | color_modify: 'alpha', 0.39
  assign tone_2_top = tone_2 | color_modify: 'alpha', 0.4
  assign tone_2_deep = tone_2 | color_modify: 'alpha', 0.52
  assign tone_3_top = tone_3 | color_modify: 'alpha', 0.5
  assign tone_3_deep = tone_3 | color_modify: 'alpha', 0.65

  assign title_1 = section.settings.card_1_title | default: 'Bodysuits'
  assign title_2 = section.settings.card_2_title | default: 'Waist Trainers'
  assign title_3 = section.settings.card_3_title | default: 'Fajas'

  assign link_1 = section.settings.card_1_link | default: '/collections/bodysuits'
  assign link_2 = section.settings.card_2_link | default: '/collections/waist-trainers'
  assign link_3 = section.settings.card_3_link | default: '/collections/fajas'

  if section.settings.card_1_image != blank
    assign src_1 = section.settings.card_1_image | image_url: width: 1400
  else
    assign src_1 = img_def_1
  endif
  if section.settings.card_2_image != blank
    assign src_2 = section.settings.card_2_image | image_url: width: 1400
  else
    assign src_2 = img_def_2
  endif
  if section.settings.card_3_image != blank
    assign src_3 = section.settings.card_3_image | image_url: width: 1400
  else
    assign src_3 = img_def_3
  endif
%}

<div class="category-grid full-width" data-category-grid data-header-theme="light">
  <div class="category-grid__header-row">
    <header class="category-grid__header">
      <p class="category-grid__eyebrow" data-category-grid-header>{{ eyebrow_text }}</p>
      <h2 class="category-grid__title" data-category-grid-header>{{ main_title }}</h2>
    </header>
  </div>

  <ul class="category-grid__grid" role="list">
      <li class="category-grid__item" data-category-grid-card>
        <a class="category-grid__card" href="{{ link_1 }}" aria-label="{{ title_1 }} — Shop now">
          <span class="category-grid__media">
            <img
              class="category-grid__img"
              src="{{ src_1 }}"
              alt=""
              width="900"
              height="1125"
              loading="lazy"
              decoding="async"
            >
          </span>
          <span
            class="category-grid__tone category-grid__tone--base"
            style="background: linear-gradient(to top, transparent, {{ tone_1_top }});"
            aria-hidden="true"
          ></span>
          <span
            class="category-grid__tone category-grid__tone--deep"
            style="background: linear-gradient(to top, transparent, {{ tone_1_deep }});"
            aria-hidden="true"
          ></span>
          <span class="category-grid__body">
            <span class="category-grid__name">{{ title_1 }}</span>
            <span class="category-grid__rule" aria-hidden="true"></span>
            <span class="category-grid__shop">Shop now →</span>
          </span>
        </a>
      </li>
      <li class="category-grid__item" data-category-grid-card>
        <a class="category-grid__card" href="{{ link_2 }}" aria-label="{{ title_2 }} — Shop now">
          <span class="category-grid__media">
            <img
              class="category-grid__img"
              src="{{ src_2 }}"
              alt=""
              width="900"
              height="1125"
              loading="lazy"
              decoding="async"
            >
          </span>
          <span
            class="category-grid__tone category-grid__tone--base"
            style="background: linear-gradient(to top, transparent, {{ tone_2_top }});"
            aria-hidden="true"
          ></span>
          <span
            class="category-grid__tone category-grid__tone--deep"
            style="background: linear-gradient(to top, transparent, {{ tone_2_deep }});"
            aria-hidden="true"
          ></span>
          <span class="category-grid__body">
            <span class="category-grid__name">{{ title_2 }}</span>
            <span class="category-grid__rule" aria-hidden="true"></span>
            <span class="category-grid__shop">Shop now →</span>
          </span>
        </a>
      </li>
      <li class="category-grid__item" data-category-grid-card>
        <a class="category-grid__card" href="{{ link_3 }}" aria-label="{{ title_3 }} — Shop now">
          <span class="category-grid__media">
            <img
              class="category-grid__img"
              src="{{ src_3 }}"
              alt=""
              width="900"
              height="1125"
              loading="lazy"
              decoding="async"
            >
          </span>
          <span
            class="category-grid__tone category-grid__tone--base"
            style="background: linear-gradient(to top, transparent, {{ tone_3_top }});"
            aria-hidden="true"
          ></span>
          <span
            class="category-grid__tone category-grid__tone--deep"
            style="background: linear-gradient(to top, transparent, {{ tone_3_deep }});"
            aria-hidden="true"
          ></span>
          <span class="category-grid__body">
            <span class="category-grid__name">{{ title_3 }}</span>
            <span class="category-grid__rule" aria-hidden="true"></span>
            <span class="category-grid__shop">Shop now →</span>
          </span>
        </a>
      </li>
  </ul>
</div>

{% stylesheet %}
  .category-grid {
    --cg-ivory: #faf8f5;
    --cg-noir: #1a1a1a;
    --cg-champagne: #c8a96e;

    width: 100%;
    margin: 0;
    background-color: var(--cg-ivory);
    padding-block: 0;
    box-sizing: border-box;
    display: flow-root;
  }

  .category-grid__header-row {
    width: 100%;
    box-sizing: border-box;
    padding-inline: 20px;
  }

  @media (min-width: 990px) {
    .category-grid__header-row {
      padding-inline: 40px;
    }
  }

  .category-grid__header {
    text-align: left;
    margin-top: 50px;
    margin-bottom: 40px;
  }

  @media (min-width: 990px) {
    .category-grid__header {
      margin-top: 80px;
      margin-bottom: 60px;
    }
  }

  .category-grid__eyebrow {
    margin: 0;
    font-family: Jost, var(--font-primary--family), system-ui, sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--cg-champagne);
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  .category-grid__title {
    margin: 12px 0 0;
    font-family: 'Cormorant Garamond', 'Times New Roman', Times, serif;
    font-weight: 300;
    font-size: clamp(36px, 4.5vw, 64px);
    line-height: 1.1;
    color: var(--cg-noir);
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  .category-grid__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
    width: 100%;
    box-sizing: border-box;
    grid-template-columns: 1fr;
  }

  @media (min-width: 990px) {
    .category-grid__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .category-grid__item {
    margin: 0;
    padding: 0;
    min-width: 0;
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  .category-grid__card {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 0;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
    isolation: isolate;
  }

  .category-grid__card:focus-visible {
    outline: 2px solid var(--cg-champagne);
    outline-offset: 4px;
  }

  .category-grid__media {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  .category-grid__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transform: scale(1);
    transition: transform 1.2s ease;
    will-change: transform;
  }

  .category-grid__card:hover .category-grid__img,
  .category-grid__card:focus-visible .category-grid__img {
    transform: scale(1.06);
  }

  .category-grid__tone {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  .category-grid__tone--deep {
    opacity: 0;
    transition: opacity 1.2s ease;
  }

  .category-grid__card:hover .category-grid__tone--deep,
  .category-grid__card:focus-within .category-grid__tone--deep {
    opacity: 1;
  }

  .category-grid__body {
    position: absolute;
    left: 0;
    bottom: 0;
    z-index: 2;
    padding: 20px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    pointer-events: none;
    box-sizing: border-box;
  }

  @media (min-width: 640px) {
    .category-grid__body {
      padding: 40px;
    }
  }

  .category-grid__name {
    font-family: 'Cormorant Garamond', 'Times New Roman', Times, serif;
    font-weight: 300;
    font-size: clamp(28px, 3vw, 40px);
    line-height: 1.1;
    color: var(--cg-ivory);
  }

  .category-grid__rule {
    display: block;
    width: 24px;
    height: 1px;
    margin-top: 12px;
    background-color: var(--cg-champagne);
    opacity: 0;
    transform: translate3d(0, 8px, 0);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }

  .category-grid__shop {
    margin-top: 14px;
    font-family: Jost, var(--font-primary--family), system-ui, sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--cg-ivory);
    opacity: 0;
    transform: translate3d(0, 8px, 0);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }

  .category-grid__card:hover .category-grid__rule,
  .category-grid__card:focus-visible .category-grid__rule,
  .category-grid__card:hover .category-grid__shop,
  .category-grid__card:focus-visible .category-grid__shop {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  @media (hover: none) {
    .category-grid__tone--deep {
      opacity: 0 !important;
    }

    .category-grid__rule,
    .category-grid__shop {
      opacity: 1;
      transform: translate3d(0, 0, 0);
    }

    .category-grid__img {
      transform: scale(1);
    }
  }

  .category-grid.is-visible .category-grid__header [data-category-grid-header]:nth-child(1) {
    animation: category-grid-rise 0.9s ease forwards;
    animation-delay: 0s;
  }

  .category-grid.is-visible .category-grid__header [data-category-grid-header]:nth-child(2) {
    animation: category-grid-rise 0.9s ease forwards;
    animation-delay: 0.15s;
  }

  .category-grid.is-visible .category-grid__grid .category-grid__item:nth-child(1) {
    animation: category-grid-rise-card 0.9s ease forwards;
    animation-delay: 1.05s;
  }

  .category-grid.is-visible .category-grid__grid .category-grid__item:nth-child(2) {
    animation: category-grid-rise-card 0.9s ease forwards;
    animation-delay: 1.2s;
  }

  .category-grid.is-visible .category-grid__grid .category-grid__item:nth-child(3) {
    animation: category-grid-rise-card 0.9s ease forwards;
    animation-delay: 1.35s;
  }

  .category-grid.reveal-settled .category-grid__eyebrow,
  .category-grid.reveal-settled .category-grid__title,
  .category-grid.reveal-settled .category-grid__item {
    animation: none !important;
    opacity: 1 !important;
    transform: none !important;
  }

  @keyframes category-grid-rise {
    from {
      opacity: 0;
      transform: translate3d(0, 24px, 0);
    }

    to {
      opacity: 1;
      transform: translate3d(0, 0, 0);
    }
  }

  @keyframes category-grid-rise-card {
    from {
      opacity: 0;
      transform: translate3d(0, 40px, 0);
    }

    to {
      opacity: 1;
      transform: translate3d(0, 0, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .category-grid__eyebrow,
    .category-grid__title,
    .category-grid__item {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }

    .category-grid.reveal-settled .category-grid__eyebrow,
    .category-grid.reveal-settled .category-grid__title,
    .category-grid.reveal-settled .category-grid__item {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }

    .category-grid__img {
      transition: none !important;
    }

    .category-grid__tone--deep {
      transition: none !important;
      opacity: 0 !important;
    }

    .category-grid__rule,
    .category-grid__shop {
      opacity: 1 !important;
      transform: none !important;
    }
  }
{% endstylesheet %}

<script>
  (() => {
    const root = document.querySelector('[data-category-grid]');
    if (!root) return;

    const REVEAL_IO_DELAY_MS = 100;
    const REVEAL_FALLBACK_MS = 1000;
    let revealDone = false;
    let fallbackTimer = 0;
    let io = null;
    let removeScrollListener = null;

    const clearRevealFallback = () => {
      if (fallbackTimer) window.clearTimeout(fallbackTimer);
      fallbackTimer = 0;
    };

    const disconnectIo = () => {
      if (io) {
        io.disconnect();
        io = null;
      }
    };

    const markSettled = () => {
      if (revealDone) return;
      revealDone = true;
      clearRevealFallback();
      disconnectIo();
      if (typeof removeScrollListener === 'function') {
        removeScrollListener();
        removeScrollListener = null;
      }
      root.classList.remove('is-visible');
      root.classList.add('reveal-settled');
    };

    const markAnimated = () => {
      if (revealDone) return;
      revealDone = true;
      clearRevealFallback();
      disconnectIo();
      if (typeof removeScrollListener === 'function') {
        removeScrollListener();
        removeScrollListener = null;
      }
      root.classList.remove('reveal-settled');
      root.classList.add('is-visible');
    };

    const scheduleFallback = () => {
      clearRevealFallback();
      fallbackTimer = window.setTimeout(() => {
        if (revealDone) return;
        markSettled();
      }, REVEAL_FALLBACK_MS);
    };

    const isInViewport = (el) => {
      const r = el.getBoundingClientRect();
      const vh = window.innerHeight || document.documentElement.clientHeight;
      return r.bottom > 0 && r.top < vh;
    };

    const prefersReducedMotion =
      window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const startReveal = () => {
      if (prefersReducedMotion) {
        markSettled();
        return;
      }

      if (!('IntersectionObserver' in window)) {
        markSettled();
        return;
      }

      if (isInViewport(root)) {
        markSettled();
        return;
      }

      scheduleFallback();

      let lastScrollY = window.scrollY || window.pageYOffset || 0;
      const onScroll = () => {
        lastScrollY = window.scrollY || window.pageYOffset || 0;
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      removeScrollListener = () => window.removeEventListener('scroll', onScroll);

      io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            if (entry.intersectionRatio < 0.2) return;
            const y = window.scrollY || window.pageYOffset || 0;
            const scrollingDown = y >= lastScrollY - 2;
            if (scrollingDown) markAnimated();
            else markSettled();
          });
        },
        { threshold: [0, 0.1, 0.2, 0.35, 0.5, 0.65, 0.8, 1] }
      );

      io.observe(root);
    };

    window.setTimeout(startReveal, REVEAL_IO_DELAY_MS);
  })();
</script>

