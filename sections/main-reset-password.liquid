<div class="zs-account zs-account--auth full-width" {{ section.shopify_attributes }}>
  <section
    class="zs-account__split"
    data-zs-page-pull-up
    data-header-bg="#FAF8F5"
    data-header-text="#1A1A1A"
  >
    <div class="zs-account__split-form">
      <div class="zs-account__split-inner">
        <span class="zs-account__ornament" aria-hidden="true"></span>
        <p class="zs-account__eyebrow">Reset password</p>
        <h1 class="zs-account__headline">Create a new password.</h1>
        <p class="zs-account__subtitle">Enter your new password below.</p>

        {% form 'reset_customer_password', class: 'zs-account__form', data_zs_account_form: true %}
          {% if form.errors %}
            <div class="zs-account__errors" role="alert" tabindex="-1">
              <ul class="zs-account__errors-list" role="list">
                {% for field in form.errors %}
                  <li>{{ form.errors.messages[field] }}</li>
                {% endfor %}
              </ul>
            </div>
          {% endif %}

          <div class="zs-account__fields">
            <div class="zs-account__field">
              <label class="zs-account__label" for="ResetPassword">Password</label>
              <input
                class="zs-account__input"
                type="password"
                name="customer[password]"
                id="ResetPassword"
                autocomplete="new-password"
                required
                aria-required="true"
              >
            </div>
            <div class="zs-account__field">
              <label class="zs-account__label" for="ResetPasswordConfirm">Confirm password</label>
              <input
                class="zs-account__input"
                type="password"
                name="customer[password_confirmation]"
                id="ResetPasswordConfirm"
                autocomplete="new-password"
                required
                aria-required="true"
              >
            </div>
          </div>

          <button type="submit" class="zs-account__submit">Reset password</button>
        {% endform %}

        <p class="zs-account__footer-text">
          <a class="zs-account__footer-link" href="{{ routes.account_login_url }}">Back to sign in →</a>
        </p>
      </div>
    </div>

    {% render 'zs-account-auth-visual' %}
  </section>
</div>

{% schema %}
{
  "name": "Reset password",
  "settings": []
}
{% endschema %}
