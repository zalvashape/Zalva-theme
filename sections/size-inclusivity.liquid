{% liquid
  assign eyebrow_text = section.settings.eyebrow_text
  assign headline_line_1 = section.settings.headline_line_1
  assign headline_line_2 = section.settings.headline_line_2
  assign subtitle = section.settings.subtitle
  assign sizes_raw = section.settings.size_list
  assign sizes = sizes_raw | split: ','
%}

<div
  class="size-inclusivity full-width"
  data-size-inclusivity
  data-header-bg="#1A1A1A"
  data-header-text="#FAF8F5"
>
  <div class="size-inclusivity-inner">
    <div class="size-inclusivity-accent"></div>
    <p class="size-inclusivity-eyebrow">{{ eyebrow_text }}</p>
    <h2 class="size-inclusivity-headline">
      <span class="size-inclusivity-line-1">{{ headline_line_1 }}</span>
      <span class="size-inclusivity-line-2">{{ headline_line_2 }}</span>
    </h2>
    <p class="size-inclusivity-subtitle">{{ subtitle }}</p>
    <div class="size-inclusivity-sizes">
      {% for size in sizes %}
        <span class="size-inclusivity-pill">{{ size | strip }}</span>
      {% endfor %}
    </div>
  </div>
</div>

<style>
.size-inclusivity { width: 100%; margin: 0; box-sizing: border-box; background: #1A1A1A; padding-block: 100px; padding-inline: 0; text-align: center; }
@media (min-width: 990px) { .size-inclusivity { padding-block: 140px; } }
.size-inclusivity-inner { max-width: 880px; margin: 0 auto; box-sizing: border-box; padding-inline: clamp(20px, 5vw, 40px); }
.size-inclusivity-accent { width: 40px; height: 1px; margin: 0 auto 56px; background: #C8A96E; transform: scaleX(1); transform-origin: center; }
.size-inclusivity-eyebrow { font-family: Jost, sans-serif; font-size: 11px; font-weight: 500; letter-spacing: 0.3em; text-transform: uppercase; color: #D4B5A0; margin: 0 0 48px; opacity: 1; transform: translate3d(0, 0, 0); }
.size-inclusivity-headline { margin: 0; padding: 0; }
.size-inclusivity-line-1, .size-inclusivity-line-2 { display: block; font-family: 'Cormorant Garamond', serif; font-size: clamp(56px, 8.5vw, 120px); line-height: 1.05; letter-spacing: 0.01em; opacity: 1; transform: translate3d(0, 0, 0); }
.size-inclusivity-line-1 { font-weight: 200; color: #FAF8F5; }
.size-inclusivity-line-2 { font-weight: 300; font-style: italic; color: #C8A96E; }
.size-inclusivity-subtitle { font-family: Jost, sans-serif; font-weight: 300; font-size: clamp(14px, 1.2vw, 16px); letter-spacing: 0.15em; line-height: 1.7; color: #D4B5A0; max-width: 580px; margin: 40px auto 0; opacity: 1; transform: translate3d(0, 0, 0); }
.size-inclusivity-sizes { margin-top: 80px; display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; }
.size-inclusivity-pill { display: inline-flex; align-items: center; padding: 12px 22px; border: 1px solid #C8A96E; border-radius: 100px; color: #FAF8F5; font-family: Jost, sans-serif; font-size: 12px; letter-spacing: 0.2em; text-transform: uppercase; transition: all 0.3s ease; opacity: 1; transform: translate3d(0, 0, 0); }
.size-inclusivity-pill:hover { background: #C8A96E; color: #1A1A1A; }
.size-inclusivity.is-visible .size-inclusivity-accent { animation: size-inclusivity-accent-grow 0.9s ease forwards; }
.size-inclusivity.is-visible .size-inclusivity-eyebrow { animation: size-inclusivity-rise 0.8s ease forwards; animation-delay: 0.15s; }
.size-inclusivity.is-visible .size-inclusivity-line-1 { animation: size-inclusivity-rise 0.85s ease forwards; animation-delay: 0.3s; }
.size-inclusivity.is-visible .size-inclusivity-line-2 { animation: size-inclusivity-rise 0.85s ease forwards; animation-delay: 0.45s; }
.size-inclusivity.is-visible .size-inclusivity-subtitle { animation: size-inclusivity-rise 0.8s ease forwards; animation-delay: 0.6s; }
.size-inclusivity.is-visible .size-inclusivity-pill { animation: size-inclusivity-rise 0.55s ease forwards; }
.size-inclusivity.is-visible .size-inclusivity-sizes .size-inclusivity-pill:nth-child(1) { animation-delay: 0.75s; }
.size-inclusivity.is-visible .size-inclusivity-sizes .size-inclusivity-pill:nth-child(2) { animation-delay: 0.8s; }
.size-inclusivity.is-visible .size-inclusivity-sizes .size-inclusivity-pill:nth-child(3) { animation-delay: 0.85s; }
.size-inclusivity.is-visible .size-inclusivity-sizes .size-inclusivity-pill:nth-child(4) { animation-delay: 0.9s; }
.size-inclusivity.is-visible .size-inclusivity-sizes .size-inclusivity-pill:nth-child(5) { animation-delay: 0.95s; }
.size-inclusivity.is-visible .size-inclusivity-sizes .size-inclusivity-pill:nth-child(6) { animation-delay: 1s; }
.size-inclusivity.is-visible .size-inclusivity-sizes .size-inclusivity-pill:nth-child(7) { animation-delay: 1.05s; }
.size-inclusivity.is-visible .size-inclusivity-sizes .size-inclusivity-pill:nth-child(8) { animation-delay: 1.1s; }
.size-inclusivity.is-visible .size-inclusivity-sizes .size-inclusivity-pill:nth-child(9) { animation-delay: 1.15s; }
.size-inclusivity.is-visible .size-inclusivity-sizes .size-inclusivity-pill:nth-child(10) { animation-delay: 1.2s; }
.size-inclusivity.is-visible .size-inclusivity-sizes .size-inclusivity-pill:nth-child(11) { animation-delay: 1.25s; }
.size-inclusivity.is-visible .size-inclusivity-sizes .size-inclusivity-pill:nth-child(12) { animation-delay: 1.3s; }
@keyframes size-inclusivity-accent-grow {
  from { transform: scaleX(0); }
  to { transform: scaleX(1); }
}
@keyframes size-inclusivity-rise {
  from { opacity: 0; transform: translate3d(0, 22px, 0); }
  to { opacity: 1; transform: translate3d(0, 0, 0); }
}
.size-inclusivity.reveal-settled .size-inclusivity-accent,
.size-inclusivity.reveal-settled .size-inclusivity-eyebrow,
.size-inclusivity.reveal-settled .size-inclusivity-line-1,
.size-inclusivity.reveal-settled .size-inclusivity-line-2,
.size-inclusivity.reveal-settled .size-inclusivity-subtitle,
.size-inclusivity.reveal-settled .size-inclusivity-pill {
  animation: none !important;
  opacity: 1 !important;
  transform: none !important;
}
.size-inclusivity.reveal-settled .size-inclusivity-accent { transform: scaleX(1) !important; }
@media (prefers-reduced-motion: reduce) {
  .size-inclusivity .size-inclusivity-accent,
  .size-inclusivity .size-inclusivity-eyebrow,
  .size-inclusivity .size-inclusivity-line-1,
  .size-inclusivity .size-inclusivity-line-2,
  .size-inclusivity .size-inclusivity-subtitle,
  .size-inclusivity .size-inclusivity-pill {
    animation: none !important;
    opacity: 1 !important;
    transform: none !important;
  }
  .size-inclusivity .size-inclusivity-accent { transform: scaleX(1) !important; }
  .size-inclusivity .size-inclusivity-pill { transition: none !important; }
}
</style>

<script>
  (() => {
    const root = document.querySelector('[data-size-inclusivity]');
    if (!root) return;

    const REVEAL_IO_DELAY_MS = 100;
    const REVEAL_FALLBACK_MS = 1000;
    let revealDone = false;
    let fallbackTimer = 0;
    let io = null;
    let removeScrollListener = null;

    const clearRevealFallback = () => {
      if (fallbackTimer) window.clearTimeout(fallbackTimer);
      fallbackTimer = 0;
    };

    const disconnectIo = () => {
      if (io) {
        io.disconnect();
        io = null;
      }
    };

    const markSettled = () => {
      if (revealDone) return;
      revealDone = true;
      clearRevealFallback();
      disconnectIo();
      if (typeof removeScrollListener === 'function') {
        removeScrollListener();
        removeScrollListener = null;
      }
      root.classList.remove('is-visible');
      root.classList.add('reveal-settled');
    };

    const markAnimated = () => {
      if (revealDone) return;
      revealDone = true;
      clearRevealFallback();
      disconnectIo();
      if (typeof removeScrollListener === 'function') {
        removeScrollListener();
        removeScrollListener = null;
      }
      root.classList.remove('reveal-settled');
      root.classList.add('is-visible');
    };

    const scheduleFallback = () => {
      clearRevealFallback();
      fallbackTimer = window.setTimeout(() => {
        if (revealDone) return;
        markSettled();
      }, REVEAL_FALLBACK_MS);
    };

    const isInViewport = (el) => {
      const r = el.getBoundingClientRect();
      const vh = window.innerHeight || document.documentElement.clientHeight;
      return r.bottom > 0 && r.top < vh;
    };

    const prefersReducedMotion =
      window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const startReveal = () => {
      if (prefersReducedMotion) {
        markSettled();
        return;
      }

      if (!('IntersectionObserver' in window)) {
        markSettled();
        return;
      }

      if (isInViewport(root)) {
        markSettled();
        return;
      }

      scheduleFallback();

      let lastScrollY = window.scrollY || window.pageYOffset || 0;
      const onScroll = () => {
        lastScrollY = window.scrollY || window.pageYOffset || 0;
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      removeScrollListener = () => window.removeEventListener('scroll', onScroll);

      io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            if (entry.intersectionRatio < 0.25) return;
            const y = window.scrollY || window.pageYOffset || 0;
            const scrollingDown = y >= lastScrollY - 2;
            if (scrollingDown) markAnimated();
            else markSettled();
          });
        },
        { threshold: [0, 0.12, 0.25, 0.4, 0.55, 0.7, 0.85, 1] }
      );

      io.observe(root);
    };

    window.setTimeout(startReveal, REVEAL_IO_DELAY_MS);
  })();
</script>

{% schema %}
{
  "name": "Size inclusivity",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow",
      "default": "FOR EVERY BODY"
    },
    {
      "type": "text",
      "id": "headline_line_1",
      "label": "Headline line 1",
      "default": "XS to 5XL."
    },
    {
      "type": "text",
      "id": "headline_line_2",
      "label": "Headline line 2",
      "default": "No exceptions."
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Designed, fitted, and tested for the full spectrum of women."
    },
    {
      "type": "text",
      "id": "size_list",
      "label": "Sizes (comma-separated)",
      "default": "XS, S, M, L, XL, XXL, 3XL, 4XL, 5XL"
    }
  ],
  "presets": [
    {
      "name": "Size inclusivity",
      "category": "Custom"
    }
  ]
}
{% endschema %}
