{% liquid
  assign eyebrow_text = section.settings.eyebrow_text
  assign headline_line_1 = section.settings.headline_line_1
  assign headline_line_2 = section.settings.headline_line_2
  assign subtitle = section.settings.subtitle
  assign sizes_raw = section.settings.size_list
  assign sizes = sizes_raw | split: ','
%}

<div class="size-inclusivity full-width">
  <div class="size-inclusivity-inner">
    <div class="size-inclusivity-accent"></div>
    <p class="size-inclusivity-eyebrow">{{ eyebrow_text }}</p>
    <h2 class="size-inclusivity-headline">
      <span class="size-inclusivity-line-1">{{ headline_line_1 }}</span>
      <span class="size-inclusivity-line-2">{{ headline_line_2 }}</span>
    </h2>
    <p class="size-inclusivity-subtitle">{{ subtitle }}</p>
    <div class="size-inclusivity-sizes">
      {% for size in sizes %}
        <span class="size-inclusivity-pill">{{ size | strip }}</span>
      {% endfor %}
    </div>
  </div>
</div>

<style>
.size-inclusivity { width: 100%; box-sizing: border-box; background: #1A1A1A; padding-block: 110px; padding-inline: 0; text-align: center; }
@media (min-width: 990px) { .size-inclusivity { padding-block: 180px; } }
.size-inclusivity-inner { max-width: 880px; margin: 0 auto; box-sizing: border-box; padding-inline: clamp(20px, 5vw, 40px); }
.size-inclusivity-accent { width: 40px; height: 1px; margin: 0 auto 56px; background: #C8A96E; }
.size-inclusivity-eyebrow { font-family: Jost, sans-serif; font-size: 11px; font-weight: 500; letter-spacing: 0.3em; text-transform: uppercase; color: #D4B5A0; margin: 0 0 48px; }
.size-inclusivity-headline { margin: 0; padding: 0; }
.size-inclusivity-line-1, .size-inclusivity-line-2 { display: block; font-family: 'Cormorant Garamond', serif; font-size: clamp(56px, 8.5vw, 120px); line-height: 1.05; letter-spacing: 0.01em; }
.size-inclusivity-line-1 { font-weight: 200; color: #FAF8F5; }
.size-inclusivity-line-2 { font-weight: 300; font-style: italic; color: #C8A96E; }
.size-inclusivity-subtitle { font-family: Jost, sans-serif; font-weight: 300; font-size: clamp(14px, 1.2vw, 16px); letter-spacing: 0.15em; line-height: 1.7; color: #D4B5A0; max-width: 580px; margin: 40px auto 0; }
.size-inclusivity-sizes { margin-top: 80px; display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; }
.size-inclusivity-pill { display: inline-flex; align-items: center; padding: 12px 22px; border: 1px solid #C8A96E; border-radius: 100px; color: #FAF8F5; font-family: Jost, sans-serif; font-size: 12px; letter-spacing: 0.2em; text-transform: uppercase; transition: all 0.3s ease; }
.size-inclusivity-pill:hover { background: #C8A96E; color: #1A1A1A; }
</style>

{% schema %}
{
  "name": "Size inclusivity",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow",
      "default": "FOR EVERY BODY"
    },
    {
      "type": "text",
      "id": "headline_line_1",
      "label": "Headline line 1",
      "default": "XS to 5XL."
    },
    {
      "type": "text",
      "id": "headline_line_2",
      "label": "Headline line 2",
      "default": "No exceptions."
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Designed, fitted, and tested for the full spectrum of women."
    },
    {
      "type": "text",
      "id": "size_list",
      "label": "Sizes (comma-separated)",
      "default": "XS, S, M, L, XL, XXL, 3XL, 4XL, 5XL"
    }
  ],
  "presets": [
    {
      "name": "Size inclusivity",
      "category": "Custom"
    }
  ]
}
{% endschema %}
