{% comment %}
  Popular search links for main-search empty states.
  @param {section} section
{% endcomment %}

<nav class="zs-search__popular" aria-label="Popular searches">
  <ul class="zs-search__popular-grid" role="list">
    {% if section.blocks.size > 0 %}
      {% for block in section.blocks %}
        {% if block.type == 'popular_link' and block.settings.label != blank %}
          <li {{ block.shopify_attributes }}>
            <a
              class="zs-search__popular-link"
              href="{% if block.settings.url != blank %}{{ block.settings.url }}{% else %}#{% endif %}"
            >
              {{ block.settings.label }}
            </a>
          </li>
        {% endif %}
      {% endfor %}
    {% else %}
      <li>
        <a class="zs-search__popular-link" href="{{ routes.root_url }}collections/bodysuits">Bodysuits</a>
      </li>
      <li>
        <a class="zs-search__popular-link" href="{{ routes.root_url }}collections/waist-trainers">Waist trainers</a>
      </li>
      <li>
        <a class="zs-search__popular-link" href="{{ routes.root_url }}collections/fajas">Fajas</a>
      </li>
      <li>
        <a class="zs-search__popular-link" href="{{ routes.all_products_collection_url }}?sort_by=best-selling">Best sellers</a>
      </li>
    {% endif %}
  </ul>
</nav>
