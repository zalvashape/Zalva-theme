{% doc %}
  Editorial line-art silhouette color selector (CSS mask + variant fill).
  @param {string} color - Hex color for fill (--variant-color)
  @param {string} name - Color label
  @param {string} [size] - small | medium | large (default medium)
  @param {boolean} [active] - Selected state
  @param {boolean} [sold_out] - Unavailable color
  @param {number} [option_index] - Option index for variant JS
  @param {string} [value] - Option value for variant JS
{% enddoc %}
{% liquid
  assign silhouette_color = color | default: '#d4b5a0'
  assign silhouette_name = name | default: 'Color'
  assign silhouette_size = size | default: 'medium'
  assign silhouette_active = active | default: false
  assign silhouette_sold_out = sold_out | default: false
  assign silhouette_class = 'zs-color-silhouette zs-color-silhouette--' | append: silhouette_size
  if silhouette_active
    assign silhouette_class = silhouette_class | append: ' is-selected'
  endif
  if silhouette_sold_out
    assign silhouette_class = silhouette_class | append: ' is-sold-out'
  endif
%}
<button
  type="button"
  class="{{ silhouette_class }}"
  data-zs-variant-btn
  data-zs-color-silhouette
  {% if option_index != blank %}data-option-index="{{ option_index }}"{% endif %}
  {% if value != blank %}data-value="{{ value | escape }}"{% endif %}
  data-variant-color="{{ silhouette_color }}"
  data-variant-name="{{ silhouette_name | escape }}"
  aria-label="Select color: {{ silhouette_name | escape }}"
  aria-pressed="{% if silhouette_active %}true{% else %}false{% endif %}"
  {% if silhouette_sold_out %}aria-disabled="true" disabled{% endif %}
>
  <span class="zs-color-silhouette__inner">
    <span
      class="zs-color-silhouette__shape"
      style="--variant-color: {{ silhouette_color }};"
      aria-hidden="true"
    ></span>
  </span>
  <span class="zs-color-silhouette__name">{{ silhouette_name }}</span>
</button>
